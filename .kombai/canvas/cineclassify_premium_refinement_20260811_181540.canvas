    <i aria-hidden=\"true\" class=\"cc-icon-sm\" data-kid=\"1-2-2-1-3-3-2-2-2-1\" data-lucide=\"arrow-right\" data-name=\"right arrow icon\">\n                                    </i>\n                                </button>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n                <section aria-label=\"Más comentadas y recomendación editorial\" class=\"cc-section cc-bottom-grid\" data-kid=\"1-2-2-1-4\">\n                    <div class=\"cc-panel cc-commented-panel\" data-kid=\"1-2-2-1-4-1\">\n                        <div class=\"cc-panel-head\" data-kid=\"1-2-2-1-4-1-1\">\n                            <h2 class=\"cc-panel-title\" data-kid=\"1-2-2-1-4-1-1-1\">\n                                Más comentadas\n                            </h2>\n                            <button class=\"cc-panel-link\" data-kid=\"1-2-2-1-4-1-1-2\">\n                                Ver ranking\n                                <i aria-hidden=\"true\" class=\"cc-icon-sm\" data-kid=\"1-2-2-1-4-1-1-2-1\" data-lucide=\"arrow-up-right\">\n                                </i>\n                            </button>\n                        </div>\n                        <div class=\"cc-commented-list\" data-kid=\"1-2-2-1-4-1-2\">\n                            <article class=\"cc-commented-item\" data-kid=\"1-2-2-1-4-1-2-1\">\n                                <div class=\"cc-rank is-first\" data-kid=\"1-2-2-1-4-1-2-1-1\">\n                                    01\n                                </div>\n                                <img alt=\"Interstellar\" class=\"cc-mini-poster\" data-kid=\"1-2-2-1-4-1-2-1-2\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=180&q=80\"/>\n                                <div class=\"cc-commented-copy\" data-kid=\"1-2-2-1-4-1-2-1-3\">\n                                    <div class=\"cc-commented-title\" data-kid=\"1-2-2-1-4-1-2-1-3-1\">\n                                        Interstellar\n                                    </div>\n                                    <div class=\"cc-commented-meta\" data-kid=\"1-2-2-1-4-1-2-1-3-2\">\n                                        2 reseñas · Drama / Sci-Fi\n                                    </div>\n                                </div>\n                                <div class=\"cc-commented-score\" data-kid=\"1-2-2-1-4-1-2-1-4\">\n                                    9.5\n                                </div>\n                            </article>\n                            <article class=\"cc-commented-item\" data-kid=\"1-2-2-1-4-1-2-2\">\n                                <div class=\"cc-rank\" data-kid=\"1-2-2-1-4-1-2-2-1\">\n                                    02\n                                </div>\n                                <img alt=\"Breaking Bad — foto de Tima Miroshnichenko en Pexels\" class=\"cc-mini-poster\" data-kid=\"1-2-2-1-4-1-2-2-2\" data-name=\"Breaking Bad poster image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7991307/pexels-photo-7991307.jpeg?auto=compress&cs=tinysrgb&w=180&q=80\"/>\n                                <div class=\"cc-commented-copy\" data-kid=\"1-2-2-1-4-1-2-2-3\">\n                                    <div class=\"cc-commented-title\" data-kid=\"1-2-2-1-4-1-2-2-3-1\">\n                                        Breaking Bad\n                                    </div>\n                                    <div class=\"cc-commented-meta\" data-kid=\"1-2-2-1-4-1-2-2-3-2\">\n                                        2 reseñas · Drama / Thriller\n                                    </div>\n                                </div>\n                                <div class=\"cc-commented-score\" data-kid=\"1-2-2-1-4-1-2-2-4\">\n                                    10.0\n                                </div>\n                            </article>\n                            <article class=\"cc-commented-item\" data-kid=\"1-2-2-1-4-1-2-3\">\n                                <div class=\"cc-rank\" data-kid=\"1-2-2-1-4-1-2-3-1\">\n                                    03\n                                </div>\n                                <img alt=\"Inception\" class=\"cc-mini-poster\" data-kid=\"1-2-2-1-4-1-2-3-2\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1518773553398-650c184e0bb3?auto=format&fit=crop&w=180&q=80\"/>\n                                <div class=\"cc-commented-copy\" data-kid=\"1-2-2-1-4-1-2-3-3\">\n                                    <div class=\"cc-commented-title\" data-kid=\"1-2-2-1-4-1-2-3-3-1\">\n                                        Inception\n                                    </div>\n                                    <div class=\"cc-commented-meta\" data-kid=\"1-2-2-1-4-1-2-3-3-2\">\n                                        2 reseñas · Sci-Fi / Thriller\n                                    </div>\n                                </div>\n                                <div class=\"cc-commented-score\" data-kid=\"1-2-2-1-4-1-2-3-4\">\n                                    8.5\n                                </div>\n                            </article>\n                        </div>\n                    </div>\n                    <aside class=\"cc-panel cc-curation-panel\" data-kid=\"1-2-2-1-4-2\" data-name=\"curation panel container\">\n                        <div class=\"cc-curation-label\" data-kid=\"1-2-2-1-4-2-1\">\n                            Nota de la casa\n                        </div>\n                        <h3 data-kid=\"1-2-2-1-4-2-2\">\n                            El cine también se ordena por sensaciones.\n                        </h3>\n                        <p data-kid=\"1-2-2-1-4-2-3\">\n                            Guarda lo que te mueve, clasifica lo que repetirías y deja que tus propias puntuaciones construyan una colección con criterio.\n                        </p>\n                        <div class=\"cc-curation-rule\" data-kid=\"1-2-2-1-4-2-4\">\n                        </div>\n                        <div class=\"cc-curation-foot\" data-kid=\"1-2-2-1-4-2-5\">\n                            <span data-kid=\"1-2-2-1-4-2-5-1\">\n                                Tu colección personal\n                            </span>\n                            <strong data-kid=\"1-2-2-1-4-2-5-2\">\n                                12 títulos valorados\n                            </strong>\n                        </div>\n                    </aside>\n                </section>\n            </div>\n        </main>\n    </div>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    lucide.createIcons();\n\n  document.querySelectorAll('[data-watchlist]').forEach(function (button) {\n    button.addEventListener('click', function (event) {\n      event.stopPropagation();\n      var saved = button.classList.toggle('is-saved');\n      var label = button.getAttribute('aria-label') || '';\n      button.setAttribute('aria-label', saved ? label.replace('Guardar', 'Quitar') : label.replace('Quitar', 'Guardar'));\n    });\n  });\n\n  (function () {\n    var cards = Array.prototype.slice.call(document.querySelectorAll('[data-carousel-card]'));\n    var prev = document.querySelector('.cc-carousel-prev');\n    var next = document.querySelector('.cc-carousel-next');\n    var current = document.querySelector('.cc-carousel-current');\n    if (!cards.length || !prev || !next) return;\n\n    var count = cards.length;\n    var step = (2 * Math.PI) / count;\n    var active = 0;\n\n    function stateFor(offset, halfWidth) {\n      var abs = Math.abs(offset);\n      if (abs === 0) return { tx: 0, sc: 1, op: 1, zi: 10 };\n      var angle = abs * step;\n      var sinA = Math.sin(angle);\n      var cosA = Math.cos(angle);\n      if (abs === 1 || cosA >= 0) {\n        var scale = Math.max(0.28, 0.28 + 0.72 * cosA);\n        return { tx: sinA * halfWidth * 2.5, sc: scale, op: 0.7 + 0.3 * Math.max(0, cosA), zi: 10 - abs };\n      }\n      return { tx: halfWidth * 0.9, sc: 0.25, op: sinA > 0.05 ? 0.65 : 0, zi: 10 - abs };\n    }\n\n    function setPositions() {\n      var halfWidth = (cards[0].offsetWidth || 180) / 2;\n      cards.forEach(function (card, index) {\n        var offset = index - active;\n        if (offset > count / 2) offset -= count;\n        if (offset < -count / 2) offset += count;\n        var sign = Math.sign(offset) || 1;\n        var state = stateFor(offset, halfWidth);\n        card.style.transform = 'translateX(' + (sign * state.tx) + 'px) scale(' + state.sc + ')';\n        card.style.opacity = state.op;\n        card.style.zIndex = state.zi;\n        card.classList.toggle('is-active', offset === 0);\n        card.setAttribute('aria-current', offset === 0 ? 'true' : 'false');\n      });\n      if (current) current.textContent = String(active + 1).padStart(2, '0');\n    }\n\n    function rotateTo(target) {\n      active = (target + count) % count;\n      setPositions();\n    }\n\n    prev.addEventListener('click', function () { rotateTo(active - 1); });\n    next.addEventListener('click', function () { rotateTo(active + 1); });\n    cards.forEach(function (card, index) {\n      card.addEventListener('click', function (event) {\n        if (event.target.closest('button')) return;\n        if (index !== active) rotateTo(index);\n      });\n      card.addEventListener('keydown', function (event) {\n        if (event.key === 'Enter' || event.key === ' ') {\n          event.preventDefault();\n          if (index !== active) rotateTo(index);\n        }\n      });\n    });\n\n    window.addEventListener('resize', setPositions, { passive: true });\n    setPositions();\n  }());\n</script>\n",
