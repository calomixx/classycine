      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Outfit:wght@400;500;600;700;800&display=swap');\n\n  .cineclassify-shell {\n    --cc-bg: #0d1015;\n    --cc-bg-raised: #12171e;\n    --cc-surface: #171d25;\n    --cc-surface-soft: #1c232d;\n    --cc-surface-hover: #232b36;\n    --cc-line: #2b3440;\n    --cc-line-strong: #3a4654;\n    --cc-text: #f4f0e9;\n    --cc-text-soft: #a9b0b9;\n    --cc-text-muted: #737e8c;\n    --cc-amber: #e6ad4f;\n    --cc-amber-soft: #f2c979;\n    --cc-crimson: #b65458;\n    --cc-crimson-soft: #db7a78;\n    --cc-green: #7cae93;\n    --cc-radius-sm: 8px;\n    --cc-radius-md: 14px;\n    --cc-radius-lg: 20px;\n    font-family: 'Outfit', sans-serif;\n    color: var(--cc-text);\n    background: var(--cc-bg);\n    min-height: 100vh;\n    letter-spacing: -0.01em;\n  }\n\n  .cineclassify-shell button,\n  .cineclassify-shell input { font: inherit; }\n  .cineclassify-shell button { cursor: pointer; }\n  .cineclassify-shell img { display: block; }\n  .cineclassify-shell .cc-display { font-family: 'DM Serif Display', Georgia, serif; }\n  .cineclassify-shell .cc-scrollbar::-webkit-scrollbar { height: 6px; width: 6px; }\n  .cineclassify-shell .cc-scrollbar::-webkit-scrollbar-thumb { background: var(--cc-line-strong); border-radius: 999px; }\n  .cineclassify-shell .cc-scrollbar::-webkit-scrollbar-track { background: transparent; }\n  .cineclassify-shell .cc-focus:focus-visible,\n  .cineclassify-shell .cc-icon-button:focus-visible,\n  .cineclassify-shell .cc-nav-item:focus-visible,\n  .cineclassify-shell .cc-media-card:focus-visible,\n  .cineclassify-shell .cc-primary:focus-visible,\n  .cineclassify-shell .cc-secondary:focus-visible {\n    outline: 2px solid var(--cc-amber-soft);\n    outline-offset: 3px;\n  }\n  .cineclassify-shell .cc-nav-item { transition: background-color .2s ease, color .2s ease, border-color .2s ease; }\n  .cineclassify-shell .cc-nav-item:hover { color: var(--cc-text); background: var(--cc-surface); }\n  .cineclassify-shell .cc-nav-item.is-active { color: var(--cc-text); background: #202832; border-color: var(--cc-line-strong); }\n  .cineclassify-shell .cc-nav-item.is-active .cc-nav-mark { background: var(--cc-amber); }\n  .cineclassify-shell .cc-icon-button { transition: background-color .2s ease, color .2s ease, border-color .2s ease, transform .2s ease; }\n  .cineclassify-shell .cc-icon-button:hover { color: var(--cc-text); background: var(--cc-surface-hover); border-color: var(--cc-line-strong); transform: translateY(-1px); }\n  .cineclassify-shell .cc-primary { transition: background-color .2s ease, color .2s ease, transform .2s ease; }\n  .cineclassify-shell .cc-primary:hover { background: var(--cc-amber-soft); transform: translateY(-1px); }\n  .cineclassify-shell .cc-secondary { transition: background-color .2s ease, border-color .2s ease, color .2s ease; }\n  .cineclassify-shell .cc-secondary:hover { background: var(--cc-surface-hover); border-color: var(--cc-line-strong); color: var(--cc-text); }\n  .cineclassify-shell .cc-media-card { transition: transform .24s ease, border-color .24s ease, box-shadow .24s ease; }\n  .cineclassify-shell .cc-media-card:hover { transform: translateY(-4px); border-color: #586575; box-shadow: 0 14px 28px rgba(0,0,0,.28); }\n  .cineclassify-shell .cc-media-card:hover .cc-poster-img { transform: scale(1.035); }\n  .cineclassify-shell .cc-poster-img { transition: transform .35s ease; }\n  .cineclassify-shell .cc-watchlist { transition: background-color .2s ease, color .2s ease, border-color .2s ease, transform .2s ease; }\n  .cineclassify-shell .cc-watchlist:hover { transform: scale(1.05); background: rgba(182,84,88,.9); border-color: var(--cc-crimson-soft); color: #fff; }\n  .cineclassify-shell .cc-feature { background: var(--cc-surface); }\n  .cineclassify-shell .cc-activity-item + .cc-activity-item { border-left: 1px solid var(--cc-line); }\n  @media (max-width: 1080px) {\n    .cineclassify-shell .cc-sidebar { width: 208px; }\n    .cineclassify-shell .cc-library-grid { grid-template-columns: minmax(330px, 1.35fr) repeat(3, minmax(130px, 1fr)); }\n    .cineclassify-shell .cc-library-grid .cc-card:nth-child(5) { display: none; }\n  }\n  @media (max-width: 820px) {\n    .cineclassify-shell .cc-sidebar { display: none; }\n    .cineclassify-shell .cc-content { padding: 24px; }\n    .cineclassify-shell .cc-library-grid { grid-template-columns: minmax(280px, 1.2fr) repeat(2, minmax(120px, 1fr)); }\n    .cineclassify-shell .cc-library-grid .cc-card:nth-child(4),\n    .cineclassify-shell .cc-library-grid .cc-card:nth-child(5) { display: none; }\n  }\n  @media (max-width: 620px) {\n    .cineclassify-shell .cc-topbar { padding: 0 18px; }\n    .cineclassify-shell .cc-topbar-search { display: none; }\n    .cineclassify-shell .cc-content { padding: 20px 16px 32px; }\n    .cineclassify-shell .cc-library-grid { display: flex; overflow-x: auto; padding-bottom: 10px; }\n    .cineclassify-shell .cc-library-grid .cc-feature { flex: 0 0 310px; }\n    .cineclassify-shell .cc-library-grid .cc-card { flex: 0 0 145px; }\n    .cineclassify-shell .cc-activity { overflow-x: auto; }\n    .cineclassify-shell .cc-activity-item { flex: 0 0 220px; }\n    .cineclassify-shell .cc-activity-item + .cc-activity-item { border-left: 0; border-top: 0; }\n  }\n</style>\n<div class=\"cineclassify-shell min-h-screen\" data-kid=\"1\">\n    <header class=\"cc-topbar sticky top-0 z-20 flex h-[74px] items-center gap-6 border-b border-[#242c35] bg-[#0d1015] px-8\" data-kid=\"1-1\">\n        <div class=\"flex min-w-[208px] items-center gap-3\" data-kid=\"1-1-1\">\n            <div aria-label=\"CineClassify\" class=\"flex h-9 w-9 items-center justify-center rounded-[10px] border border-[#5c4d35] bg-[#2a241b] text-[var(--cc-amber)]\" data-kid=\"1-1-1-1\">\n                <i aria-label=\"CineClassify\" data-kid=\"1-1-1-1-1\" data-lucide=\"clapperboard\" data-name=\"clapperboard icon\" height=\"19\" width=\"19\">\n                </i>\n            </div>\n            <div class=\"text-[17px] font-semibold tracking-[-0.03em]\" data-kid=\"1-1-1-2\">\n                Cine\n                <span class=\"text-[var(--cc-amber)]\" data-kid=\"1-1-1-2-1\">\n                    Classify\n                </span>\n            </div>\n        </div>\n        <div class=\"cc-topbar-search relative flex max-w-[480px] flex-1 items-center\" data-kid=\"1-1-2\">\n            <i aria-label=\"Buscar\" class=\"pointer-events-none absolute left-4 text-[var(--cc-text-muted)]\" data-kid=\"1-1-2-1\" data-lucide=\"search\" data-name=\"search magnifying glass icon\" height=\"17\" width=\"17\">\n            </i>\n            <input aria-label=\"Buscar películas, series y actores\" class=\"cc-focus h-11 w-full rounded-[11px] border border-[#29323c] bg-[#141920] pl-11 pr-4 text-[13px] text-[var(--cc-text)] placeholder:text-[#6e7884]\" data-kid=\"1-1-2-2\" placeholder=\"Buscar películas, series, actores...\"/>\n            <span class=\"absolute right-3 rounded-[6px] border border-[#303944] px-2 py-1 text-[10px] font-medium text-[var(--cc-text-muted)]\" data-kid=\"1-1-2-3\">\n                ⌘ K\n            </span>\n        </div>\n        <div class=\"ml-auto flex items-center gap-3\" data-kid=\"1-1-3\">\n            <button aria-label=\"Notificaciones\" class=\"cc-icon-button cc-focus flex h-10 w-10 items-center justify-center rounded-[10px] border border-[#29323c] bg-[#141920] text-[var(--cc-text-soft)]\" data-kid=\"1-1-3-1\">\n                <i aria-label=\"Notificaciones\" data-kid=\"1-1-3-1-1\" data-lucide=\"bell\" data-name=\"bell notification icon\" height=\"18\" width=\"18\">\n                </i>\n            </button>\n            <div class=\"hidden h-7 w-px bg-[#29323c] sm:block\" data-kid=\"1-1-3-2\">\n            </div>\n            <button aria-label=\"Abrir menú de usuario\" class=\"cc-focus flex items-center gap-3 rounded-[10px] px-1 py-1 text-left\" data-kid=\"1-1-3-3\">\n                <span class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#6b4e3d] text-[12px] font-bold text-[#f8e9d8]\" data-kid=\"1-1-3-3-1\">\n                    AL\n                </span>\n                <span class=\"hidden leading-tight sm:block\" data-kid=\"1-1-3-3-2\">\n                    <span class=\"block text-[13px] font-semibold text-[var(--cc-text)]\" data-kid=\"1-1-3-3-2-1\">\n                        Alex López\n                    </span>\n                    <span class=\"mt-0.5 block text-[11px] text-[var(--cc-text-muted)]\" data-kid=\"1-1-3-3-2-2\">\n                        Coleccionista\n                    </span>\n                </span>\n                <i aria-label=\"Abrir menú\" class=\"hidden text-[var(--cc-text-muted)] sm:block\" data-kid=\"1-1-3-3-3\" data-lucide=\"chevron-down\" data-name=\"chevron down icon\" height=\"15\" width=\"15\">\n                </i>\n            </button>\n        </div>\n    </header>\n    <div class=\"flex\" data-kid=\"1-2\">\n        <aside class=\"cc-sidebar sticky top-[74px] flex h-[calc(100vh-74px)] w-[232px] shrink-0 flex-col border-r border-[#242c35] bg-[#10141a] px-4 py-7\" data-kid=\"1-2-1\">\n            <div class=\"mb-3 px-3 text-[10px] font-bold uppercase tracking-[0.18em] text-[var(--cc-text-muted)]\" data-kid=\"1-2-1-1\">\n                Explorar\n            </div>\n            <nav aria-label=\"Navegación principal\" class=\"space-y-1\" data-kid=\"1-2-1-2\">\n                <button aria-label=\"Ir a Inicio\" class=\"cc-nav-item cc-focus is-active flex w-full items-center gap-3 rounded-[10px] border border-transparent px-3 py-2.5 text-left text-[13px] font-medium text-[var(--cc-text-soft)]\" data-kid=\"1-2-1-2-1\">\n                    <span class=\"cc-nav-mark h-4 w-1 rounded-full bg-transparent\" data-kid=\"1-2-1-2-1-1\">\n                    </span>\n                    <i aria-label=\"Inicio\" data-kid=\"1-2-1-2-1-2\" data-lucide=\"house\" data-name=\"house icon\" height=\"17\" width=\"17\">\n                    </i>\n                    <span data-kid=\"1-2-1-2-1-3\">\n                        Inicio\n                    </span>\n                </button>\n                <button aria-label=\"Ir a Películas\" class=\"cc-nav-item cc-focus flex w-full items-center gap-3 rounded-[10px] border border-transparent px-3 py-2.5 text-left text-[13px] font-medium text-[var(--cc-text-soft)]\" data-kid=\"1-2-1-2-2\">\n                    <span class=\"cc-nav-mark h-4 w-1 rounded-full bg-transparent\" data-kid=\"1-2-1-2-2-1\">\n                    </span>\n                    <i aria-label=\"Películas\" data-kid=\"1-2-1-2-2-2\" data-lucide=\"film\" data-name=\"film reel icon\" height=\"17\" width=\"17\">\n                    </i>\n                    <span data-kid=\"1-2-1-2-2-3\">\n                        Películas\n                    </span>\n                </button>\n                <button aria-label=\"Ir a Series\" class=\"cc-nav-item cc-focus flex w-full items-center gap-3 rounded-[10px] border border-transparent px-3 py-2.5 text-left text-[13px] font-medium text-[var(--cc-text-soft)]\" data-kid=\"1-2-1-2-3\">\n                    <span class=\"cc-nav-mark h-4 w-1 rounded-full bg-transparent\" data-kid=\"1-2-1-2-3-1\">\n                    </span>\n                    <i aria-label=\"Series\" data-kid=\"1-2-1-2-3-2\" data-lucide=\"tv\" data-name=\"television icon\" height=\"17\" width=\"17\">\n                    </i>\n                    <span data-kid=\"1-2-1-2-3-3\">\n                        Series\n                    </span>\n                </button>\n                <button aria-label=\"Ir a Mejores Calificadas\" class=\"cc-nav-item cc-focus flex w-full items-center gap-3 rounded-[10px] border border-transparent px-3 py-2.5 text-left text-[13px] font-medium text-[var(--cc-text-soft)]\" data-kid=\"1-2-1-2-4\">\n                    <span class=\"cc-nav-mark h-4 w-1 rounded-full bg-transparent\" data-kid=\"1-2-1-2-4-1\">\n                    </span>\n                    <i aria-label=\"Mejores Calificadas\" data-kid=\"1-2-1-2-4-2\" data-lucide=\"trophy\" data-name=\"trophy icon\" height=\"17\" width=\"17\">\n                    </i>\n                    <span data-kid=\"1-2-1-2-4-3\">\n                        Mejores calificadas\n                    </span>\n                </button>\n                <button aria-label=\"Ir a Estadísticas\" class=\"cc-nav-item cc-focus flex w-full items-center gap-3 rounded-[10px] border border-transparent px-3 py-2.5 text-left text-[13px] font-medium text-[var(--cc-text-soft)]\" data-kid=\"1-2-1-2-5\">\n                    <span class=\"cc-nav-mark h-4 w-1 rounded-full bg-transparent\" data-kid=\"1-2-1-2-5-1\">\n                    </span>\n                    <i aria-label=\"Estadísticas\" data-kid=\"1-2-1-2-5-2\" data-lucide=\"chart-no-axes-combined\" data-name=\"combined charts icon\" height=\"17\" width=\"17\">\n                    </i>\n                    <span data-kid=\"1-2-1-2-5-3\">\n                        Estadísticas\n                    </span>\n                </button>\n            </nav>\n            <div class=\"mb-3 mt-9 px-3 text-[10px] font-bold uppercase tracking-[0.18em] text-[var(--cc-text-muted)]\" data-kid=\"1-2-1-3\">\n                Mi cuenta\n            </div>\n            <nav aria-label=\"Navegación de cuenta\" class=\"space-y-1\" data-kid=\"1-2-1-4\">\n                <button aria-label=\"Ir a Mi Lista\" class=\"cc-nav-item cc-focus flex w-full items-center gap-3 rounded-[10px] border border-transparent px-3 py-2.5 text-left text-[13px] font-medium text-[var(--cc-text-soft)]\" data-kid=\"1-2-1-4-1\">\n                    <span class=\"cc-nav-mark h-4 w-1 rounded-full bg-transparent\" data-kid=\"1-2-1-4-1-1\">\n                    </span>\n                    <i aria-label=\"Mi Lista\" data-kid=\"1-2-1-4-1-2\" data-lucide=\"heart\" data-name=\"heart icon\" height=\"17\" width=\"17\">\n                    </i>\n                    <span data-kid=\"1-2-1-4-1-3\">\n                        Mi Lista\n                    </span>\n                    <span class=\"ml-auto rounded-full bg-[#352126] px-2 py-0.5 text-[10px] font-bold text-[var(--cc-crimson-soft)]\" data-kid=\"1-2-1-4-1-4\">\n                        4\n                    </span>\n                </button>\n                <button aria-label=\"Ir a Mi Tier List\" class=\"cc-nav-item cc-focus flex w-full items-center gap-3 rounded-[10px] border border-transparent px-3 py-2.5 text-left text-[13px] font-medium text-[var(--cc-text-soft)]\" data-kid=\"1-2-1-4-2\">\n                    <span class=\"cc-nav-mark h-4 w-1 rounded-full bg-transparent\" data-kid=\"1-2-1-4-2-1\">\n                    </span>\n                    <i aria-label=\"Mi Tier List\" data-kid=\"1-2-1-4-2-2\" data-lucide=\"list\" data-name=\"list icon\" height=\"17\" width=\"17\">\n                    </i>\n                    <span data-kid=\"1-2-1-4-2-3\">\n                        Mi Tier List\n                    </span>\n                </button>\n            </nav>\n            <div class=\"mt-auto border-t border-[#242c35] pt-5\" data-kid=\"1-2-1-5\">\n                <button aria-label=\"Cerrar sesión\" class=\"cc-nav-item cc-focus flex w-full items-center gap-3 rounded-[10px] border border-transparent px-3 py-2.5 text-left text-[13px] font-medium text-[var(--cc-text-soft)]\" data-kid=\"1-2-1-5-1\">\n                    <i aria-label=\"Cerrar sesión\" data-kid=\"1-2-1-5-1-1\" data-lucide=\"log-out\" data-name=\"log out icon\" height=\"17\" width=\"17\">\n                    </i>\n                    <span data-kid=\"1-2-1-5-1-2\">\n                        Salir\n                    </span>\n                </button>\n                <div class=\"mt-5 rounded-[12px] border border-[#2c333c] bg-[#171d25] p-3.5\" data-kid=\"1-2-1-5-2\">\n                    <div class=\"mb-2 flex items-center justify-between\" data-kid=\"1-2-1-5-2-1\">\n                        <span class=\"text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--cc-text-muted)]\" data-kid=\"1-2-1-5-2-1-1\">\n                            Tu actividad\n                        </span>\n                        <i aria-label=\"Actividad destacada\" class=\"text-[var(--cc-amber)]\" data-kid=\"1-2-1-5-2-1-2\" data-lucide=\"sparkles\" data-name=\"sparkles icon\" height=\"15\" width=\"15\">\n                        </i>\n                    </div>\n                    <p class=\"text-[12px] leading-[1.45] text-[var(--cc-text-soft)]\" data-kid=\"1-2-1-5-2-2\">\n                        Llevas\n                        <strong class=\"text-[var(--cc-text)]\" data-dynamic=\"true\" data-kid=\"1-2-1-5-2-2-1\" data-name=\"activity count number\" data-reason=\"updated via script\">\n                            12\n                        </strong>\n                        títulos valorados este mes.\n                    </p>\n                </div>\n            </div>\n        </aside>\n        <main class=\"cc-content min-w-0 flex-1 px-9 py-8\" data-kid=\"1-2-2\">\n            <section class=\"mb-6 flex flex-wrap items-end justify-between gap-5\" data-kid=\"1-2-2-1\">\n                <div data-kid=\"1-2-2-1-1\">\n                    <p class=\"mb-2 text-[11px] font-bold uppercase tracking-[0.18em] text-[var(--cc-amber)]\" data-kid=\"1-2-2-1-1-1\">\n                        Biblioteca de hoy\n                    </p>\n                    <h1 class=\"text-[30px] font-semibold tracking-[-0.045em] text-[var(--cc-text)]\" data-kid=\"1-2-2-1-1-2\">\n                        Buenas tardes, Alex\n                    </h1>\n                    <p class=\"mt-2 text-[14px] text-[var(--cc-text-soft)]\" data-kid=\"1-2-2-1-1-3\">\n                        Una selección para tu próxima gran historia.\n                    </p>\n                </div>\n                <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-2\">\n                    <span class=\"hidden text-[12px] text-[var(--c