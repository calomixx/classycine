    "var_7f4afd13bae8": {
      "type": "variant",
      "label": "CineClassify · Editorial Split Dashboard",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap');\n\n  .cc-shell {\n    --cc-ink: #f5f3ef;\n    --cc-muted: #9aa5b5;\n    --cc-subtle: #697586;\n    --cc-bg: #0a0d13;\n    --cc-surface: #111722;\n    --cc-surface-2: #151d2a;\n    --cc-surface-3: #1a2432;\n    --cc-line: #2a3545;\n    --cc-line-soft: #202a38;\n    --cc-amber: #f0b35d;\n    --cc-amber-soft: #2a2116;\n    --cc-coral: #d97c74;\n    --cc-coral-soft: #2b1d21;\n    --cc-blue: #8aa9c6;\n    --cc-green: #87b59a;\n    --cc-radius-lg: 18px;\n    --cc-radius-md: 12px;\n    --cc-radius-sm: 8px;\n    min-height: 100vh;\n    background: var(--cc-bg);\n    color: var(--cc-ink);\n    font-family: 'Outfit', sans-serif;\n    letter-spacing: -0.01em;\n  }\n\n  .cc-shell *, .cc-shell *::before, .cc-shell *::after { box-sizing: border-box; }\n  .cc-shell button, .cc-shell input { font: inherit; }\n  .cc-shell button { cursor: pointer; }\n  .cc-shell img { display: block; max-width: 100%; }\n  .cc-shell a { color: inherit; text-decoration: none; }\n  .cc-shell h1, .cc-shell h2, .cc-shell h3, .cc-shell p { margin: 0; }\n  .cc-shell .cc-icon { width: 18px; height: 18px; stroke-width: 1.8; flex: 0 0 auto; }\n  .cc-shell .cc-icon-sm { width: 15px; height: 15px; stroke-width: 1.8; flex: 0 0 auto; }\n  .cc-shell .cc-icon-lg { width: 22px; height: 22px; stroke-width: 1.7; flex: 0 0 auto; }\n\n  .cc-shell :focus-visible {\n    outline: 2px solid var(--cc-amber);\n    outline-offset: 3px;\n  }\n\n  .cc-topbar {\n    position: sticky;\n    top: 0;\n    z-index: 30;\n    height: 74px;\n    display: flex;\n    align-items: center;\n    gap: 24px;\n    padding: 0 32px 0 30px;\n    background: rgba(10, 13, 19, 0.96);\n    border-bottom: 1px solid var(--cc-line-soft);\n  }\n\n  .cc-brand {\n    width: 222px;\n    display: flex;\n    align-items: center;\n    gap: 11px;\n    flex: 0 0 auto;\n  }\n  .cc-brand-mark {\n    width: 32px;\n    height: 32px;\n    display: grid;\n    place-items: center;\n    border-radius: 9px;\n    background: var(--cc-amber);\n    color: #17120b;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: -0.08em;\n  }\n  .cc-brand-name { font-size: 17px; font-weight: 700; letter-spacing: -0.04em; }\n  .cc-brand-name span { color: var(--cc-amber); }\n  .cc-search {\n    width: min(420px, 42vw);\n    height: 42px;\n    position: relative;\n  }\n  .cc-search .cc-icon { position: absolute; top: 12px; left: 14px; color: var(--cc-subtle); }\n  .cc-search input {\n    width: 100%;\n    height: 42px;\n    padding: 0 16px 0 42px;\n    color: var(--cc-ink);\n    background: var(--cc-surface);\n    border: 1px solid var(--cc-line-soft);\n    border-radius: 10px;\n    outline: none;\n    font-size: 13px;\n  }\n  .cc-search input::placeholder { color: var(--cc-subtle); }\n  .cc-search input:focus { border-color: var(--cc-amber); }\n  .cc-topbar-spacer { flex: 1; }\n  .cc-topbar-link {\n    height: 42px;\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    padding: 0 13px;\n    color: var(--cc-muted);\n    border: 1px solid transparent;\n    border-radius: 9px;\n    background: transparent;\n    font-size: 13px;\n    font-weight: 600;\n  }\n  .cc-topbar-link:hover { color: var(--cc-ink); background: var(--cc-surface); border-color: var(--cc-line-soft); }\n  .cc-notification {\n    position: relative;\n    width: 42px;\n    height: 42px;\n    display: grid;\n    place-items: center;\n    color: var(--cc-muted);\n    background: transparent;\n    border: 1px solid transparent;\n    border-radius: 9px;\n  }\n  .cc-notification:hover { color: var(--cc-ink); background: var(--cc-surface); border-color: var(--cc-line-soft); }\n  .cc-notification::after {\n    content: '';\n    position: absolute;\n    top: 9px;\n    right: 10px;\n    width: 5px;\n    height: 5px;\n    border-radius: 50%;\n    background: var(--cc-coral);\n    border: 1px solid var(--cc-bg);\n  }\n  .cc-user {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    padding-left: 16px;\n    border-left: 1px solid var(--cc-line-soft);\n  }\n  .cc-avatar {\n    width: 34px;\n    height: 34px;\n    display: grid;\n    place-items: center;\n    border-radius: 50%;\n    color: #17120b;\n    background: var(--cc-amber);\n    font-size: 12px;\n    font-weight: 700;\n  }\n  .cc-user-copy { line-height: 1.15; }\n  .cc-user-name { color: var(--cc-ink); font-size: 13px; font-weight: 600; }\n  .cc-user-role { margin-top: 4px; color: var(--cc-subtle); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; }\n\n  .cc-body { display: flex; min-height: calc(100vh - 74px); }\n  .cc-sidebar {\n    position: sticky;\n    top: 74px;\n    width: 252px;\n    height: calc(100vh - 74px);\n    flex: 0 0 252px;\n    padding: 29px 18px 24px;\n    background: #0d1119;\n    border-right: 1px solid var(--cc-line-soft);\n    overflow-y: auto;\n  }\n  .cc-nav-label {\n    margin: 0 12px 10px;\n    color: var(--cc-subtle);\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n  }\n  .cc-nav-label:not(:first-child) { margin-top: 30px; }\n  .cc-nav { display: grid; gap: 4px; }\n  .cc-nav-item {\n    min-height: 44px;\n    width: 100%;\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding: 0 12px;\n    color: var(--cc-muted);\n    background: transparent;\n    border: 1px solid transparent;\n    border-radius: 9px;\n    text-align: left;\n    font-size: 13px;\n    font-weight: 500;\n  }\n  .cc-nav-item:hover { color: var(--cc-ink); background: var(--cc-surface); border-color: var(--cc-line-soft); }\n  .cc-nav-item.is-active {\n    color: var(--cc-ink);\n    background: #1a1b1c;\n    border-color: #3b3124;\n    box-shadow: inset 3px 0 0 var(--cc-amber);\n  }\n  .cc-nav-item.is-active .cc-icon { color: var(--cc-amber); }\n  .cc-nav-item .cc-nav-count { margin-left: auto; color: var(--cc-subtle); font-size: 11px; }\n  .cc-side-note {\n    margin-top: 36px;\n    padding: 15px 14px;\n    background: var(--cc-surface);\n    border: 1px solid var(--cc-line-soft);\n    border-radius: var(--cc-radius-md);\n  }\n  .cc-side-note-head { display: flex; align-items: center; gap: 8px; color: var(--cc-amber); font-size: 11px; font-weight: 700; }\n  .cc-side-note p { margin-top: 8px; color: var(--cc-muted); font-size: 12px; line-height: 1.5; }\n\n  .cc-main {\n    min-width: 0;\n    flex: 1;\n    padding: 36px 42px 62px;\n    background: linear-gradient(110deg, #0a0d13 0%, #0c111a 68%, #0d131e 100%);\n  }\n  .cc-main-inner { max-width: 1210px; margin: 0 auto; }\n  .cc-page-kicker { color: var(--cc-amber); font-size: 10px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; }\n  .cc-page-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 22px; margin-bottom: 25px; }\n  .cc-page-head h1 { margin-top: 7px; font-size: clamp(25px, 3vw, 37px); line-height: 1.07; letter-spacing: -0.055em; font-weight: 600; }\n  .cc-page-head h1 em { color: var(--cc-muted); font-family: 'Playfair Display', serif; font-style: normal; font-weight: 600; }\n  .cc-page-head p { max-width: 390px; color: var(--cc-muted); font-size: 13px; line-height: 1.55; text-align: right; }\n\n  .cc-first-fold {\n    display: grid;\n    grid-template-columns: minmax(0, 1.48fr) minmax(315px, 0.78fr);\n    gap: 20px;\n    align-items: stretch;\n  }\n  .cc-spotlight {\n    min-height: 430px;\n    position: relative;\n    overflow: hidden;\n    display: flex;\n    align-items: flex-end;\n    border: 1px solid #344152;\n    border-radius: var(--cc-radius-lg);\n    background: var(--cc-surface);\n  }\n  .cc-spotlight-image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.62; }\n  .cc-spotlight::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(90deg, rgba(7, 10, 15, 0.94) 0%, rgba(7, 10, 15, 0.73) 43%, rgba(7, 10, 15, 0.10) 100%), linear-gradient(0deg, rgba(7, 10, 15, 0.98) 0%, rgba(7, 10, 15, 0.05) 72%);\n  }\n  .cc-spotlight-copy { position: relative; z-index: 1; width: 70%; padding: 32px 34px; }\n  .cc-eyebrow { display: inline-flex; align-items: center; gap: 7px; color: var(--cc-amber); font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }\n  .cc-eyebrow .cc-icon-sm { stroke-width: 2.1; }\n  .cc-spotlight h2 { margin-top: 12px; font-family: 'Playfair Display', serif; font-size: clamp(34px, 4vw, 53px); line-height: 0.98; letter-spacing: -0.05em; font-weight: 700; }\n  .cc-spotlight-lede { max-width: 430px; margin-top: 15px; color: #c4cbd5; font-size: 13px; line-height: 1.65; }\n  .cc-meta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 9px; margin-top: 17px; color: var(--cc-muted); font-size: 11px; }\n  .cc-meta-dot { width: 3px; height: 3px; border-radius: 50%; background: var(--cc-subtle); }\n  .cc-rating { display: inline-flex; align-items: center; gap: 5px; color: var(--cc-amber); font-weight: 700; }\n  .cc-spotlight-actions { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 23px; }\n  .cc-btn {\n    min-height: 42px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    padding: 0 15px;\n    color: var(--cc-ink);\n    background: var(--cc-surface-3);\n    border: 1px solid #3a4656;\n    border-radius: 9px;\n    font-size: 12px;\n    font-weight: 600;\n  }\n  .cc-btn:hover { background: #202c3b; border-color: #607085; }\n  .cc-btn-primary { color: #17120b; background: var(--cc-amber); border-color: var(--cc-amber); }\n  .cc-btn-primary:hover { background: #f7c979; border-color: #f7c979; }\n  .cc-btn-quiet { color: var(--cc-muted); background: rgba(17,23,34,0.72); }\n\n  .cc-right-stack { display: grid; grid-template-rows: auto 1fr; gap: 20px; min-width: 0; }\n  .cc-panel { background: var(--cc-surface); border: 1px solid var(--cc-line); border-radius: var(--cc-radius-lg); }\n  .cc-panel-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 19px 20px 15px; border-bottom: 1px solid var(--cc-line-soft); }\n  .cc-panel-title { font-size: 14px; font-weight: 600; letter-spacing: -0.02em; }\n  .cc-panel-link { display: inline-flex; align-items: center; gap: 5px; color: var(--cc-amber); background: none; border: 0; font-size: 11px; font-weight: 600; }\n  .cc-panel-link:hover { color: #ffd38d; }\n  .cc-activity { padding-bottom: 5px; }\n  .cc-activity-row { display: flex; align-items: center; gap: 12px; min-height: 57px; padding: 0 20px; border-bottom: 1px solid var(--cc-line-soft); }\n  .cc-activity-row:last-child { border-bottom: 0; }\n  .cc-activity-icon { width: 28px; height: 28px; display: grid; place-items: center; color: var(--cc-amber); background: var(--cc-amber-soft); border-radius: 7px; }\n  .cc-activity-copy { min-width: 0; flex: 1; }\n  .cc-activity-label { color: var(--cc-muted); font-size: 11px; }\n  .cc-activity-value { margin-top: 3px; color: var(--cc-ink); font-size: 12px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n  .cc-activity-end { color: var(--cc-subtle); font-size: 11px; }\n  .cc-activity-end.is-rating { color: var(--cc-amber); font-weight: 700; }\n\n  .cc-explore { min-height: 0; }\n  .cc-explore-list { padding: 7px 20px 10px; }\n  .cc-explore-item { display: flex; align-items: center; gap: 11px; padding: 11px 0; border-bottom: 1px solid var(--cc-line-soft); }\n  .cc-explore-item:last-child { border-bottom: 0; }\n  .cc-explore-poster { width: 42px; height: 56px; flex: 0 0 42px; object-fit: cover; border-radius: 6px; border: 1px solid #3a4656; }\n  .cc-explore-copy { min-width: 0; flex: 1; }\n  .cc-explore-title { color: var(--cc-ink); font-size: 12px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n  .cc-explore-meta { display: flex; align-items: center; gap: 7px; margin-top: 5px; color: var(--cc-subtle); font-size: 10px; }\n  .cc-explore-meta .cc-rating { color: var(--cc-amber); }\n  .cc-explore-arrow { color: var(--cc-subtle); }\n  .cc-explore-item:hover .cc-explore-arrow { color: var(--cc-amber); }\n\n  .cc-section { margin-top: 30px; }\n  .cc-section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 18px; margin-bottom: 13px; }\n  .cc-section-title { font-size: 17px; font-weight: 600; letter-spacing: -0.035em; }\n  .cc-section-subtitle { color: var(--cc-subtle); font-size: 11px; }\n  .cc-section-action { display: inline-flex; align-items: center; gap: 5px; color: var(--cc-muted); background: none; border: 0; font-size: 11px; font-weight: 600; }\n  .cc-section-action:hover { color: var(--cc-amber); }\n\n  .cc-carousel-shell {\n    position: relative;\n    overflow: hidden;\n    padding: 5px 0 10px;\n  }\n  .cc-carousel-scene {\n    --cc-card-w: clamp(150px, 18vw, 220px);\n    --cc-card-h: clamp(288px, 31vw, 348px);\n    position: relative;\n    width: 100%;\n    height: calc(var(--cc-card-h) + 22px);\n    overflow: hidden;\n  }\n  .cc-carousel-ring { position: absolute; inset: 0; }\n  .cc-poster-card {\n    position: absolute;\n    top: calc(50% - var(--cc-card-h) / 2);\n    left: calc(50% - var(--cc-card-w) / 2);\n    width: var(--cc-card-w);\n    height: var(--cc-card-h);\n    min-width: 0;\n    overflow: hidden;\n    display: flex;\n    flex-direction: column;\n    background: var(--cc-surface);\n    border: 1px solid var(--cc-line);\n    border-radius: 12px;\n    cursor: pointer;\n    transition: transform 0.58s cubic-bezier(0.25, 0.46, 0.45, 0.94), opacity 0.42s ease, border-color 0.2s ease, box-shadow 0.2s ease;\n    will-change: transform, opacity;\n  }\n  .cc-poster-card.is-active { cursor: default; box-shadow: 0 14px 30px rgba(0,0,0,0.32); pointer-events: none; }\n  .cc-poster-card.is-active .cc-card-heart { pointer-events: auto; }\n  .cc-poster-wrap { position: relative; overflow: hidden; flex: 0 0 62%; min-height: 0; background: var(--cc-surface); border: 0; border-bottom: 1px solid var(--cc-line-soft); border-radius: 0; }\n  .cc-poster-wrap img { width: 100%; height: 100%; object-fit: cover; }\n  .cc-poster-card:hover .cc-poster-wrap, .cc-poster-card.is-active .cc-poster-wrap { border-color: #627086; }\n  .cc-poster-card:hover { border-color: #627086; }\n  .cc-carousel-nav { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-top: 4px; padding: 0 5px; }\n  .cc-carousel-status { color: var(--cc-subtle); font-size: 10px; letter-spacing: 0.09em; text-transform: uppercase; }\n  .cc-carousel-status strong { color: var(--cc-amber); font-weight: 700; }\n  .cc-carousel-buttons { display: flex; align-items: center; gap: 8px; }\n  .cc-carousel-button {\n    width: 42px;\n    height: 42px;\n    display: grid;\n    place-items: center;\n    color: var(--cc-ink);\n    background: var(--cc-surface-2);\n    border: 1px solid var(--cc-line);\n    border-radius: 50%;\n  }\n  .cc-carousel-button:hover { color: var(--cc-amber); background: var(--cc-surface-3); border-color: #627086; }\n  .cc-poster-info { flex: 1; min-height: 0; display: flex; flex-direction: column; padding: 9px 11px 11px; }\n  .cc-poster-meta { margin-top: auto; }\n  .cc-card-heart {\n    position: absolute;\n    top: 8px;\n    right: 8px;\n    width: 44px;\n    height: 44px;\n    display: grid;\n    place-items: center;\n    color: var(--cc-ink);\n    background: rgba(10,13,19,0.78);\n    border: 1px solid rgba(255,255,255,0.18);\n    border-radius: 50%;\n  }\n  .cc-card-heart:hover { color: var(--cc-coral); background: #23191c; border-color: var(--cc-coral); }\n  .cc-card-heart.is-saved { color: var(--cc-coral); background: var(--cc-coral-soft); border-color: #754448; }\n  .cc-poster-info { padding: 9px 11px 11px; }\n  .cc-poster-title { color: var(--cc-ink); font-size: 12px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n  .cc-poster-meta { display: flex; align-items: center; justify-content: space-between; gap: 6px; margin-top: auto; color: var(--cc-subtle); font-size: 10px; }\n  .cc-poster-meta .cc-rating { color: var(--cc-amber); }\n\n  .cc-bottom-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr); gap: 20px; }\n  .cc-commented-panel { overflow: hidden; }\n  .cc-commented-list { padding: 5px 20px 9px; }\n  .cc-commented-item { display: grid; grid-template-columns: 28px 42px minmax(0,1fr) auto; align-items: center; gap: 11px; min-height: 73px; border-bottom: 1px solid var(--cc-line-soft); }\n  .cc-commented-item:last-child { border-bottom: 0; }\n  .cc-rank { color: var(--cc-subtle); font-size: 12px; font-weight: 700; }\n  .cc-rank.is-first { color: var(--cc-amber); }\n  .cc-mini-poster { width: 42px; height: 55px; object-fit: cover; border-radius: 6px; border: 1px solid var(--cc-line); }\n  .cc-commented-copy { min-width: 0; }\n  .cc-commented-title { color: var(--cc-ink); font-size: 12px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n  .cc-commented-meta { margin-top: 5px; color: var(--cc-subtle); font-size: 10px; }\n  .cc-commented-score { color: var(--cc-amber); font-size: 11px; font-weight: 700; text-align: right; }\n  .cc-curation-panel { padding: 23px 23px 21px; background: #171d27; }\n  .cc-curation-label { color: var(--cc-amber); font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }\n  .cc-curation-panel h3 { max-width: 330px; margin-top: 12px; font-family: 'Playfair Display', serif; font-size: 26px; line-height: 1.08; letter-spacing: -0.045em; }\n  .cc-curation-panel p { max-width: 330px; margin-top: 11px; color: var(--cc-muted); font-size: 12px; line-height: 1.6; }\n  .cc-curation-rule { width: 100%; height: 1px; margin: 20px 0 15px; background: var(--cc-line); }\n  .cc-curation-foot { display: flex; align-items: center; justify-content: space-between; color: var(--cc-subtle); font-size: 10px; }\n  .cc-curation-foot strong { color: var(--cc-ink); font-weight: 600; }\n\n  @media (max-width: 1050px) {\n    .cc-topbar { padding-left: 22px; padding-right: 22px; }\n    .cc-brand { width: 190px; }\n    .cc-sidebar { width: 220px; flex-basis: 220px; }\n    .cc-main { padding-left: 28px; padding-right: 28px; }\n    .cc-first-fold { grid-template-columns: minmax(0, 1.2fr) minmax(290px, 0.8fr); }\n    .cc-spotlight-copy { width: 82%; padding: 28px; }\n  }\n  @media (max-width: 820px) {\n    .cc-brand { width: auto; }\n    .cc-brand-name { display: none; }\n    .cc-topbar { gap: 14px; }\n    .cc-topbar-link { display: none; }\n    .cc-sidebar { width: 76px; flex-basis: 76px; padding-left: 12px; padding-right: 12px; }\n    .cc-nav-label, .cc-nav-item span:not(.cc-icon), .cc-nav-count, .cc-side-note { display: none; }\n    .cc-nav-item { justify-content: center; padding: 0; }\n    .cc-nav-item.is-active { box-shadow: inset 0 -3px 0 var(--cc-amber); }\n    .cc-first-fold, .cc-bottom-grid { grid-template-columns: 1fr; }\n    .cc-right-stack { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }\n    .cc-page-head { align-items: flex-start; flex-direction: column; }\n    .cc-page-head p { text-align: left; }\n  }\n  @media (max-width: 590px) {\n    .cc-topbar { height: 66px; padding: 0 15px; }\n    .cc-body { min-height: calc(100vh - 66px); }\n    .cc-sidebar { top: 66px; height: calc(100vh - 66px); width: 58px; flex-basis: 58px; padding: 20px 8px; }\n    .cc-main { padding: 25px 16px 46px; }\n    .cc-search { width: auto; flex: 1; }\n    .cc-user { padding-left: 8px; border-left: 0; }\n    .cc-user-copy { display: none; }\n    .cc-page-head h1 { font-size: 29px; }\n    .cc-spotlight { min-height: 455px; }\n    .cc-spotlight-copy { width: 100%; padding: 24px 22px; }\n    .cc-spotlight h2 { font-size: 42px; }\n    .cc-right-stack { grid-template-columns: 1fr; }\n    .cc-carousel-scene { --cc-card-w: min(58vw, 220px); --cc-card-h: 330px; }\n    .cc-carousel-nav { padding: 0; }\n    .cc-commented-item { grid-template-columns: 24px 40px minmax(0,1fr) auto; gap: 8px; }\n  }\n</style>\n<div class=\"cc-shell\" data-kid=\"1\">\n    <header class=\"cc-topbar\" data-kid=\"1-1\">\n        <div aria-label=\"CineClassify\" class=\"cc-brand\" data-kid=\"1-1-1\">\n            <div aria-hidden=\"true\" class=\"cc-brand-mark\" data-kid=\"1-1-1-1\">\n                CC\n            </div>\n            <div class=\"cc-brand-name\" data-kid=\"1-1-1-2\">\n                Cine\n                <span data-kid=\"1-1-1-2-1\">\n                    Classify\n                </span>\n            </div>\n        </div>\n        <label aria-label=\"Buscar en CineClassify\" class=\"cc-search\" data-kid=\"1-1-2\">\n            <i aria-hidden=\"true\" class=\"cc-icon\" data-kid=\"1-1-2-1\" data-lucide=\"search\">\n            </i>\n            <input data-kid=\"1-1-2-2\" placeholder=\"Buscar título, actor o director...\" type=\"search\"/>\n        </label>\n        <div class=\"cc-topbar-spacer\" data-kid=\"1-1-3\">\n        </div>\n        <button aria-label=\"Abrir novedades\" class=\"cc-topbar-link\" data-kid=\"1-1-4\" data-name=\"call-to-action button\">\n            <i aria-hidden=\"true\" class=\"cc-icon-sm\" data-kid=\"1-1-4-1\" data-lucide=\"sparkles\">\n            </i>\n            Novedades\n        </button>\n        <button aria-label=\"Ver notificaciones\" class=\"cc-notification\" data-kid=\"1-1-5\" data-name=\"notification alert button\">\n            <i aria-hidden=\"true\" class=\"cc-icon\" data-kid=\"1-1-5-1\" data-lucide=\"bell\">\n            </i>\n        </button>\n        <div aria-label=\"Sesión de admin\" class=\"cc-user\" data-kid=\"1-1-6\">\n            <div aria-hidden=\"true\" class=\"cc-avatar\" data-kid=\"1-1-6-1\">\n                A\n            </div>\n            <div class=\"cc-user-copy\" data-kid=\"1-1-6-2\">\n                <div class=\"cc-user-name\" data-kid=\"1-1-6-2-1\">\n     