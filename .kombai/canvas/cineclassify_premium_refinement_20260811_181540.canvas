      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&display=swap');\n\n  .cine-dashboard {\n    --ink: #091018;\n    --nav: #0c151e;\n    --surface: #111c26;\n    --surface-2: #172530;\n    --surface-3: #1d2d38;\n    --line: #2a3b46;\n    --line-soft: rgba(214, 225, 226, .11);\n    --text: #f5f1e9;\n    --muted: #a4afb3;\n    --muted-2: #71808a;\n    --amber: #e7b66c;\n    --amber-soft: rgba(231, 182, 108, .13);\n    --coral: #d77d6e;\n    --coral-soft: rgba(215, 125, 110, .14);\n    font-family: 'Outfit', sans-serif;\n    background: var(--ink);\n    color: var(--text);\n  }\n\n  .cine-dashboard .font-display { font-family: 'Playfair Display', serif; }\n  .cine-dashboard .nav-item { border-left: 2px solid transparent; }\n  .cine-dashboard .nav-item:hover { background: rgba(255,255,255,.045); color: var(--text); }\n  .cine-dashboard .nav-item.active { background: var(--amber-soft); color: var(--amber); border-left-color: var(--amber); }\n  .cine-dashboard .nav-item:focus-visible,\n  .cine-dashboard button:focus-visible,\n  .cine-dashboard a:focus-visible,\n  .cine-dashboard input:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; }\n  .cine-dashboard .poster-card:hover .poster-image { transform: scale(1.035); }\n  .cine-dashboard .poster-card:hover .poster-scrim { opacity: .18; }\n  .cine-dashboard .poster-card:hover .poster-title { color: var(--amber); }\n  .cine-dashboard .poster-image { transition: transform .35s ease; }\n  .cine-dashboard .poster-scrim { transition: opacity .25s ease; }\n  .cine-dashboard .hero-image { filter: saturate(.78) contrast(1.06); }\n  .cine-dashboard .hero-overlay { background: linear-gradient(90deg, rgba(9,16,24,.98) 0%, rgba(9,16,24,.86) 40%, rgba(9,16,24,.28) 75%, rgba(9,16,24,.72) 100%); }\n  .cine-dashboard .hero-bottom { background: linear-gradient(0deg, rgba(9,16,24,.7), transparent); }\n  .cine-dashboard .search-field::placeholder { color: var(--muted-2); }\n</style>\n<div class=\"cine-dashboard min-h-screen bg-[var(--ink)] text-[var(--text)]\" data-kid=\"1\" data-name=\"cine dashboard application container\">\n    <div class=\"grid min-h-screen grid-cols-[236px_minmax(0,1fr)]\" data-kid=\"1-1\" data-name=\"layout grid container\">\n        <aside aria-label=\"Navegación principal\" class=\"flex min-h-screen flex-col border-r border-[var(--line-soft)] bg-[var(--nav)] px-4 py-5\" data-kid=\"1-1-1\" data-name=\"sidebar navigation panel\">\n            <div class=\"flex items-center gap-3 border-b border-[var(--line-soft)] px-2 pb-5\" data-kid=\"1-1-1-1\" data-name=\"brand logo and title area\">\n                <div aria-hidden=\"true\" class=\"flex h-9 w-9 items-center justify-center border border-[var(--amber)]/70 text-[13px] font-bold tracking-[-.08em] text-[var(--amber)]\" data-kid=\"1-1-1-1-1\" data-name=\"CC brand initials icon\">\n                    CC\n                </div>\n                <div data-kid=\"1-1-1-1-2\" data-name=\"brand title group\">\n                    <div class=\"text-[17px] font-semibold tracking-[-.03em] text-[var(--text)]\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand main title\">\n                        Cine\n                        <span class=\"text-[var(--amber)]\" data-kid=\"1-1-1-1-2-1-1\" data-name=\"brand secondary title color segment\">\n                            Classify\n                        </span>\n                    </div>\n                    <div class=\"mt-0.5 text-[9px] font-semibold uppercase tracking-[.22em] text-[var(--muted-2)]\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand subtitle\">\n                        Tu archivo personal\n                    </div>\n                </div>\n            </div>\n            <nav aria-label=\"Secciones\" class=\"mt-7 flex-1\" data-kid=\"1-1-1-2\" data-name=\"navigation menu container\">\n                <div class=\"mb-2 px-3 text-[10px] font-semibold uppercase tracking-[.2em] text-[var(--muted-2)]\" data-kid=\"1-1-1-2-1\" data-name=\"sidebar section label\">\n                    Explorar\n                </div>\n                <div class=\"space-y-1\" data-kid=\"1-1-1-2-2\" data-name=\"sidebar navigation items list\">\n                    <button aria-current=\"page\" class=\"nav-item active flex w-full items-center gap-3 rounded-r-md px-3 py-2.5 text-left text-[13px] font-semibold\" data-kid=\"1-1-1-2-2-1\" data-name=\"active dashboard navigation item\">\n                        <i aria-hidden=\"true\" data-kid=\"1-1-1-2-2-1-1\" data-lucide=\"layout-dashboard\" data-name=\"dashboard icon\" height=\"17\" stroke-width=\"1.8\" width=\"17\">\n                        </i>\n                        <span data-kid=\"1-1-1-2-2-1-2\" data-name=\"dashboard label\">\n                            Inicio\n                        </span>\n                    </button>\n                    <button class=\"nav-item flex w-full items-center gap-3 rounded-r-md px-3 py-2.5 text-left text-[13px] font-medium text-[var(--muted)]\" data-kid=\"1-1-1-2-2-2\" data-name=\"movies navigation item\">\n                        <i aria-hidden=\"true\" data-kid=\"1-1-1-2-2-2-1\" data-lucide=\"film\" data-name=\"movies icon\" height=\"17\" stroke-width=\"1.8\" width=\"17\">\n                        </i>\n                        <span data-kid=\"1-1-1-2-2-2-2\" data-name=\"movies label\">\n                            Películas\n                        </span>\n                    </button>\n                    <button class=\"nav-item flex w-full items-center gap-3 rounded-r-md px-3 py-2.5 text-left text-[13px] font-medium text-[var(--muted)]\" data-kid=\"1-1-1-2-2-3\" data-name=\"series navigation item\">\n                        <i aria-hidden=\"true\" data-kid=\"1-1-1-2-2-3-1\" data-lucide=\"tv\" data-name=\"series icon\" height=\"17\" stroke-width=\"1.8\" width=\"17\">\n                        </i>\n                        <span data-kid=\"1-1-1-2-2-3-2\" data-name=\"series label\">\n                            Series\n                        </span>\n                    </button>\n                    <button class=\"nav-item flex w-full items-center gap-3 rounded-r-md px-3 py-2.5 text-left text-[13px] font-medium text-[var(--muted)]\" data-kid=\"1-1-1-2-2-4\" data-name=\"top rated navigation item\">\n                        <i aria-hidden=\"true\" data-kid=\"1-1-1-2-2-4-1\" data-lucide=\"trophy\" data-name=\"top rated icon\" height=\"17\" stroke-width=\"1.8\" width=\"17\">\n                        </i>\n                        <span data-kid=\"1-1-1-2-2-4-2\" data-name=\"top rated label\">\n                            Mejor puntuadas\n                        </span>\n                    </button>\n                    <button class=\"nav-item flex w-full items-center gap-3 rounded-r-md px-3 py-2.5 text-left text-[13px] font-medium text-[var(--muted)]\" data-kid=\"1-1-1-2-2-5\" data-name=\"statistics navigation item\">\n                        <i aria-hidden=\"true\" data-kid=\"1-1-1-2-2-5-1\" data-lucide=\"bar-chart-3\" data-name=\"statistics icon\" height=\"17\" stroke-width=\"1.8\" width=\"17\">\n                        </i>\n                        <span data-kid=\"1-1-1-2-2-5-2\" data-name=\"statistics label\">\n                            Estadísticas\n                        </span>\n                    </button>\n                </div>\n                <div class=\"mb-2 mt-8 px-3 text-[10px] font-semibold uppercase tracking-[.2em] text-[var(--muted-2)]\" data-kid=\"1-1-1-2-3\" data-name=\"account section label\">\n                    Mi cuenta\n                </div>\n                <div class=\"space-y-1\" data-kid=\"1-1-1-2-4\" data-name=\"account navigation items list\">\n                    <button class=\"nav-item flex w-full items-center gap-3 rounded-r-md px-3 py-2.5 text-left text-[13px] font-medium text-[var(--muted)]\" data-kid=\"1-1-1-2-4-1\" data-name=\"my list navigation item\">\n                        <i aria-hidden=\"true\" data-kid=\"1-1-1-2-4-1-1\" data-lucide=\"heart\" data-name=\"my list icon\" height=\"17\" stroke-width=\"1.8\" width=\"17\">\n                        </i>\n                        <span data-kid=\"1-1-1-2-4-1-2\" data-name=\"my list label\">\n                            Mi lista\n                        </span>\n                        <span class=\"ml-auto text-[10px] text-[var(--muted-2)]\" data-dynamic=\"true\" data-kid=\"1-1-1-2-4-1-3\" data-name=\"my list count\" data-reason=\"count value updated by script\">\n                            06\n                        </span>\n                    </button>\n                    <button class=\"nav-item flex w-full items-center gap-3 rounded-r-md px-3 py-2.5 text-left text-[13px] font-medium text-[var(--muted)]\" data-kid=\"1-1-1-2-4-2\" data-name=\"my tier list navigation item\">\n                        <i aria-hidden=\"true\" data-kid=\"1-1-1-2-4-2-1\" data-lucide=\"list-ordered\" data-name=\"my tier list icon\" height=\"17\" stroke-width=\"1.8\" width=\"17\">\n                        </i>\n                        <span data-kid=\"1-1-1-2-4-2-2\" data-name=\"my tier list label\">\n                            Mi tier list\n                        </span>\n                    </button>\n                </div>\n                <div class=\"mb-2 mt-8 px-3 text-[10px] font-semibold uppercase tracking-[.2em] text-[var(--muted-2)]\" data-kid=\"1-1-1-2-5\" data-name=\"administration section label\">\n                    Administración\n                </div>\n                <div class=\"space-y-1\" data-kid=\"1-1-1-2-6\" data-name=\"administration navigation items list\">\n                    <button class=\"nav-item flex w-full items-center gap-3 rounded-r-md px-3 py-2.5 text-left text-[13px] font-medium text-[var(--muted)]\" data-kid=\"1-1-1-2-6-1\" data-name=\"manage content navigation item\">\n                        <i aria-hidden=\"true\" data-kid=\"1-1-1-2-6-1-1\" data-lucide=\"library-big\" data-name=\"manage content icon\" height=\"17\" stroke-width=\"1.8\" width=\"17\">\n                        </i>\n                        <span data-kid=\"1-1-1-2-6-1-2\" data-name=\"manage content label\">\n                            Gestionar contenido\n                        </span>\n                    </button>\n                    <button class=\"nav-item flex w-full items-center gap-3 rounded-r-md px-3 py-2.5 text-left text-[13px] font-medium text-[var(--muted)]\" data-kid=\"1-1-1-2-6-2\" data-name=\"manage users navigation item\">\n                        <i aria-hidden=\"true\" data-kid=\"1-1-1-2-6-2-1\" data-lucide=\"users\" data-name=\"manage users icon\" height=\"17\" stroke-width=\"1.8\" width=\"17\">\n                        </i>\n                        <span data-kid=\"1-1-1-2-6-2-2\" data-name=\"manage users label\">\n                            Gestionar usuarios\n                        </span>\n                    </button>\n                </div>\n            </nav>\n            <div class=\"border-t border-[var(--line-soft)] px-2 pt-4\" data-kid=\"1-1-1-3\" data-name=\"user profile summary container\">\n                <div class=\"flex items-center gap-3 rounded-md border border-[var(--line-soft)] bg-[var(--surface)] px-3 py-3\" data-kid=\"1-1-1-3-1\" data-name=\"user profile card\">\n                    <div class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[var(--coral-soft)] text-[11px] font-bold text-[var(--coral)]\" data-kid=\"1-1-1-3-1-1\" data-name=\"admin user avatar\">\n                        AD\n                    </div>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"1-1-1-3-1-2\" data-name=\"user info block\">\n                        <div class=\"truncate text-[12px] font-semibold text-[var(--text)]\" data-kid=\"1-1-1-3-1-2-1\" data-name=\"admin username\">\n                            admin\n                        </div>\n                        <div class=\"text-[10px] uppercase tracking-[.12em] text-[var(--muted-2)]\" data-kid=\"1-1-1-3-1-2-2\" data-name=\"admin role\">\n                            Administrador\n                        </div>\n                    </div>\n                    <i aria-hidden=\"true\" class=\"text-[var(--muted-2)]\" data-kid=\"1-1-1-3-1-3\" data-lucide=\"settings-2\" data-name=\"user settings icon\" height=\"15\" stroke-width=\"1.8\" width=\"15\">\n                    </i>\n                </div>\n            </div>\n        </aside>\n        <main class=\"min-w-0 bg-[var(--ink)]\" data-kid=\"1-1-2\" data-name=\"main content area\">\n            <header aria-label=\"Barra superior\" class=\"sticky top-0 z-20 flex h-[72px] items-center justify-between border-b border-[var(--line-soft)] bg-[rgba(9,16,24,.96)] px-8\" data-kid=\"1-1-2-1\" data-name=\"sticky header bar\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-1-2-1-1\" data-name=\"breadcrumb path area\">\n                    <span class=\"text-[11px] font-semibold uppercase tracking-[.2em] text-[var(--muted-2)]\" data-kid=\"1-1-2-1-1-1\" data-name=\"breadcrumb prefix\">\n                        Biblioteca /\n                    </span>\n                    <span class=\"text-[11px] font-medium tracking-[.04em] text-[var(--muted)]\" data-kid=\"1-1-2-1-1-2\" data-name=\"breadcrumb current location\">\n                        Inicio\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-5\" data-kid=\"1-1-2-1-2\" data-name=\"header controls group\">\n                    <label class=\"relative block w-[312px]\" data-kid=\"1-1-2-1-2-1\" data-name=\"search input container\">\n                        <span class=\"sr-only\" data-kid=\"1-1-2-1-2-1-1\" data-name=\"search input screen reader label\">\n                            Buscar en CineClassify\n                        </span>\n                        <i aria-hidden=\"true\" class=\"pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-[var(--muted-2)]\" data-kid=\"1-1-2-1-2-1-2\" data-lucide=\"search\" data-name=\"search icon\" height=\"16\" stroke-width=\"1.8\" width=\"16\">\n                        </i>\n                        <input aria-label=\"Buscar título, actor o director\" class=\"search-field h-10 w-full border border-[var(--line)] bg-[var(--surface)] pl-10 pr-4 text-[12px] text-[var(--text)] outline-none placeholder:text-[var(--muted-2)] focus:border-[var(--amber)]\" data-kid=\"1-1-2-1-2-1-3\" data-name=\"search input field\" placeholder=\"Buscar título, actor o director…\" type=\"search\"/>\n                    </label>\n                    <button aria-label=\"Notificaciones\" class=\"relative flex h-9 w-9 items-center justify-center text-[var(--muted)] hover:text-[var(--text)]\" data-kid=\"1-1-2-1-2-2\" data-name=\"notifications button\">\n                        <i aria-hidden=\"true\" data-kid=\"1-1-2-1-2-2-1\" data-lucide=\"bell\" data-name=\"bell icon\" height=\"17\" stroke-width=\"1.8\" width=\"17\">\n                        </i>\n                        <span aria-label=\"Hay una notificación nueva\" class=\"absolute right-[7px] top-[6px] h-1.5 w-1.5 rounded-full bg-[var(--coral)]\" data-kid=\"1-1-2-1-2-2-2\" data-name=\"notification unread indicator\">\n                        </span>\n                    </button>\n                    <div aria-hidden=\"true\" class=\"h-6 w-px bg-[var(--line-soft)]\" data-kid=\"1-1-2-1-2-3\" data-name=\"header separator\">\n                    </div>\n                    <div class=\"flex items-center gap-2.5\" data-kid=\"1-1-2-1-2-4\" data-name=\"header profile area\">\n                        <div aria-label=\"Avatar de admin\" class=\"flex h-8 w-8 items-center justify-center rounded-full bg-[var(--amber-soft)] text-[11px] font-bold text-[var(--amber)]\" data-kid=\"1-1-2-1-2-4-1\" data-name=\"profile avatar\">\n                            AD\n                        </div>\n                        <div class=\"leading-tight\" data-kid=\"1-1-2-1-2-4-2\" data-name=\"profile info block\">\n                            <div class=\"text-[12px] font-semibold text-[var(--text)]\" data-kid=\"1-1-2-1-2-4-2-1\" data-name=\"profile username\">\n                                admin\n                            </div>\n                            <div class=\"mt-0.5 text-[9px] font-semibold uppercase tracking-[.16em] text-[var(--muted-2)]\" data-kid=\"1-1-2-1-2-4-2-2\" data-name=\"profile role\">\n                                Admin\n                            </div>\n                        </div>\n                    </div>\n                    <button aria-label=\"Cerrar sesión\" class=\"flex items-center gap-2 text-[12px] font-semibold text-[var(--muted)] hover:text-[var(--text)]\" data-kid=\"1-1-2-1-2-5\" data-name=\"logout button\">\n                        <i aria-hidden=\"true\" data-kid=\"1-1-2-1-2-5-1\" data-lucide=\"log-out\" data-name=\"logout icon\" height=\"16\" stroke-width=\"1.8\" width=\"16\">\n                        </i>\n                        <span data-kid=\"1-1-2-1-2-5-2\" data-name=\"logout label\">\n                            Salir\n                        </span>\n                    </button>\n                </div>\n            </header>\n            <div class=\"mx-auto max-w-[1136px] px-8 py-7\" data-kid=\"1-1-2-2\" data-name=\"main page content scrollable container\">\n                <section aria-labelledby=\"spotlight-title\" class=\"relative isolate min-h-[286px] overflow-hidden border border-[var(--line)] bg-[var(--surface)]\" data-kid=\"1-1-2-2-1\" data-name=\"hero spotlight section\">\n                    <img alt=\"Cielo estrellado sobre una atmósfera espacial, imagen de Interstellar\" class=\"hero-image absolute inset-0 h-full w-full object-cover object-[center_42%]\" data-kid=\"1-1-2-2-1-1\" data-name=\"hero background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=1200&q=82\"/>\n                    <div aria-hidden=\"true\" class=\"hero-overlay absolute inset-0\" data-kid=\"1-1-2-2-1-2\" data-name=\"hero background dark gradient overlay\">\n                    </div>\n                    <div aria-hidden=\"true\" class=\"hero-bottom absolute inset-x-0 bottom-0 h-20\" data-kid=\"1-1-2-2-1-3\" data-name=\"hero bottom gradient scrim\">\n                    </div>\n                    <div class=\"relative flex min-h-[286px] items-end px-9 pb-8 pt-7\" data-kid=\"1-1-2-2-1-4\" data-name=\"hero content wrapper\">\n                        <div aria-hidden=\"true\" class=\"absolute left-0 top-10 h-[122px] w-[3px] bg-[var(--amber)]\" data-kid=\"1-1-2-2-1-4-1\" data-name=\"hero decorative border line\">\n                        </div>\n                        <div class=\"max-w-[590px]\" data-kid=\"1-1-2-2-1-4-2\" data-name=\"hero text and actions container\">\n                            <div class=\"mb-3 flex items-center gap-3 text-[10px] font-semibold uppercase tracking-[.22em] text-[var(--amber)]\" data-kid=\"1-1-2-2-1-4-2-1\" data-name=\"hero eyebrow category\">\n                                <span class=\"inline-block h-px w-7 bg-[var(--amber)]\" data-kid=\"1-1-2-2-1-4-2-1-1\" data-name=\"hero category line indicator\">\n                                </span>\n                                Selección de la semana\n                            </div>\n                            <h1 class=\"font-display text-[48px] font-semibold leading-[.98] tracking-[-.04em] text-[var(--text)]\" data-kid=\"1-1-2-2-1-4-2-2\" data-name=\"hero title\" id=\"spotlight-title\">\n                                Interstellar\n                            </h1>\n                            <div class=\"mt-4 flex flex-wrap items-center gap-2 text-[11px] font-medium text-[var(--muted)]\" data-kid=\"1-1-2-2-1-4-2-3\" data-name=\"hero metadata list\">\n                                <span class=\"border border-[var(--line)] bg-[rgba(17,28,38,.78)] px-2.5 py-1 text-[var(--text)]\" data-kid=\"1-1-2-2-1-4-2-3-1\" data-name=\"hero release year\">\n                                    2014\n                                </span>\n                                <span class=\"border border-[var(--line)] bg-[rgba(17,28,38,.78)] px-2.5 py-1\" data-kid=\"1-1-2-2-1-4-2-3-2\" data-name=\"hero genre\">\n                                    Ciencia ficción\n                                </span>\n                                <span class=\"border border-[var(--line)] bg-[rgba(17,28,38,.78)] px-2.5 py-1\" data-kid=\"1-1-2-2-1-4-2-3-3\" data-name=\"hero duration\">\n                                    169 min\n                                </span>\n                                <span class=\"flex items-center gap-1 border border-[var(--amber)]/40 bg-[var(--amber-soft)] px-2.5 py-1 text-[var(--amber)]\" data-kid=\"1-1-2-2-1-4-2-3-4\" data-name=\"hero rating badge\">\n                                    <i aria-hidden=\"true\" data-kid=\"1-1-2-2-1-4-2-3-4-1\" data-lucide=\"star\" data-name=\"star icon\" fill=\"currentColor\" height=\"13\" stroke-width=\"1.5\" width=\"13\">\n                                    </i>\n                                    9.5\n                                </span>\n                            </div>\n                            <p class=\"mt-4 max-w-[560px] text-[13px] leading-[1.65] text-[rgba(245,241,233,.75)]\" data-kid=\"1-1-2-2-1-4-2-4\" data-name=\"hero synopsis text\">\n                                Un equipo de exploradores viaja a través de un agujero de gusano para asegurar la supervivencia de la humanidad.\n                            </p>\n                            <div class=\"mt-5 flex items-center gap-3\" data-kid=\"1-1-2-2-1-4-2-5\" data-name=\"hero action buttons container\">\n                                <button aria-label=\"Ver detalle de Interstellar\" class=\"flex h-10 items-center gap-2 bg-[var(--amber)] px-4 text-[12px] font-bold text-[#17130d] hover:bg-[#f0c581] focus-visible:outline-offset-4\" data-kid=\"1-1-2-2-1-4-2-5-1\" data-name=\"view detail button\">\n                                    <i aria-hidden=\"true\" data-kid=\"1-1-2-2-1-4-2-5-1-1\" data-lucide=\"arrow-up-right\" data-name=\"arrow right icon\" height=\"15\" stroke-width=\"2\" width=\"15\">\n                                    </i>\n                                    Ver detalle\n                                </button>\n                                <button aria-label=\"Añadir Interstellar a Mi Lista\" class=\"flex h-10 items-center gap-2 border border-[rgba(245,241,233,.28)] bg-[rgba(9,16,24,.4)] px-4 text-[12px] font-semibold text-[var(--text)] hover:border-[var(--amber)] hover:text-[var(--amber)] focus-visible:outline-offset-4\" data-kid=\"1-1-2-2-1-4-2-5-2\" data-name=\"add to list button\">\n                                    <i aria-hidden=\"true\" data-kid=\"1-1-2-2-1-4-2-5-2-1\" data-lucide=\"heart\" data-name=\"heart icon\" height=\"15\" stroke-width=\"1.8\" width=\"15\">\n                                    </i>\n                                    Añadir a Mi Lista\n                                </button>\n                            </div>\n                        </div>\n                        <div class=\"ml-auto hidden self-start pt-1 text-right text-[10px] font-semibold uppercase tracking-[.18em] text-[rgba(245,241,233,.46)] sm:block\" data-kid=\"1-1-2-2-1-4-3\" data-name=\"hero pagination indicator\">\n                            01\n                            <span class=\"mx-1 text-[var(--amber)]\" data-kid=\"1-1-2-2-1-4-3-1\" data-name=\"hero pagination separator\">\n                                /\n                            </span>\n                            04\n                        </div>\n                    </div>\n                </section>\n                <section aria-label=\"Resumen de actividad\" class=\"mt-5 grid grid-cols-[1.2fr_repeat(3,1fr)] items-center border-y border-[var(--line-soft)] py-4\" data