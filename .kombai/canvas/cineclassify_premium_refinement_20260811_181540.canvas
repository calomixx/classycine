  </div>\n            </section>\n            <section aria-labelledby=\"most-commented-title\" class=\"mt-9\" data-kid=\"1-2-2-4\">\n                <div class=\"mb-4 flex items-end justify-between\" data-kid=\"1-2-2-4-1\">\n                    <div data-kid=\"1-2-2-4-1-1\">\n                        <p class=\"mb-1 text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--cc-text-muted)]\" data-kid=\"1-2-2-4-1-1-1\">\n                            Conversaciones recientes\n                        </p>\n                        <h2 class=\"text-[21px] font-semibold tracking-[-0.035em] text-[var(--cc-text)]\" data-kid=\"1-2-2-4-1-1-2\" id=\"most-commented-title\">\n                            Más comentadas\n                        </h2>\n                    </div>\n                    <button aria-label=\"Ver todo el contenido más comentado\" class=\"cc-secondary cc-focus flex items-center gap-2 rounded-[8px] border border-[#303a45] bg-transparent px-3 py-2 text-[12px] font-semibold text-[var(--cc-text-soft)]\" data-kid=\"1-2-2-4-1-2\">\n                        Ver todo\n                        <i aria-label=\"Ver todo\" data-kid=\"1-2-2-4-1-2-1\" data-lucide=\"arrow-right\" data-name=\"arrow right icon\" height=\"15\" width=\"15\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"cc-scrollbar flex gap-3 overflow-x-auto pb-2\" data-kid=\"1-2-2-4-2\">\n                    <article class=\"flex min-w-[260px] items-center gap-3 rounded-[12px] border border-[#2d3742] bg-[#151b22] p-3.5\" data-kid=\"1-2-2-4-2-1\">\n                        <div class=\"h-[68px] w-[48px] shrink-0 overflow-hidden rounded-[7px] bg-[#252b32]\" data-kid=\"1-2-2-4-2-1-1\">\n                            <img alt=\"Interstellar\" class=\"h-full w-full object-cover\" data-kid=\"1-2-2-4-2-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=180&q=80\"/>\n                        </div>\n                        <div class=\"min-w-0\" data-kid=\"1-2-2-4-2-1-2\">\n                            <h3 class=\"truncate text-[13px] font-semibold\" data-kid=\"1-2-2-4-2-1-2-1\">\n                                Interstellar\n                            </h3>\n                            <p class=\"mt-1 text-[11px] text-[var(--cc-text-muted)]\" data-kid=\"1-2-2-4-2-1-2-2\">\n                                2 reseñas ·\n                                <span class=\"text-[var(--cc-amber-soft)]\" data-kid=\"1-2-2-4-2-1-2-2-1\">\n                                    9.5\n                                </span>\n                            </p>\n                            <p class=\"mt-2 truncate text-[11px] text-[var(--cc-text-soft)]\" data-kid=\"1-2-2-4-2-1-2-3\">\n                                “Visualmente espectacular.”\n                            </p>\n                        </div>\n                        <i aria-label=\"Ver reseñas de Interstellar\" class=\"ml-auto shrink-0 text-[var(--cc-text-muted)]\" data-kid=\"1-2-2-4-2-1-3\" data-lucide=\"message-square\" data-name=\"message square icon\" height=\"16\" width=\"16\">\n                        </i>\n                    </article>\n                    <article class=\"flex min-w-[260px] items-center gap-3 rounded-[12px] border border-[#2d3742] bg-[#151b22] p-3.5\" data-kid=\"1-2-2-4-2-2\">\n                        <div class=\"h-[68px] w-[48px] shrink-0 overflow-hidden rounded-[7px] bg-[#252b32]\" data-kid=\"1-2-2-4-2-2-1\">\n                            <img alt=\"Inception\" class=\"h-full w-full object-cover\" data-kid=\"1-2-2-4-2-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1518773553398-650c184e0bb3?auto=format&fit=crop&w=180&q=80\"/>\n                        </div>\n                        <div class=\"min-w-0\" data-kid=\"1-2-2-4-2-2-2\">\n                            <h3 class=\"truncate text-[13px] font-semibold\" data-kid=\"1-2-2-4-2-2-2-1\">\n                                Inception\n                            </h3>\n                            <p class=\"mt-1 text-[11px] text-[var(--cc-text-muted)]\" data-kid=\"1-2-2-4-2-2-2-2\">\n                                2 reseñas ·\n                                <span class=\"text-[var(--cc-amber-soft)]\" data-kid=\"1-2-2-4-2-2-2-2-1\">\n                                    8.5\n                                </span>\n                            </p>\n                            <p class=\"mt-2 truncate text-[11px] text-[var(--cc-text-soft)]\" data-kid=\"1-2-2-4-2-2-2-3\">\n                                “Nolan en su máximo esplendor.”\n                            </p>\n                        </div>\n                        <i aria-label=\"Ver reseñas de Inception\" class=\"ml-auto shrink-0 text-[var(--cc-text-muted)]\" data-kid=\"1-2-2-4-2-2-3\" data-lucide=\"message-square\" data-name=\"message square icon\" height=\"16\" width=\"16\">\n                        </i>\n                    </article>\n                    <article class=\"flex min-w-[260px] items-center gap-3 rounded-[12px] border border-[#2d3742] bg-[#151b22] p-3.5\" data-kid=\"1-2-2-4-2-3\">\n                        <div class=\"h-[68px] w-[48px] shrink-0 overflow-hidden rounded-[7px] bg-[#252b32]\" data-kid=\"1-2-2-4-2-3-1\">\n                            <img alt=\"Breaking Bad — foto de Tima Miroshnichenko en Pexels\" class=\"h-full w-full object-cover\" data-kid=\"1-2-2-4-2-3-1-1\" data-name=\"Breaking Bad poster image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7991307/pexels-photo-7991307.jpeg?auto=compress&cs=tinysrgb&w=180&q=80\"/>\n                        </div>\n                        <div class=\"min-w-0\" data-kid=\"1-2-2-4-2-3-2\">\n                            <h3 class=\"truncate text-[13px] font-semibold\" data-kid=\"1-2-2-4-2-3-2-1\">\n                                Breaking Bad\n                            </h3>\n                            <p class=\"mt-1 text-[11px] text-[var(--cc-text-muted)]\" data-kid=\"1-2-2-4-2-3-2-2\">\n                                2 reseñas ·\n                                <span class=\"text-[var(--cc-amber-soft)]\" data-kid=\"1-2-2-4-2-3-2-2-1\">\n                                    10.0\n                                </span>\n                            </p>\n                            <p class=\"mt-2 truncate text-[11px] text-[var(--cc-text-soft)]\" data-kid=\"1-2-2-4-2-3-2-3\">\n                                “La mejor serie jamás hecha.”\n                            </p>\n                        </div>\n                        <i aria-label=\"Ver reseñas de Breaking Bad\" class=\"ml-auto shrink-0 text-[var(--cc-text-muted)]\" data-kid=\"1-2-2-4-2-3-3\" data-lucide=\"message-square\" data-name=\"message square icon\" height=\"16\" width=\"16\">\n                        </i>\n                    </article>\n                </div>\n            </section>\n        </main>\n    </div>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    lucide.createIcons();\n</script>\n",
