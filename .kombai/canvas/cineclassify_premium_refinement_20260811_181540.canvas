ata-kid=\"1-2-1-6-2\">\n                    <i aria-hidden=\"true\" class=\"cc-icon\" data-kid=\"1-2-1-6-2-1\" data-lucide=\"users\">\n                    </i>\n                    <span data-kid=\"1-2-1-6-2-2\">\n                        Gestionar Usuarios\n                    </span>\n                </button>\n            </nav>\n            <div class=\"cc-side-note\" data-kid=\"1-2-1-7\">\n                <div class=\"cc-side-note-head\" data-kid=\"1-2-1-7-1\">\n                    <i aria-hidden=\"true\" class=\"cc-icon-sm\" data-kid=\"1-2-1-7-1-1\" data-lucide=\"shield-check\">\n                    </i>\n                    MODO PRO\n                </div>\n                <p data-kid=\"1-2-1-7-2\">\n                    Tu biblioteca, tus criterios. Cada puntuación alimenta tu mapa de cine.\n                </p>\n            </div>\n        </aside>\n        <main class=\"cc-main\" data-kid=\"1-2-2\">\n            <div class=\"cc-main-inner\" data-kid=\"1-2-2-1\">\n                <div class=\"cc-page-head\" data-kid=\"1-2-2-1-1\">\n                    <div data-kid=\"1-2-2-1-1-1\">\n                        <div class=\"cc-page-kicker\" data-kid=\"1-2-2-1-1-1-1\">\n                            Martes · 11 de agosto\n                        </div>\n                        <h1 data-kid=\"1-2-2-1-1-1-2\">\n                            Descubre algo que\n                            <em data-kid=\"1-2-2-1-1-1-2-1\">\n                                merezca\n                            </em>\n                            tu tiempo.\n                        </h1>\n                    </div>\n                    <p data-kid=\"1-2-2-1-1-2\">\n                        Una selección afinada para volver a tus favoritas, continuar explorando y encontrar tu próxima gran historia.\n                    </p>\n                </div>\n                <section aria-label=\"Resumen de inicio\" class=\"cc-first-fold\" data-kid=\"1-2-2-1-2\">\n                    <article class=\"cc-spo