xt-[0.88rem] font-bold leading-snug\" data-kid=\"1-1-3-2-1-4-2-1\" data-name=\"series title\">\n                                Arcane\n                            </h3>\n                            <div class=\"flex items-center justify-between text-[0.75rem]\" data-kid=\"1-1-3-2-1-4-2-2\" data-name=\"series details row\">\n                                <span class=\"font-semibold text-[#f1fa8c]\" data-kid=\"1-1-3-2-1-4-2-2-1\" data-name=\"series rating\">\n                                    ⭐ 9.1\n                                </span>\n                                <span class=\"text-[#64748b]\" data-kid=\"1-1-3-2-1-4-2-2-2\" data-name=\"release year\">\n                                    2021\n                                </span>\n                            </div>\n                            <span class=\"inline-flex w-fit items-center gap-1 rounded-md border border-[rgba(80,250,123,0.5)] bg-[rgba(80,250,123,0.2)] px-2 py-0.5 text-[0.72rem] font-bold text-[#50fa7b]\" data-kid=\"1-1-3-2-1-4-2-3\" data-name=\"critic status badge\">\n                                ✓ Criticada\n                            </span>\n                        </div>\n                    </article>\n                    <article class=\"rotary-card rotary-card--info\" data-dynamic=\"true\" data-kid=\"1-1-3-2-1-5\" data-name=\"series card\" data-reason=\"transform and opacity controlled by carousel script\">\n                        <div class=\"card-poster\" data-kid=\"1-1-3-2-1-5-1\" data-name=\"card image container\">\n                            <img alt=\"Dark — foggy suburban night, KoolShooters on Pexels\" class=\"h-full w-full object-cover\" data-kid=\"1-1-3-2-1-5-1-1\" data-name=\"series poster image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/6495709/pexels-photo-6495709.jpeg?auto=compress&cs=tinysrgb&w=500&q=80\"/>\n                            <button class=\"card-heart absolute top-2.5 right-2.5 z-10 grid h-8 w-8 place-items-center rounded-full border border-white/10 bg-[#080b14]/70 text-sm text-[#94a3b8]\" data-kid=\"1-1-3-2-1-5-1-2\" data-name=\"save to list button\" title=\"Guardar en Mi Lista\" type=\"button\">\n                                🤍\n                            </button>\n                        </div>\n                        <div class=\"rotary-card__info\" data-kid=\"1-1-3-2-1-5-2\" data-name=\"card info container\">\n                            <h3 class=\"m-0 truncate text-[0.88rem] font-bold leading-snug\" data-kid=\"1-1-3-2-1-5-2-1\" data-name=\"series title\">\n                                Dark\n                            </h3>\n                            <div class=\"flex items-center justify-between text-[0.75rem]\" data-kid=\"1-1-3-2-1-5-2-2\" data-name=\"series details row\">\n                                <span class=\"font-semibold text-[#f1fa8c]\" data-kid=\"1-1-3-2-1-5-2-2-1\" data-name=\"series rating\">\n                                    ⭐ 8.7\n                                </span>\n                                <span class=\"text-[#64748b]\" data-kid=\"1-1-3-2-1-5-2-2-2\" data-name=\"release year\">\n                                    2017\n                                </span>\n                            </div>\n                            <span class=\"inline-flex w-fit items-center gap-1 rounded-md border border-[rgba(80,250,123,0.5)] bg-[rgba(80,250,123,0.2)] px-2 py-0.5 text-[0.72rem] font-bold text-[#50fa7b]\" data-kid=\"1-1-3-2-1-5-2-3\" data-name=\"critic status badge\">\n                                ✓ Criticada\n                            </span>\n                        </div>\n                    </article>\n                    <article class=\"rotary-card rotary-card--info\" data-dynamic=\"true\" data-kid=\"1-1-3-2-1-6\" data-name=\"series card\" data-reason=\"transform and opacity controlled by carousel script\">\n                        <div class=\"card-poster\" data-kid=\"1-1-3-2-1-6-1\" data-name=\"card image container\">\n                            <img alt=\"True Detective — noir portrait, cottonbro studio on Pexels\" class=\"h-full w-full object-cover\" data-kid=\"1-1-3-2-1-6-1-1\" data-name=\"series poster image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/8387450/pexels-photo-8387450.jpeg?auto=compress&cs=tinysrgb&w=500&q=80\"/>\n                            <button class=\"card-heart absolute top-2.5 right-2.5 z-10 grid h-8 w-8 place-items-center rounded-full border border-white/10 bg-[#080b14]/70 text-sm text-[#94a3b8]\" data-kid=\"1-1-3-2-1-6-1-2\" data-name=\"save to list button\" title=\"Guardar en Mi Lista\" type=\"button\">\n                                🤍\n                            </button>\n                        </div>\n                        <div class=\"rotary-card__info\" data-kid=\"1-1-3-2-1-6-2\" data-name=\"card info container\">\n                            <h3 class=\"m-0 truncate text-[0.88rem] font-bold leading-snug\" data-kid=\"1-1-3-2-1-6-2-1\" data-name=\"series title\">\n                                True Detective\n                            </h3>\n                            <div class=\"flex items-center justify-between text-[0.75rem]\" data-kid=\"1-1-3-2-1-6-2-2\" data-name=\"series details row\">\n                                <span class=\"font-semibold text-[#f1fa8c]\" data-kid=\"1-1-3-2-1-6-2-2-1\" data-name=\"series rating\">\n                                    ⭐ 8.9\n                                </span>\n                                <span class=\"text-[#64748b]\" data-kid=\"1-1-3-2-1-6-2-2-2\" data-name=\"release year\">\n                                    2014\n                                </span>\n                            </div>\n                            <span class=\"inline-flex w-fit items-center gap-1 rounded-md border border-[rgba(80,250,123,0.5)] bg-[rgba(80,250,123,0.2)] px-2 py-0.5 text-[0.72rem] font-bold text-[#50fa7b]\" data-kid=\"1-1-3-2-1-6-2-3\" data-name=\"critic status badge\">\n                                ✓ Criticada\n                            </span>\n                        </div>\n                    </article>\n                </div>\n            </div>\n            <nav aria-label=\"Carrusel Top Series\" class=\"rotary-nav\" data-kid=\"1-1-3-3\" data-name=\"carousel navigation\">\n                <button aria-label=\"Anterior\" class=\"rotary-prev\" data-kid=\"1-1-3-3-1\" data-name=\"previous button\" type=\"button\">\n                    <i class=\"ti ti-chevron-left\" data-kid=\"1-1-3-3-1-1\" data-name=\"left arrow icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Siguiente\" class=\"rotary-next\" data-kid=\"1-1-3-3-2\" data-name=\"next button\" type=\"button\">\n                    <i class=\"ti ti-chevron-right\" data-kid=\"1-1-3-3-2-1\" data-name=\"right arrow icon\">\n                    </i>\n                </button>\n            </nav>\n        </section>\n    </div>\n</div>\n<script>\n    (function () {\n  function bindFan(root) {\n    if (!root) return;\n    const cards = [...root.querySelectorAll('.rotary-card')];\n    const n = cards.length;\n    if (!n) return;\n    const step = (2 * Math.PI) / n;\n    const halfW = cards[0].offsetWidth / 2 || 105;\n    const outerR = halfW * 2.5;\n    let active = 0;\n\n    function stateFor(offset) {\n      const abs = Math.abs(offset);\n      if (abs === 0) return { tx: 0, sc: 1.00, op: 1.00, zi: 10 };\n      const angle = abs * step, sinA = Math.sin(angle), cosA = Math.cos(angle);\n      if (abs === 1 || cosA >= 0) {\n        const sc = Math.max(0.28, 0.28 + 0.72 * cosA);\n        return { tx: sinA * outerR, sc, op: 0.70 + 0.30 * Math.max(0, cosA), zi: 10 - abs };\n      }\n      return { tx: halfW * 0.9, sc: 0.25, op: sinA > 0.05 ? 0.65 : 0.00, zi: 10 - abs };\n    }\n\n    function setPositions() {\n      cards.forEach((card, i) => {\n        let off = i - active;\n        if (off > n / 2) off -= n;\n        if (off < -n / 2) off += n;\n        const sign = Math.sign(off) || 1;\n        const { tx, sc, op, zi } = stateFor(off);\n        card.style.transform = 'translateX(' + (sign * tx) + 'px) scale(' + sc + ')';\n        card.style.opacity = op;\n        card.style.zIndex = zi;\n        card.classList.toggle('is-active', off === 0);\n      });\n    }\n\n    function rotateTo(target) {\n      active = ((target % n) + n) % n;\n      setPositions();\n    }\n\n    root.querySelector('.rotary-prev').addEventListener('click', function () { rotateTo(active - 1); });\n    root.querySelector('.rotary-next').addEventListener('click', function () { rotateTo(active + 1); });\n    cards.forEach(function (c, i) {\n      c.addEventListener('click', function () { if (i !== active) rotateTo(i); });\n    });\n    setPositions();\n  }\n\n  bindFan(document.querySelector('#fan-movies'));\n})();\n</script>\n<script>\n    (function () {\n  function bindFan(root) {\n    if (!root) return;\n    const cards = [...root.querySelectorAll('.rotary-card')];\n    const n = cards.length;\n    if (!n) return;\n    const step = (2 * Math.PI) / n;\n    const halfW = cards[0].offsetWidth / 2 || 105;\n    const outerR = halfW * 2.5;\n    let active = 0;\n\n    function stateFor(offset) {\n      const abs = Math.abs(offset);\n      if (abs === 0) return { tx: 0, sc: 1.00, op: 1.00, zi: 10 };\n      const angle = abs * step, sinA = Math.sin(angle), cosA = Math.cos(angle);\n      if (abs === 1 || cosA >= 0) {\n        const sc = Math.max(0.28, 0.28 + 0.72 * cosA);\n        return { tx: sinA * outerR, sc, op: 0.70 + 0.30 * Math.max(0, cosA), zi: 10 - abs };\n      }\n      return { tx: halfW * 0.9, sc: 0.25, op: sinA > 0.05 ? 0.65 : 0.00, zi: 10 - abs };\n    }\n\n    function setPositions() {\n      cards.forEach((card, i) => {\n        let off = i - active;\n        if (off > n / 2) off -= n;\n        if (off < -n / 2) off += n;\n        const sign = Math.sign(off) || 1;\n        const { tx, sc, op, zi } = stateFor(off);\n        card.style.transform = 'translateX(' + (sign * tx) + 'px) scale(' + sc + ')';\n        card.style.opacity = op;\n        card.style.zIndex = zi;\n        card.classList.toggle('is-active', off === 0);\n      });\n    }\n\n    function rotateTo(target) {\n      active = ((target % n) + n) % n;\n      setPositions();\n    }\n\n    root.querySelector('.rotary-prev').addEventListener('click', function () { rotateTo(active - 1); });\n    root.querySelector('.rotary-next').addEventListener('click', function () { rotateTo(active + 1); });\n    cards.forEach(function (c, i) {\n      c.addEventListener('click', function () { if (i !== active) rotateTo(i); });\n    });\n    setPositions();\n  }\n\n  bindFan(document.querySelector('#fan-series'));\n})();\n</script>\n",
