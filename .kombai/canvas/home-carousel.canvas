\n                                <span class=\"text-[0.8rem] font-semibold text-[#f1fa8c]\" data-kid=\"2-1-3-2-5-4-2-2-1\">\n                                    ⭐ 9.1\n                                </span>\n                                <span class=\"text-[0.75rem] text-[#64748b]\" data-kid=\"2-1-3-2-5-4-2-2-2\">\n                                    2021\n                                </span>\n                            </div>\n                            <div class=\"mt-2 flex items-center gap-1\" data-kid=\"2-1-3-2-5-4-2-3\">\n                                <span class=\"inline-flex items-center gap-1 rounded-md border border-[rgba(80,250,123,0.5)] bg-[rgba(80,250,123,0.2)] px-2 py-0.5 text-[0.72rem] font-bold text-[#50fa7b]\" data-kid=\"2-1-3-2-5-4-2-3-1\">\n                                    ✓ Criticada\n                                </span>\n                                <i class=\"ti ti-chevron-down text-xs text-[#64748b]\" data-kid=\"2-1-3-2-5-4-2-3-2\">\n                                </i>\n                            </div>\n                        </div>\n                    </article>\n                    <article class=\"rail-card w-[168px] shrink-0 overflow-hidden rounded-xl border border-white/[0.07] bg-white/[0.035]\" data-kid=\"2-1-3-2-5-5\">\n                        <div class=\"relative aspect-[2/3] overflow-hidden bg-[#0f1220]\" data-kid=\"2-1-3-2-5-5-1\">\n                            <img alt=\"Dark — KoolShooters on Pexels\" class=\"h-full w-full object-cover\" data-kid=\"2-1-3-2-5-5-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/6495709/pexels-photo-6495709.jpeg?auto=compress&cs=tinysrgb&w=500&q=80\"/>\n                            <button aria-label=\"Guardar Dark\" class=\"absolute right-2 top-2 grid h-8 w-8 place-items-center rounded-full border border-white/10 bg-[#080b14]/70 text-sm text-[#94a3b8] backdrop-blur-md\" data-kid=\"2-1-3-2-5-5-1-2\" title=\"Guardar en Mi Lista\" type=\"button\">\n                                🤍\n                            </button>\n                            <div class=\"absolute left-2 top-2 rounded-md bg-black/70 px-1.5 py-0.5 text-[0.72rem] font-bold text-[#f1fa8c]\" data-kid=\"2-1-3-2-5-5-1-3\">\n                                ⭐ 8.7\n                            </div>\n                        </div>\n                        <div class=\"px-3 pb-3 pt-2.5\" data-kid=\"2-1-3-2-5-5-2\">\n                            <h3 class=\"truncate text-[0.88rem] font-bold leading-tight\" data-kid=\"2-1-3-2-5-5-2-1\">\n                                Dark\n                            </h3>\n                            <div class=\"mt-1 flex items-center justify-between\" data-kid=\"2-1-3-2-5-5-2-2\">\n                                <span class=\"text-[0.8rem] font-semibold text-[#f1fa8c]\" data-kid=\"2-1-3-2-5-5-2-2-1\">\n                                    ⭐ 8.7\n                                </span>\n                                <span class=\"text-[0.75rem] text-[#64748b]\" data-kid=\"2-1-3-2-5-5-2-2-2\">\n                                    2017\n                                </span>\n                            </div>\n                            <div class=\"mt-2 flex items-center gap-1\" data-kid=\"2-1-3-2-5-5-2-3\">\n                                <span class=\"inline-flex items-center gap-1 rounded-md border border-[rgba(80,250,123,0.5)] bg-[rgba(80,250,123,0.2)] px-2 py-0.5 text-[0.72rem] font-bold text-[#50fa7b]\" data-kid=\"2-1-3-2-5-5-2-3-1\">\n                                    ✓ Criticada\n                                </span>\n                                <i class=\"ti ti-chevron-down text-xs text-[#64748b]\" data-kid=\"2-1-3-2-5-5-2-3-2\">\n                                </i>\n                            </div>\n                        </div>\n                    </article>\n                    <article class=\"rail-card w-[168px] shrink-0 overflow-hidden rounded-xl border border-white/[0.07] bg-white/[0.035]\" data-kid=\"2-1-3-2-5-6\">\n                        <div class=\"relative aspect-[2/3] overflow-hidden bg-[#0f1220]\" data-kid=\"2-1-3-2-5-6-1\">\n                            <img alt=\"True Detective — cottonbro studio on Pexels\" class=\"h-full w-full object-cover\" data-kid=\"2-1-3-2-5-6-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/8387450/pexels-photo-8387450.jpeg?auto=compress&cs=tinysrgb&w=500&q=80\"/>\n                            <button aria-label=\"Guardar True Detective\" class=\"absolute right-2 top-2 grid h-8 w-8 place-items-center rounded-full border border-white/10 bg-[#080b14]/70 text-sm text-[#94a3b8] backdrop-blur-md\" data-kid=\"2-1-3-2-5-6-1-2\" title=\"Guardar en Mi Lista\" type=\"button\">\n                                🤍\n                            </button>\n                            <div class=\"absolute left-2 top-2 rounded-md bg-black/70 px-1.5 py-0.5 text-[0.72rem] font-bold text-[#f1fa8c]\" data-kid=\"2-1-3-2-5-6-1-3\">\n                                ⭐ 8.9\n                            </div>\n                        </div>\n                        <div class=\"px-3 pb-3 pt-2.5\" data-kid=\"2-1-3-2-5-6-2\">\n                            <h3 class=\"truncate text-[0.88rem] font-bold leading-tight\" data-kid=\"2-1-3-2-5-6-2-1\">\n                                True Detective\n                            </h3>\n                            <div class=\"mt-1 flex items-center justify-between\" data-kid=\"2-1-3-2-5-6-2-2\">\n                                <span class=\"text-[0.8rem] font-semibold text-[#f1fa8c]\" data-kid=\"2-1-3-2-5-6-2-2-1\">\n                                    ⭐ 8.9\n                                </span>\n                                <span class=\"text-[0.75rem] text-[#64748b]\" data-kid=\"2-1-3-2-5-6-2-2-2\">\n                                    2014\n                                </span>\n                            </div>\n                            <div class=\"mt-2 flex items-center gap-1\" data-kid=\"2-1-3-2-5-6-2-3\">\n                                <span class=\"inline-flex items-center gap-1 rounded-md border border-[rgba(80,250,123,0.5)] bg-[rgba(80,250,123,0.2)] px-2 py-0.5 text-[0.72rem] font-bold text-[#50fa7b]\" data-kid=\"2-1-3-2-5-6-2-3-1\">\n                                    ✓ Criticada\n                                </span>\n                                <i class=\"ti ti-chevron-down text-xs text-[#64748b]\" data-kid=\"2-1-3-2-5-6-2-3-2\">\n                                </i>\n                            </div>\n                        </div>\n                    </article>\n                </div>\n            </div>\n            <div aria-hidden=\"true\" class=\"rail-pips mt-4 flex items-center justify-center gap-1.5\" data-dynamic=\"true\" data-kid=\"2-1-3-3\" data-name=\"series carousel pips container\" data-reason=\"pips injected and updated by carousel script\">\n            </div>\n        </section>\n    </div>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script>\n    (function () {\n  function initRail(root) {\n    const viewport = root.querySelector('.rail-viewport');\n    const track = root.querySelector('.rail-track');\n    const cards = Array.from(root.querySelectorAll('.rail-card'));\n    const prev = root.querySelector('.rail-prev');\n    const next = root.querySelector('.rail-next');\n    const pipsWrap = root.querySelector('.rail-pips');\n    if (!viewport || !track || !cards.length || !window.gsap) return;\n\n    const gap = 14;\n    const stepCards = 2;\n    let index = 0;\n    let maxIndex = 0;\n    let stepPx = 0;\n    let timer = null;\n    let dragging = false;\n    let startX = 0;\n    let startTx = 0;\n\n    function metrics() {\n      const cardW = cards[0].offsetWidth;\n      stepPx = (cardW + gap) * stepCards;\n      const visible = viewport.clientWidth / (cardW + gap);\n      maxIndex = Math.max(0, Math.ceil((cards.length - visible) / stepCards));\n    }\n\n    function renderPips() {\n      pipsWrap.innerHTML = '';\n      const count = maxIndex + 1;\n      for (let i = 0; i < count; i++) {\n        const pip = document.createElement('span');\n        pip.className = 'rail-pip' + (i === index ? ' is-active' : '');\n        pipsWrap.appendChild(pip);\n      }\n    }\n\n    function go(nextIndex, duration) {\n      metrics();\n      const total = maxIndex + 1;\n      index = ((nextIndex % total) + total) % total;\n      gsap.to(track, {\n        x: -index * stepPx,\n        duration: duration == null ? 0.65 : duration,\n        ease: 'power3.out',\n        overwrite: true\n      });\n      renderPips();\n    }\n\n    function stopAuto() {\n      if (timer) {\n        clearInterval(timer);\n        timer = null;\n      }\n    }\n\n    function startAuto() {\n      stopAuto();\n      timer = setInterval(function () {\n        go(index + 1);\n      }, 3800);\n    }\n\n    prev.addEventListener('click', function () {\n      go(index - 1);\n      startAuto();\n    });\n    next.addEventListener('click', function () {\n      go(index + 1);\n      startAuto();\n    });\n\n    root.addEventListener('mouseenter', stopAuto);\n    root.addEventListener('mouseleave', startAuto);\n\n    viewport.addEventListener('pointerdown', function (e) {\n      if (e.target.closest('button')) return;\n      dragging = true;\n      startX = e.clientX;\n      startTx = gsap.getProperty(track, 'x') || 0;\n      stopAuto();\n      viewport.setPointerCapture(e.pointerId);\n    });\n    viewport.addEventListener('pointermove', function (e) {\n      if (!dragging) return;\n      gsap.set(track, { x: startTx + (e.clientX - startX) });\n    });\n    function endDrag(e) {\n      if (!dragging) return;\n      dragging = false;\n      const dx = e.clientX - startX;\n      if (dx < -40) go(index + 1);\n      else if (dx > 40) go(index - 1);\n      else go(index, 0.35);\n      startAuto();\n    }\n    viewport.addEventListener('pointerup', endDrag);\n    viewport.addEventListener('pointercancel', endDrag);\n\n    window.addEventListener('resize', function () {\n      go(index, 0);\n    });\n\n    metrics();\n    renderPips();\n    gsap.set(track, { x: 0 });\n    startAuto();\n    window.setTimeout(function () {\n      root.classList.remove('is-hint');\n    }, 2200);\n  }\n\n  initRail(document.getElementById('rail-movies'));\n  initRail(document.getElementById('rail-series'));\n})();\n</script>\n",
