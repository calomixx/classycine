      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.31.0/dist/tabler-icons.min.css');\n\n  @layer components {\n    .cc-home { font-family: 'Outfit', sans-serif; }\n    .cc-home .rotary-section {\n      --card-w: clamp(160px, 18vw, 210px);\n      --card-h: clamp(250px, 32vw, 320px);\n      overflow: hidden;\n      display: flex;\n      flex-direction: column;\n      align-items: stretch;\n      gap: 1rem;\n      padding: 0;\n    }\n    .cc-home .rotary-scene {\n      position: relative;\n      width: 100%;\n      height: calc(var(--card-h) + 48px);\n    }\n    .cc-home .rotary-ring { position: absolute; inset: 0; }\n    .cc-home .rotary-card {\n      position: absolute;\n      width: var(--card-w);\n      height: var(--card-h);\n      top: calc(50% - var(--card-h) / 2);\n      left: calc(50% - var(--card-w) / 2);\n      border-radius: 14px;\n      overflow: hidden;\n      cursor: pointer;\n      display: flex;\n      flex-direction: column;\n      background: rgba(255,255,255,0.035);\n      border: 1px solid rgba(255,255,255,0.07);\n      transition: transform 0.65s cubic-bezier(0.25, 0.46, 0.45, 0.94), opacity 0.5s ease;\n    }\n    .cc-home .rotary-card.is-active {\n      cursor: default;\n      pointer-events: none;\n      box-shadow: 0 18px 40px -12px rgba(0,0,0,0.75), 0 0 0 2px #00E5FF, 0 0 28px -6px rgba(0,229,255,0.55);\n    }\n    .cc-home .rotary-card.is-active .card-heart { pointer-events: auto; }\n    .cc-home .rotary-card img {\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      display: block;\n    }\n    .cc-home .rotary-card--info .card-poster {\n      position: relative;\n      flex: 0 0 62%;\n      min-height: 0;\n      overflow: hidden;\n      background: #0f1220;\n    }\n    .cc-home .rotary-card__info {\n      flex: 1;\n      min-height: 0;\n      padding: 10px 12px 12px;\n      display: flex;\n      flex-direction: column;\n      gap: 6px;\n    }\n    .cc-home .rotary-nav {\n      display: flex;\n      justify-content: center;\n      gap: 12px;\n    }\n    .cc-home .rotary-nav button {\n      width: 44px;\n      height: 44px;\n      border-radius: 50%;\n      border: 1px solid rgba(255,255,255,0.18);\n      background: rgba(255,255,255,0.05);\n      color: #f0f4fc;\n      cursor: pointer;\n      font-size: 1.15rem;\n      display: grid;\n      place-items: center;\n    }\n    .cc-home .rotary-nav button:hover {\n      border-color: rgba(0,229,255,0.55);\n      color: #00E5FF;\n      background: rgba(0,229,255,0.08);\n    }\n  }\n</style>\n<div class=\"cc-home m-0 min-h-screen bg-[#080b14] text-[#f0f4fc] antialiased\" data-kid=\"1\" data-name=\"cineclassify home page\">\n    <div class=\"mx-auto w-full max-w-[1210px] min-w-0 px-8 py-8\" data-kid=\"1-1\" data-name=\"content wrapper\">\n        <section class=\"relative mb-8 flex min-h-[280px] items-end overflow-hidden rounded-[20px]\" data-kid=\"1-1-1\" data-name=\"hero section\" style=\"background:linear-gradient(135deg,#1a1b2e,#0f1220)\">\n            <div class=\"pointer-events-none absolute inset-0\" data-kid=\"1-1-1-1\" data-name=\"decorative background gradient\" style=\"background:radial-gradient(ellipse at 20% 50%,rgba(0,229,255,0.12) 0%,transparent 60%),radial-gradient(ellipse at 80% 30%,rgba(176,0,255,0.12) 0%,transparent 60%)\">\n            </div>\n            <div class=\"relative z-10 p-8\" data-kid=\"1-1-1-2\" data-name=\"hero text and actions container\">\n                <h1 class=\"m-0 text-[2rem] font-extrabold leading-tight tracking-tight\" data-kid=\"1-1-1-2-1\" data-name=\"hero title text\">\n                    🎬 Bienvenido a\n                    <span class=\"text-[#00E5FF]\" data-kid=\"1-1-1-2-1-1\" data-name=\"highlighted brand name\" style=\"text-shadow:0 0 20px rgba(0,229,255,0.2)\">\n                        CineClassify\n                    </span>\n                </h1>\n                <p class=\"mt-2 max-w-[500px] text-[15px] leading-relaxed text-[#94a3b8]\" data-kid=\"1-1-1-2-2\" data-name=\"hero description text\">\n                    Clasifica, valora y descubre las mejores películas y series. Construye tu Tier List personal.\n                </p>\n                <div class=\"mt-5 flex flex-wrap gap-2.5\" data-kid=\"1-1-1-2-3\" data-name=\"hero action buttons container\">\n                    <button class=\"inline-flex items-center justify-center rounded-md bg-[#00E5FF] px-5 py-2.5 text-[15px] font-semibold text-[#0b0c10]\" data-kid=\"1-1-1-2-3-1\" data-name=\"explore movies button\" type=\"button\">\n                        Explorar Películas\n                    </button>\n                    <button class=\"inline-flex items-center justify-center gap-2 rounded-md border border-white/[0.07] bg-white/[0.07] px-5 py-2.5 text-[15px] font-semibold text-[#f0f4fc]\" data-kid=\"1-1-1-2-3-2\" data-name=\"my tier list button\" type=\"button\">\n                        <i class=\"ti ti-clipboard-list text-base\" data-kid=\"1-1-1-2-3-2-1\" data-name=\"clipboard list icon\">\n                        </i>\n                        Mi Tier List\n                    </button>\n                </div>\n            </div>\n        </section>\n        <section class=\"rotary-section\" data-kid=\"1-1-2\" data-name=\"top movies section\" id=\"fan-movies\">\n            <div class=\"flex flex-wrap items-center justify-between gap-4\" data-kid=\"1-1-2-1\" data-name=\"section header container\">\n                <h2 class=\"m-0 text-[1.3rem] font-bold\" data-kid=\"1-1-2-1-1\" data-name=\"section title\">\n                    🏆 Top Películas\n                    <span class=\"text-[#00E5FF]\" data-kid=\"1-1-2-1-1-1\" data-name=\"materialized view status text\">\n                        (Vista Materializada)\n                    </span>\n                </h2>\n                <button class=\"rounded-md border border-white/[0.07] bg-white/[0.07] px-3.5 py-1.5 text-[0.82rem] font-semibold text-[#f0f4fc]\" data-kid=\"1-1-2-1-2\" data-name=\"view all button\" type=\"button\">\n                    Ver todo\n                </button>\n            </div>\n            <div class=\"rotary-scene\" data-kid=\"1-1-2-2\" data-name=\"rotary carousel scene\">\n                <div class=\"rotary-ring\" data-kid=\"1-1-2-2-1\" data-name=\"carousel items container\">\n                    <article class=\"rotary-card rotary-card--info\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-1\" data-name=\"movie card\" data-reason=\"transform and opacity controlled by carousel script\" data-title=\"Interstellar\">\n                        <div class=\"card-poster\" data-kid=\"1-1-2-2-1-1-1\" data-name=\"card image container\">\n                            <img alt=\"Interstellar — Earth at night, Zelch Csaba on Pexels\" class=\"h-full w-full object-cover\" data-kid=\"1-1-2-2-1-1-1-1\" data-name=\"movie poster image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/30596256/pexels-photo-30596256.jpeg?auto=compress&cs=tinysrgb&w=500&q=80\"/>\n                            <button class=\"card-heart absolute top-2.5 right-2.5 z-10 grid h-8 w-8 place-items-center rounded-full border border-white/10 bg-[#080b14]/70 text-sm text-[#94a3b8]\" data-kid=\"1-1-2-2-1-1-1-2\" data-name=\"save to list button\" title=\"Guardar en Mi Lista\" type=\"button\">\n                                🤍\n                            </button>\n                        </div>\n                        <div class=\"rotary-card__info\" data-kid=\"1-1-2-2-1-1-2\" data-name=\"card info container\">\n                            <h3 class=\"m-0 truncate text-[0.88rem] font-bold leading-snug\" data-kid=\"1-1-2-2-1-1-2-1\" data-name=\"movie title\">\n                                Interstellar\n                            </h3>\n                            <div class=\"flex items-center justify-between text-[0.75rem]\" data-kid=\"1-1-2-2-1-1-2-2\" data-name=\"movie details row\">\n                                <span class=\"font-semibold text-[#f1fa8c]\" data-kid=\"1-1-2-2-1-1-2-2-1\" data-name=\"movie rating\">\n                                    ⭐ 9.5\n                                </span>\n                                <span class=\"text-[#64748b]\" data-kid=\"1-1-2-2-1-1-2-2-2\" data-name=\"release year\">\n                                    2014\n                                </span>\n                            </div>\n                            <span class=\"inline-flex w-fit items-center gap-1 rounded-md border border-[rgba(80,250,123,0.5)] bg-[rgba(80,250,123,0.2)] px-2 py-0.5 text-[0.72rem] font-bold text-[#50fa7b]\" data-kid=\"1-1-2-2-1-1-2-3\" data-name=\"critic status badge\">\n                                ✓ Criticada\n                            </span>\n                        </div>\n                    </article>\n                    <article class=\"rotary-card rotary-card--info\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-2\" data-name=\"movie card\" data-reason=\"transform and opacity controlled by carousel script\" data-title=\"Inception\">\n                        <div class=\"card-poster\" data-kid=\"1-1-2-2-1-2-1\" data-name=\"card image container\">\n                            <img alt=\"Inception — neon tunnel, Yue WU on Unsplash\" class=\"h-full w-full object-cover\" data-kid=\"1-1-2-2-1-2-1-1\" data-name=\"movie poster image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1714283339889-8130f4b92970?auto=format&w=500&q=80&fit=crop\"/>\n                            <button class=\"card-heart absolute top-2.5 right-2.5 z-10 grid h-8 w-8 place-items-center rounded-full border border-white/10 bg-[#080b14]/70 text-sm text-[#94a3b8]\" data-kid=\"1-1-2-2-1-2-1-2\" data-name=\"save to list button\" title=\"Guardar en Mi Lista\" type=\"button\">\n                                🤍\n                            </button>\n                        </div>\n                        <div class=\"rotary-card__info\" data-kid=\"1-1-2-2-1-2-2\" data-name=\"card info container\">\n                            <h3 class=\"m-0 truncate text-[0.88rem] font-bold leading-snug\" data-kid=\"1-1-2-2-1-2-2-1\" data-name=\"movie title\">\n                                Inception\n                            </h3>\n                            <div class=\"flex items-center justify-between text-[0.75rem]\" data-kid=\"1-1-2-2-1-2-2-2\" data-name=\"movie details row\">\n                                <span class=\"font-semibold text-[#f1fa8c]\" data-kid=\"1-1-2-2-1-2-2-2-1\" data-name=\"movie rating\">\n                                    ⭐ 9.0\n                                </span>\n                                <span class=\"text-[#64748b]\" data-kid=\"1-1-2-2-1-2-2-2-2\" data-name=\"release year\">\n                                    2010\n                                </span>\n                            </div>\n                            <span class=\"inline-flex w-fit items-center gap-1 rounded-md border border-[rgba(80,250,123,0.5)] bg-[rgba(80,250,123,0.2)] px-2 py-0.5 text-[0.72rem] font-bold text-[#50fa7b]\" data-kid=\"1-1-2-2-1-2-2-3\" data-name=\"critic status badge\">\n                                ✓ Criticada\n                            </span>\n                        </div>\n                    </article>\n                    <article class=\"rotary-card rotary-card--info\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-3\" data-name=\"movie card\" data-reason=\"transform and opacity controlled by carousel script\" data-title=\"La Quinta Ola\">\n                        <div class=\"card-poster\" data-kid=\"1-1-2-2-1-3-1\" data-name=\"card image container\">\n                            <img alt=\"La Quinta Ola — book still, Annie Spratt on Unsplash\" class=\"h-full w-full object-cover\" data-kid=\"1-1-2-2-1-3-1-1\" data-name=\"movie poster image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1639814056355-bcb1690bd085?auto=format&w=500&q=80&fit=crop\"/>\n                            <button class=\"card-heart absolute top-2.5 right-2.5 z-10 grid h-8 w-8 place-items-center rounded-full border border-white/10 bg-[#080b14]/70 text-sm text-[#94a3b8]\" data-kid=\"1-1-2-2-1-3-1-2\" data-name=\"save to list button\" title=\"Guardar en Mi Lista\" type=\"button\">\n                                🤍\n                            </button>\n                        </div>\n                        <div class=\"rotary-card__info\" data-kid=\"1-1-2-2-1-3-2\" data-name=\"card info container\">\n                            <h3 class=\"m-0 truncate text-[0.88rem] font-bold leading-snug\" data-kid=\"1-1-2-2-1-3-2-1\" data-name=\"movie title\">\n                                La Quinta Ola\n                            </h3>\n                            <div class=\"flex items-center justify-between text-[0.75rem]\" data-kid=\"1-1-2-2-1-3-2-2\" data-name=\"movie details row\">\n                                <span class=\"font-semibold text-[#f1fa8c]\" data-kid=\"1-1-2-2-1-3-2-2-1\" data-name=\"movie rating\">\n                                    ⭐ 7.5\n                                </span>\n                                <span class=\"text-[#64748b]\" data-kid=\"1-1-2-2-1-3-2-2-2\" data-name=\"release year\">\n                                    2016\n                                </span>\n                            </div>\n                            <span class=\"inline-flex w-fit items-center gap-1 rounded-md border border-[rgba(80,250,123,0.5)] bg-[rgba(80,250,123,0.2)] px-2 py-0.5 text-[0.72rem] font-bold text-[#50fa7b]\" data-kid=\"1-1-2-2-1-3-2-3\" data-name=\"critic status badge\">\n                                ✓ Criticada\n                            </span>\n                        </div>\n                    </article>\n                    <article class=\"rotary-card rotary-card--info\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-4\" data-name=\"movie card\" data-reason=\"transform and opacity controlled by carousel script\" data-title=\"Dune\">\n                        <div class=\"card-poster\" data-kid=\"1-1-2-2-1-4-1\" data-name=\"card image container\">\n                            <img alt=\"Dune — sand dunes, Jeremy Bishop on Unsplash\" class=\"h-full w-full object-cover\" data-kid=\"1-1-2-2-1-4-1-1\" data-name=\"movie poster image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1613451411906-8a16ffd17cc8?auto=format&w=500&q=80&fit=crop\"/>\n                            <button class=\"card-heart absolute top-2.5 right-2.5 z-10 grid h-8 w-8 place-items-center rounded-full border border-white/10 bg-[#080b14]/70 text-sm text-[#94a3b8]\" data-kid=\"1-1-2-2-1-4-1-2\" data-name=\"save to list button\" title=\"Guardar en Mi Lista\" type=\"button\">\n                                🤍\n                            </button>\n                        </div>\n                        <div class=\"rotary-card__info\" data-kid=\"1-1-2-2-1-4-2\" data-name=\"card info container\">\n                            <h3 class=\"m-0 truncate text-[0.88rem] font-bold leading-snug\" data-kid=\"1-1-2-2-1-4-2-1\" data-name=\"movie title\">\n                                Dune\n                            </h3>\n                            <div class=\"flex items-center justify-between text-[0.75rem]\" data-kid=\"1-1-2-2-1-4-2-2\" data-name=\"movie details row\">\n                                <span class=\"font-semibold text-[#f1fa8c]\" data-kid=\"1-1-2-2-1-4-2-2-1\" data-name=\"movie rating\">\n                                    ⭐ 8.6\n                                </span>\n                                <span class=\"text-[#64748b]\" data-kid=\"1-1-2-2-1-4-2-2-2\" data-name=\"release year\">\n                                    2021\n                                </span>\n                            </div>\n                            <span class=\"inline-flex w-fit items-center gap-1 rounded-md border border-[rgba(80,250,123,0.5)] bg-[rgba(80,250,123,0.2)] px-2 py-0.5 text-[0.72rem] font-bold text-[#50fa7b]\" data-kid=\"1-1-2-2-1-4-2-3\" data-name=\"critic status badge\">\n                                ✓ Criticada\n                            </span>\n                        </div>\n                    </article>\n                    <article class=\"rotary-card rotary-card--info\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-5\" data-name=\"movie card\" data-reason=\"transform and opacity controlled by carousel script\" data-title=\"Blade Runner 2049\">\n                        <div class=\"card-poster\" data-kid=\"1-1-2-2-1-5-1\" data-name=\"card image container\">\n                            <img alt=\"Blade Runner 2049 — rainy neon street, Valentin BEAUVAIS on Unsplash\" class=\"h-full w-full object-cover\" data-kid=\"1-1-2-2-1-5-1-1\" data-name=\"movie poster image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1601042879364-f3947d3f9c16?auto=format&w=500&q=80&fit=crop\"/>\n                            <button class=\"card-heart absolute top-2.5 right-2.5 z-10 grid h-8 w-8 place-items-center rounded-full border border-white/10 bg-[#080b14]/70 text-sm text-[#94a3b8]\" data-kid=\"1-1-2-2-1-5-1-2\" data-name=\"save to list button\" title=\"Guardar en Mi Lista\" type=\"button\">\n                                🤍\n                            </button>\n                        </div>\n                        <div class=\"rotary-card__info\" data-kid=\"1-1-2-2-1-5-2\" data-name=\"card info container\">\n                            <h3 class=\"m-0 truncate text-[0.88rem] font-bold leading-snug\" data-kid=\"1-1-2-2-1-5-2-1\" data-name=\"movie title\">\n                                Blade Runner 2049\n                            </h3>\n                            <div class=\"flex items-center justify-between text-[0.75rem]\" data-kid=\"1-1-2-2-1-5-2-2\" data-name=\"movie details row\">\n                         