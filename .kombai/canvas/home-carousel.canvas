      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  @keyframes cc-marquee-left {\n    from { transform: translate3d(0, 0, 0); }\n    to { transform: translate3d(-50%, 0, 0); }\n  }\n  @keyframes cc-marquee-right {\n    from { transform: translate3d(-50%, 0, 0); }\n    to { transform: translate3d(0, 0, 0); }\n  }\n  @keyframes cc-sheen {\n    from { transform: translateX(-140%) skewX(-22deg); }\n    to { transform: translateX(240%) skewX(-22deg); }\n  }\n\n  .cc-home { font-family: 'Outfit', sans-serif; }\n  .cc-rail { -webkit-mask-image: linear-gradient(to right, transparent 0, #000 72px, #000 calc(100% - 72px), transparent 100%); mask-image: linear-gradient(to right, transparent 0, #000 72px, #000 calc(100% - 72px), transparent 100%); }\n  .cc-track { display: flex; width: max-content; will-change: transform; }\n  .cc-track-left { animation: cc-marquee-left 38s linear infinite; }\n  .cc-track-right { animation: cc-marquee-right 32s linear infinite; }\n  .cc-rail:hover .cc-track { animation-play-state: paused; }\n  .cc-card { width: 168px; }\n  .cc-card .cc-poster img { transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1), filter 0.35s ease; }\n  .cc-card { transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s ease; }\n  .cc-card:hover { transform: scale(1.08); z-index: 20; box-shadow: 0 0 0 1.5px #00E5FF, 0 18px 40px -12px rgba(0, 229, 255, 0.45); }\n  .cc-card:hover .cc-poster img { transform: scale(1.07); filter: saturate(1.2) contrast(1.05); }\n  .cc-sheen { pointer-events: none; position: absolute; inset: 0; background: linear-gradient(105deg, transparent 35%, rgba(0, 229, 255, 0.28) 50%, transparent 65%); opacity: 0; }\n  .cc-card:hover .cc-sheen { opacity: 1; animation: cc-sheen 0.85s ease; }\n</style>\n<div class=\"cc-home m-0 min-h-screen bg-[#080b14] px-6 py-6 text-[#f0f4fc] antialiased\" data-kid=\"1\" data-name=\"cineclassify landing page\">\n    <section class=\"relative min-h-[280px] overflow-hidden rounded-[20px] bg-gradient-to-br from-[#1a1b2e] to-[#0f1220]\" data-kid=\"1-1\" data-name=\"hero section\">\n        <div class=\"pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_18%_50%,rgba(0,229,255,0.12),transparent_58%),radial-gradient(ellipse_at_82%_28%,rgba(176,0,255,0.14),transparent_56%)]\" data-kid=\"1-1-1\" data-name=\"decorative radial gradients\">\n        </div>\n        <div class=\"relative z-10 max-w-[800px] px-8 py-10\" data-kid=\"1-1-2\" data-name=\"hero content container\">\n            <h1 class=\"m-0 text-[2rem] font-extrabold leading-tight tracking-tight\" data-kid=\"1-1-2-1\" data-name=\"hero headline text\">\n                🎬 Bienvenido a\n                <span class=\"text-[#00E5FF] [text-shadow:0_0_20px_rgba(0,229,255,0.2)]\" data-kid=\"1-1-2-1-1\" data-name=\"hero brand name\">\n                    CineClassify\n                </span>\n            </h1>\n            <p class=\"mt-2 max-w-[500px] text-[15px] leading-relaxed text-[#94a3b8]\" data-kid=\"1-1-2-2\" data-name=\"hero description text\">\n                Clasifica, valora y descubre las mejores películas y series. Construye tu Tier List personal.\n            </p>\n            <div class=\"mt-5 flex flex-wrap gap-2.5\" data-kid=\"1-1-2-3\" data-name=\"hero actions container\">\n                <button class=\"inline-flex items-center rounded-[6px] bg-[#00E5FF] px-5 py-2.5 text-[15px] font-semibold text-[#0b0c10]\" data-kid=\"1-1-2-3-1\" data-name=\"explore movies button\">\n                    Explorar Películas\n                </button>\n                <button class=\"inline-flex items-center gap-2 rounded-[6px] border border-white/10 bg-white/[0.07] px-5 py-2.5 text-[15px] font-semibold text-[#f0f4fc]\" data-kid=\"1-1-2-3-2\" data-name=\"my tier list button\">\n                    <span class=\"text-sm\" data-kid=\"1-1-2-3-2-1\" data-name=\"clipboard icon\">\n                        📋\n                    </span>\n                    Mi Tier List\n                </button>\n            </div>\n        </div>\n    </section>\n    <div class=\"mt-8 flex items-end justify-between gap-4\" data-kid=\"1-2\" data-name=\"movies section header\">\n        <h2 class=\"m-0 text-[1.3rem] font-bold\" data-kid=\"1-2-1\" data-name=\"movies section title\">\n            🏆 Top Películas\n            <span class=\"text-[#00E5FF]\" data-kid=\"1-2-1-1\" data-name=\"movies section subtitle\">\n                (Vista Materializada)\n            </span>\n        </h2>\n        <button class=\"rounded-[6px] border border-white/[0.07] bg-white/[0.07] px-3.5 py-1.5 text-[13px] font-semibold text-[#f0f4fc]\" data-kid=\"1-2-2\" data-name=\"view all movies button\">\n            Ver todo\n        </button>\n    </div>\n    <div class=\"cc-rail relative mt-5 overflow-hidden py-5\" data-kid=\"1-3\" data-name=\"movies carousel rail\">\n        <div class=\"pointer-events-none absolute inset-y-0 left-0 z-10 w-20 bg-gradient-to-r from-[#080b14] to-transparent\" data-kid=\"1-3-1\" data-name=\"movies carousel left mask\">\n        </div>\n        <div class=\"pointer-events-none absolute inset-y-0 right-0 z-10 w-20 bg-gradient-to-l from-[#080b14] to-transparent\" data-kid=\"1-3-2\" data-name=\"movies carousel right mask\">\n        </div>\n        <div class=\"cc-track cc-track-left\" data-dynamic=\"true\" data-kid=\"1-3-3\" data-name=\"movies track left\" data-reason=\"marquee animation infinite\">\n            <div class=\"flex shrink-0 gap-5 pr-5\" data-kid=\"1-3-3-1\" data-name=\"movies track original group\">\n                <article class=\"cc-card relative shrink-0 overflow-hidden rounded-[12px] border border-white/[0.07] bg-white/[0.035]\" data-kid=\"1-3-3-1-1\" data-name=\"movie card\">\n                    <div class=\"cc-poster relative aspect-[2/3] overflow-hidden bg-[#0f1220]\" data-kid=\"1