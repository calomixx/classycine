      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap');\n\n  .cc-home {\n    font-family: 'Outfit', sans-serif;\n  }\n  .cc-mono {\n    font-family: 'Space Grotesk', sans-serif;\n  }\n  .rail-nav {\n    opacity: 0;\n    pointer-events: none;\n  }\n  .rail-section.is-hint .rail-nav,\n  .rail-section:hover .rail-nav,\n  .rail-section:focus-within .rail-nav {\n    opacity: 1;\n    pointer-events: auto;\n  }\n  .rail-track {\n    will-change: transform;\n  }\n  .rail-card {\n    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.28s ease;\n  }\n  .rail-card:hover {\n    transform: translateY(-6px);\n    box-shadow: 0 0 0 1px rgba(0, 229, 255, 0.55), 0 16px 32px rgba(0, 0, 0, 0.45);\n    z-index: 2;\n  }\n  .rail-pip {\n    width: 7px;\n    height: 7px;\n    border-radius: 999px;\n    background: rgba(255, 255, 255, 0.18);\n  }\n  .rail-pip.is-active {\n    width: 18px;\n    background: #00E5FF;\n    box-shadow: 0 0 10px rgba(0, 229, 255, 0.55);\n  }\n</style>\n<link data-kid=\"1\" data-name=\"Tabler Icons stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"cc-home m-0 min-h-screen bg-[#080b14] px-8 py-8 text-[#f0f4fc]\" data-kid=\"2\" data-name=\"home page layout container\">\n    <div class=\"mx-auto w-full max-w-[1100px]\" data-kid=\"2-1\" data-name=\"main content wrapper\">\n        <section class=\"relative min-h-[260px] overflow-hidden rounded-2xl\" data-kid=\"2-1-1\" data-name=\"hero section container\" style=\"background:linear-gradient(135deg,#1a1b2e 0%,#0f1220 100%)\">\n            <div class=\"pointer-events-none absolute -right-16 top-[-40px] h-[280px] w-[380px] rounded-full bg-[#B000FF]/20 blur-[90px]\" data-kid=\"2-1-1-1\" data-name=\"decorative blurred background orb 1\">\n            </div>\n            <div class=\"pointer-events-none absolute left-10 bottom-[-60px] h-[200px] w-[240px] rounded-full bg-[#00E5FF]/10 blur-[80px]\" data-kid=\"2-1-1-2\" data-name=\"decorative blurred background orb 2\">\n            </div>\n            <div class=\"relative z-10 max-w-[560px] p-8\" data-kid=\"2-1-1-3\" data-name=\"hero content container\">\n                <h1 class=\"text-[2rem] font-extrabold leading-tight tracking-tight\" data-kid=\"2-1-1-3-1\" data-name=\"hero headline text\">\n                    🎬 Bienvenido a\n                    <span class=\"text-[#00E5FF]\" data-kid=\"2-1-1-3-1-1\" data-name=\"brand name span\" style=\"text-shadow:0 0 18px rgba(0,229,255,.55)\">\n                        CineClassify\n                    </span>\n                </h1>\n                <p class=\"mt-3 max-w-[460px] text-[0.95rem] leading-relaxed text-[#94a3b8]\" data-kid=\"2-1-1-3-2\" data-name=\"hero description text\">\n                    Clasifica, valora y descubre las mejores películas y series. Construye tu Tier List personal.\n                </p>\n                <div class=\"mt-5 flex flex-wrap items-center gap-2.5\" data-kid=\"2-1-1-3-3\" data-name=\"hero action buttons container\">\n                    <button class=\"cc-mono rounded-md bg-[#00E5FF] px-5 py-2.5 text-[0.9rem] font-bold text-[#05070A]\" data-kid=\"2-1-1-3-3-1\" data-name=\"explore movies button\" type=\"button\">\n                        Explorar Películas\n                    </button>\n                    <button class=\"cc-mono inline-flex items-center gap-2 rounded-md border border-white/15 bg-white/[0.07] px-4 py-2.5 text-[0.9rem] font-semibold text-white\" data-kid=\"2-1-1-3-3-2\" data-name=\"my tier list button\" type=\"button\">\n                        <span class=\"text-sm\" data-kid=\"2-1-1-3-3-2-1\" data-name=\"tier list icon span\">\n                            📋\n                        </span>\n                        Mi Tier List\n                    </button>\n                </div>\n            </div>\n        </section>\n        <section class=\"rail-section is-hint mt-8\" data-kid=\"2-1-2\" data-name=\"movies rail section\" id=\"rail-movies\">\n            <div class=\"mb-4 flex items-center justify-between gap-4\" data-kid=\"2-1-2-1\" data-name=\"movies section header\">\n                <h2 class=\"text-[1.3rem] font-bold\" data-kid=\"2-1-2-1-1\" data-name=\"movies section title\">\n                    🏆 Top Películas\n                    <span class=\"text-[#00E5FF]/80\" data-kid=\"2-1-2-1-1-1\" data-name=\"materialized view subtitle\">\n                        (Vista Materializada)\n                    </span>\n                </h2>\n                <button class=\"cc-mono rounded-md border border-white/10 bg-white/[0.06] px-3 py-1.5 text-[0.82rem] font-semibold text-[#f0f4fc]\" data-kid=\"2-1-2-1-2\" data-name=\"view all movies button\" type=\"button\">\n                    Ver todo\n                </button>\n            </div>\n            <div class=\"rail-viewport relative overflow-hidden\" data-kid=\"2-1-2-2\" data-name=\"movies carousel viewport\">\n                <div class=\"pointer-events-none absolute inset-y-0 left-0 z-10 w-14 bg-gradient-to-r from-[#080b14] to-transparent\" data-kid=\"2-1-2-2-1\" data-name=\"carousel left gradient mask\">\n                </div>\n                <div class=\"pointer-events-none absolute inset-y-0 right-0 z-10 w-16 bg-gradient-to-l from-[#080b14] to-transparent\" data-kid=\"2-1-2-2-2\" data-name=\"carousel right gradient mask\">\n                </div>\n                <button aria-label=\"Anterior\" class=\"rail-nav rail-prev absolute left-2 top-[38%] z-20 grid h-11 w-11 -translate-y-1/2 place-items-center rounded-full border border-white/15 bg-[#0a0d16]/80 text-lg text-white backdrop-blur-md hover:border-[#00E5FF]/50 hover:shadow-[0_0_18px_rgba(0,229,255,0.35)]\" data-kid=\"2-1-2-2-3\" data-name=\"previous movie slide button\" type=\"button\">\n                    <i class=\"ti ti-chevron-left\" data-kid=\"2-1-2-2-3-1\" data-name=\"previous chevron icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Siguiente\" class=\"rail-nav rail-next absolute right-2 top-[38%] z-20 grid h-11 w-11 -translate-y-1/2 place-items-center rounded-full border border-white/15 bg-[#0a0d16]/80 text-lg text-white backdrop-blur-md hover:border-[#00E5FF]/50 hover:shadow-[0_0_18px_rgba(0,229,255,0.35)]\" data-kid=\"2-1-2-2-4\" data-name=\"next movie slide button\" type=\"button\">\n                    <i class=\"ti ti-chevron-right\" data-kid=\"2-1-2-2-4-1\" data-name=\"next chevron icon\">\n                    </i>\n                </button>\n                <div class=\"rail-track flex gap-3.5\" data-dynamic=\"true\" data-kid=\"2-1-2-2-5\" data-name=\"movies carousel track\" data-reason=\"carousel track x-position updated by GSAP\">\n                    <article class=\"rail-card w-[168px] shrink-0 overflow-hidden rounded-xl border border-white/[0.07] bg-white/[0.035]\" data-kid=\"2-1-2-2-5-1\">\n                        <div class=\"relative aspect-[2/3] overflow-hidden bg-[#0f1220]\" data-kid=\"2-1-2-2-5-1-1\">\n                            <img alt=\"Interstellar — Zelch Csaba on Pexels\" class=\"h-full w-full object-cover\" data-kid=\"2-1-2-2-5-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/30596256/pexels-photo-30596256.jpeg?auto=compress&cs=tinysrgb&w=500&q=80\"/>\n                            <button aria-label=\"Guardar Interstellar\" class=\"absolute right-2 top-2 grid h-8 w-8 place-items-center rounded-full border border-white/10 bg-[#080b14]/70 text-sm text-[#94a3b8] backdrop-blur-md\" data-kid=\"2-1-2-2-5-1-1-2\" title=\"Guardar en Mi Lista\" type=\"button\">\n                                🤍\n                            </button>\n                            <div class=\"absolute left-2 top-2 rounded-md bg-black/70 px-1.5 py-0.5 text-[0.72rem] font-bold text-[#f1fa8c]\" data-kid=\"2-1-2-2-5-1-1-3\">\n                                ⭐ 9.5\n                            </div>\n                        </div>\n                        <div class=\"px-3 pb-3 pt-2.5\" data-kid=\"2-1-2-2-5-1-2\">\n                            <h3 class=\"truncate text-[0.88rem] font-bold leading-tight\" data-kid=\"2-1-2-2-5-1-2-1\">\n                                Interstellar\n                            </h3>\n                            <div class=\"mt-1 flex items-center justify-between\" data-kid=\"2-1-2-2-5-1-2-2\">\n                                <span class=\"text-[0.8rem] font-semibold text-[#f1fa8c]\" data-kid=\"2-1-2-2-5-1-2-2-1\">\n                                    ⭐ 9.5\n                                </span>\n                                <span class=\"text-[0.75rem] text-[#64748b]\" data-kid=\"2-1-2-2-5-1-2-2-2\">\n                                    2014\n                                </span>\n                            </div>\n                            <div class=\"mt-2 flex items-center gap-1\" data-kid=\"2-1-2-2-5-1-2-3\">\n                                <span class=\"inline-flex items-center gap-1 rounded-md border border-[rgba(80,250,123,0.5)] bg-[rgba(80,250,123,0.2)] px-2 py-0.5 text-[0.72rem] font-bold text-[#50fa7b]\" data-kid=\"2-1-2-2-5-1-2-3-1\">\n                                    ✓ Criticada\n                                </span>\n                                <i class=\"ti ti-chevron-down text-xs text-[#64748b]\" data-kid=\"2-1-2-2-5-1-2-3-2\">\n                                </i>\n                            </div>\n                        </div>\n                    </article>\n                    <article class=\"rail-card w-[168px] shrink-0 overflow-hidden rounded-xl border border-white/[0.07] bg-white/[0.035]\" data-kid=\"2-1-2-2-5-2\">\n                        <div class=\"relative aspect-[2/3] overflow-hidden bg-[#0f1220]\" data-kid=\"2-1-2-2-5-2-1\">\n                            <img alt=\"Inception — Yue WU on Unsplash\" class=\"h-full w-full object-cover\" data-kid=\"2-1-2-2-5-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1714283339889-8130f4b92970?auto=format&w=500&q=80&fit=crop\"/>\n                            <button aria-label=\"Guardar Inception\" class=\"absolute right-2 top-2 grid h-8 w-8 place-items-center rounded-full border border-white/10 bg-[#080b14]/70 text-sm text-[#94a3b8] backdrop-blur-md\" data-kid=\"2-1-2-2-5-2-1-2\" title=\"Guardar en Mi Lista\" type=\"button\">\n                                🤍\n                            </button>\n                            <div class=\"absolute left-2 top-2 rounded-md bg-black/70 px-1.5 py-0.5 text-[0.72rem] font-bold text-[#f1fa8c]\" data-kid=\"2-1-2-2-5-2-1-3\">\n                                ⭐ 9.0\n                            </div>\n                        </div>\n                        <div class=\"px-3 pb-3 pt-2.5\" data-kid=\"2-1-2-2-5-2-2\">\n                            <h3 class=\"truncate text-[0.88rem] font-bold leading-tight\" data-kid=\"2-1-2-2-5-2-2-1\">\n                                Inception\n                            </h3>\n                            <div class=\"mt-1 flex items-center justify-between\" data-kid=\"2-1-2-2-5-2-2-2\">\n                                <span class=\"text-[0.8rem] font-semibold text-[#f1fa8c]\" data-kid=\"2-1-2-2-5-2-2-2-1\">\n                                    ⭐ 9.0\n                                </span>\n                                <span class=\"text-[0.75rem] text-[#64748b]\" data-kid=\"2-1-2-2-5-2-2-2-2\">\n                                    2010\n                                </span>\n                            </div>\n                            <div class=\"mt-2 flex items-center gap-1\" data-kid=\"2-1-2-2-5-2-2-3\">\n                                <span class=\"inline-flex items-center gap-1 rounded-md border border-[rgba(80,250,123,0.5)] bg-[rgba(80,250,123,0.2)] px-2 py-0.5 text-[0.72rem] font-bold text-[#50fa7b]\" data-kid=\"2-1-2-2-5-2-2-3-1\">\n                                    ✓ Criticada\n                                </span>\n                                <i class=\"ti ti-chevron-down text-xs text-[#64748b]\" data-kid=\"2-1-2-2-5-2-2-3-2\">\n                                </i>\n                            </div>\n                        </div>\n                    </article>\n                    <article class=\"rail-card w-[168px] shrink-0 overflow-hidden rounded-xl border border-white/[0.07] bg-white/[0.035]\" data-kid=\"2-1-2-2-5-3\">\n                        <div class=\"relative aspect-[2/3] overflow-hidden bg-[#0f1220]\" data-kid=\"2-1-2-2-5-3-1\">\n                            <img alt=\"La Quinta Ola — Annie Spratt on Unsplash\" class=\"h-full w-full object-cover\" data-kid=\"2-1-2-2-5-3-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1639814056355-bcb1690bd085?auto=format&w=500&q=80&fit=crop\"/>\n                            <button aria-label=\"Guardar La Quinta Ola\" class=\"absolute right-2 top-2 grid h-8 w-8 place-items-center rounded-full border border-white/10 bg-[#080b14]/70 text-sm text-[#94a3b8] backdrop-blur-md\" data-kid=\"2-1-2-2-5-3-1-2\" title=\"Guardar en Mi Lista\" type=\"button\">\n                                🤍\n                            </button>\n                            <div class=\"absolute left-2 top-2 rounded-md bg-black/70 px-1.5 py-0.5 text-[0.72rem] font-bold text-[#f1fa8c]\" data-kid=\"2-1-2-2-5-3-1-3\">\n                                ⭐ 7.5\n                            </div>\n                        </div>\n                        <div class=\"px-3 pb-3 pt-2.5\" data-kid=\"2-1-2-2-5-3-2\">\n                            <h3 class=\"truncate text-[0.88rem] font-bold leading-tight\" data-kid=\"2-1-2-2-5-3-2-1\">\n                                La Quinta Ola\n                            </h3>\n                            <div class=\"mt-1 flex items-center justify-between\" data-kid=\"2-1-2-2-5-3-2-2\">\n                                <span class=\"text-[0.8rem] font-semibold text-[#f1fa8c]\" data-kid=\"2-1-2-2-5-3-2-2-1\">\n                                    ⭐ 7.5\n                                </span>\n                                <span class=\"text-[0.75rem] text-[#64748b]\" data-kid=\"2-1-2-2-5-3-2-2-2\">\n                                    2016\n                                </span>\n                            </div>\n                            <div class=\"mt-2 flex items-center gap-1\" data-kid=\"2-1-2-2-5-3-2-3\">\n                                <span class=\"inline-flex items-center gap-1 rounded-md border border-[rgba(80,250,123,0.5)] bg-[rgba(80,250,123,0.2)] px-2 py-0.5 text-[0.72rem] font-bold text-[#50fa7b]\" data-kid=\"2-1-2-2-5-3-2-3-1\">\n                                    ✓ Criticada\n                                </span>\n                                <i class=\"ti ti-chevron-down text-xs text-[#64748b]\" data-kid=\"2-1-2-2-5-3-2-3-2\">\n                                </i>\n                            </div>\n                        </div>\n                    </article>\n                    <article class=\"rail-card w-[168px] shrink-0 overflow-hidden rounded-xl border border-white/[0.07] bg-white/[0.035]\" data-kid=\"2-1-2-2-5-4\">\n                        <div class=\"relative aspect-[2/3] overflow-hidden bg-[#0f1220]\" data-kid=\"2-1-2-2-5-4-1\">\n                            <img alt=\"Dune — Jeremy Bishop on Unsplash\" class=\"h-full w-full object-cover\" data-kid=\"2-1-2-2-5-4-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1613451411906-8a16ffd17cc8?auto=format&w=500&q=80&fit=crop\"/>\n                            <button aria-label=\"Guardar Dune\" class=\"absolute right-2 top-2 grid h-8 w-8 place-items-center rounded-full border border-white/10 bg-[#080b14]/70 text-sm text-[#94a3b8] backdrop-blur-md\" data-kid=\"2-1-2-2-5-4-1-2\" title=\"Guardar en Mi Lista\" type=\"button\">\n                                🤍\n                            </button>\n                            <div class=\"absolute left-2 top-2 rounded-md bg-black/70 px-1.5 py-0.5 text-[0.72rem] font-bold text-[#f1fa8c]\" data-kid=\"2-1-2-2-5-4-1-3\">\n                                ⭐ 8.6\n                            </div>\n                        </div>\n                        <div class=\"px-3 pb-3 pt-2.5\" data-kid=\"2-1-2-2-5-4-2\">\n                            <h3 class=\"truncate text-[0.88rem] font-bold leading-tight\" data-kid=\"2-1-2-2-5-4-2-1\">\n                                Dune\n                            </h3>\n                            <div class=\"mt-1 flex items-center justify-between\" data-kid=\"2-1-2-2-5-4-2-2\">\n                                <span class=\"text-[0.8rem] font-semibold text-[#f1fa8c]\" data-kid=\"2-1-2-2-5-4-2-2-1\">\n                                    ⭐ 8.6\n                                </span>\n                                <span class=\"text-[0.75rem] text-[#64748b]\" data-kid=\"2-1-2-2-5-4-2-2-2\">\n                                    2021\n                                </span>\n                            </div>\n                            <div class=\"mt-2 flex items-center gap-1\" data-kid=\"2-1-2-2-5-4-2-3\">\n                                <span class=\"inline-flex items-center gap-1 rounded-md border border-[rgba(80,250,123,0.5)] bg-[rgba(80,250,123,0.2)] px-2 py-0.5 text-[0.72rem] font-bold text-[#50fa7b]\" data-kid=\"2-1-2-2-5-4-2-3-1\">\n                                    ✓ Criticada\n                                </span>\n                                <i class=\"ti ti-chevron-down text-xs text-[#64748b]\" data-kid=\"2-1-2-2-5-4-2-3-2\">\n                                </i>\n                            </div>\n                        </div>\n                    </article>\n                    <article class=\"rail-card w-[168px] shrink-0 overflow-hidden rounded-xl border border-white/[0.07] bg-white/[0.035]\" data-kid=\"2-