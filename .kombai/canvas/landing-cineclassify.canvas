lt=\"Recorte de silueta dramática, Isabella Mendes on Pexels\" class=\"h-full w-full border-b border-r border-white/25 object-cover grayscale contrast-125 hover:grayscale-0\" data-kid=\"1-7-2-11\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7173776/pexels-photo-7173776.jpeg?auto=compress&cs=tinysrgb&w=300&q=70\"/>\n            <img alt=\"Recorte de cielo nublado en gris, Sofía Sánchez on Unsplash\" class=\"h-full w-full border-b border-white/25 object-cover grayscale contrast-125 hover:grayscale-0\" data-kid=\"1-7-2-12\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1558584402-61820fd81dec?auto=format&fit=crop&w=300&q=70\"/>\n            <img alt=\"Recorte en blanco y negro, Connor Scott McManus on Pexels\" class=\"h-full w-full border-r border-white/25 object-cover grayscale contrast-125 hover:grayscale-0\" data-kid=\"1-7-2-13\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/12182970/pexels-photo-12182970.jpeg?auto=compress&cs=tinysrgb&w=300&q=70\"/>\n            <img alt=\"Recorte monocromo de rostro, Richard Jaimes on Unsplash\" class=\"h-full w-full border-r border-white/25 object-cover grayscale contrast-125 hover:grayscale-0\" data-kid=\"1-7-2-14\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1518611540400-6b85a0704342?auto=format&fit=crop&w=300&q=70\"/>\n            <img alt=\"Recorte impactante en blanco y negro, Anya Juárez Tenorio on Pexels\" class=\"h-full w-full border-r border-white/25 object-cover grayscale contrast-125 hover:grayscale-0\" data-kid=\"1-7-2-15\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/30552612/pexels-photo-30552612.jpeg?auto=compress&cs=tinysrgb&w=300&q=70\"/>\n            <div class=\"flex items-center justify-center bg-[#E63946] p-3 text-center\" data-kid=\"1-7-2-16\">\n                <span class=\"f-sans text-[10px] font-extrabold uppercase leading-[1.7] tracking-[0.2em] text-white\" data-kid=\"1-7-2-16-1\">\n                    + 89.000\n                    <br data-kid=\"1-7-2-16-1-1\"/>\n                    títulos\n                </span>\n            </div>\n        </div>\n    </section>\n    <!-- ============ NUMBERS TABLE ============ -->\n    <section class=\"grid grid-cols-2 border-b-2 border-white lg:grid-cols-4\" data-kid=\"1-8\">\n        <div class=\"cc-rev border-b border-r border-white/25 px-6 py-14 text-center lg:border-b-0\" data-kid=\"1-8-1\">\n            <p class=\"f-serif text-[12vw] font-black leading-[0.8] lg:text-[5vw]\" data-kid=\"1-8-1-1\">\n                <span class=\"cc-num\" data-dynamic=\"true\" data-kid=\"1-8-1-1-1\" data-name=\"total titles counter\" data-reason=\"number text counted up from 0 by script\" data-suffix=\"\" data-to=\"89000\">\n                    0\n                </span>\n            </p>\n            <p class=\"mt-4 f-sans text-[9px] uppercase tracking-[0.36em] text-[#8D99AE]\" data-kid=\"1-8-1-2\">\n                Títulos\n            </p>\n        </div>\n        <div class=\"cc-rev border-b border-white/25 px-6 py-14 text-center lg:border-b-0 lg:border-r\" data-kid=\"1-8-2\">\n            <p class=\"f-serif text-[12vw] font-black leading-[0.8] lg:text-[5vw]\" data-kid=\"1-8-2-1\">\n                <span class=\"cc-num\" data-dynamic=\"true\" data-kid=\"1-8-2-1-1\" data-name=\"total users counter\" data-reason=\"number text counted up from 0 by script\" data-to=\"12400\">\n                    0\n                </span>\n            </p>\n            <p class=\"mt-4 f-sans text-[9px] uppercase tracking-[0.36em] text-[#8D99AE]\" data-kid=\"1-8-2-2\">\n                Usuarios\n            </p>\n        </div>\n        <div class=\"cc-rev border-r border-white/25 px-6 py-14 text-center\" data-kid=\"1-8-3\">\n            <p class=\"f-serif text-[12vw] font-black leading-[0.8] text-[#E63946] lg:text-[5vw]\" data-kid=\"1-8-3-1\">\n                <span class=\"cc-num\" data-dynamic=\"true\" data-kid=\"1-8-3-1-1\" data-name=\"total ratings counter\" data-reason=\"number text counted up from 0 by script\" data-to=\"340000\">\n                    0\n                </span>\n            </p>\n            <p class=\"mt-4 f-sans text-[9px] uppercase tracking-[0.36em] text-[#8D99AE]\" data-kid=\"1-8-3-2\">\n                Calificaciones\n            </p>\n        </div>\n        <div class=\"cc-rev px-6 py-14 text-center\" data-kid=\"1-8-4\">\n            <p class=\"f-serif text-[12vw] font-black leading-[0.8] lg:text-[5vw]\" data-kid=\"1-8-4-1\">\n                4,8\n            </p>\n            <p class=\"mt-4 f-sans text-[9px] uppercase tracking-[0.36em] text-[#8D99AE]\" data-kid=\"1-8-4-2\">\n                Media global\n            </p>\n        </div>\n    </section>\n    <!-- ============ TESTIMONIOS ============ -->\n    <section class=\"border-b-2 border-white px-6 py-16 sm:px-10 lg:px-14\" data-kid=\"1-9\">\n        <p class=\"f-sans text-[10px] uppercase tracking-[0.42em] text-[#E63946]\" data-kid=\"1-9-1\">\n            Sección 05 — Comunidad\n        </p>\n        <p class=\"cc-rev mt-10 max-w-[62ch] f-serif text-2xl leading-[1.5] sm:text-3xl lg:text-[2.6vw] lg:leading-[1.4]\" data-kid=\"1-9-2\">\n            “Dejé de anotar en el móvil.”\n            <span class=\"text-[#E63946]\" data-kid=\"1-9-2-1\">\n                /\n            </span>\n            “La tier list me hizo discutir tres horas con mi hermano.”\n            <span class=\"text-[#E63946]\" data-kid=\"1-9-2-2\">\n                /\n            </span>\n            “Es el único sitio donde mi nota de 3 a un blockbuster no me cuesta insultos.”\n            <span class=\"text-[#E63946]\" data-kid=\"1-9-2-3\">\n                /\n            </span>\n            “Llevo 412 títulos calificados y no pienso parar.”\n            <span class=\"text-[#E63946]\" data-kid=\"1-9-2-4\">\n                /\n            </span>\n            “Por fin un ranking que no está comprado.”\n        </p>\n        <div class=\"mt-14 grid grid-cols-1 border-t-2 border-white md:grid-cols-3\" data-kid=\"1-9-3\">\n            <figure class=\"cc-rev border-b border-white/25 px-0 py-10 md:border-b-0 md:border-r md:pr-10\" data-kid=\"1-9-3-1\">\n                <blockquote class=\"f-serif text-xl italic leading-[1.55]\" data-kid=\"1-9-3-1-1\">\n                    “Cada nota que dejo cambia el ranking. Se siente responsabilidad.”\n                </blockquote>\n                <figcaption class=\"mt-6 f-sans text-[9px] uppercase tracking-[0.34em] text-[#8D99AE]\" data-kid=\"1-9-3-1-2\">\n                    Marina O. — 312 títulos\n                </figcaption>\n            </figure>\n            <figure class=\"cc-rev border-b border-white/25 px-0 py-10 md:border-b-0 md:border-r md:px-10\" data-kid=\"1-9-3-2\">\n                <blockquote class=\"f-serif text-xl italic leading-[1.55]\" data-kid=\"1-9-3-2-1\">\n                    “La sección de debate es lo más parecido a un cineclub real.”\n                </blockquote>\n                <figcaption class=\"mt-6 f-sans text-[9px] uppercase tracking-[0.34em] text-[#8D99AE]\" data-kid=\"1-9-3-2-2\">\n                    Diego R. — 1.204 reseñas\n                </figcaption>\n            </figure>\n            <figure class=\"cc-rev px-0 py-10 md:pl-10\" data-kid=\"1-9-3-3\">\n                <blockquote class=\"f-serif text-xl italic leading-[1.55]\" data-kid=\"1-9-3-3-1\">\n                    “Me registré para calificar una peli. Llevo dos años aquí.”\n                </blockquote>\n                <figcaption class=\"mt-6 f-sans text-[9px] uppercase tracking-[0.34em] text-[#8D99AE]\" data-kid=\"1-9-3-3-2\">\n                    Lucía V. — Tier list nivel S\n                </figcaption>\n            </figure>\n        </div>\n    </section>\n    <!-- ============ FAQ ============ -->\n    <section class=\"border-b-2 border-white px-6 py-16 sm:px-10 lg:px-14\" data-kid=\"1-10\">\n        <div class=\"flex flex-wrap items-end justify-between gap-6\" data-kid=\"1-10-1\">\n            <p class=\"f-sans text-[10px] uppercase tracking-[0.42em] text-[#E63946]\" data-kid=\"1-10-1-1\">\n                Sección 06 — Preguntas\n            </p>\n            <p class=\"f-sans text-[10px] uppercase tracking-[0.3em] text-[#8D99AE]\" data-kid=\"1-10-1-2\">\n                05 respuestas\n            </p>\n        </div>\n        <div class=\"mt-10 border-t-2 border-white\" data-kid=\"1-10-2\" id=\"cc-faq-list\">\n            <div class=\"cc-faq is-open border-b-2 border-white\" data-kid=\"1-10-2-1\">\n                <button class=\"flex w-full items-center justify-between gap-6 py-8 text-left\" data-kid=\"1-10-2-1-1\">\n                    <span class=\"cc-faq-q f-serif text-2xl font-bold leading-tight sm:text-3xl\" data-kid=\"1-10-2-1-1-1\">\n                        ¿Es gratis?\n                    </span>\n                    <span class=\"cc-faq-ico f-sans shrink-0 text-3xl leading-none\" data-kid=\"1-10-2-1-1-2\">\n                        −\n                    </span>\n                </button>\n                <div class=\"cc-faq-body\" data-kid=\"1-10-2-1-2\">\n                    <div class=\"cc-faq-inner\" data-kid=\"1-10-2-1-2-1\">\n                        <p class=\"max-w-[70ch] pb-8 f-sans text-[13px] leading-[2] text-[#8D99AE]\" data-kid=\"1-10-2-1-2-1-1\">\n                            Sí. Crear cuenta, calificar, guardar listas y comentar no cuesta nada. El plan Pro solo añade estadísticas avanzadas y exportación.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"cc-faq border-b-2 border-white\" data-kid=\"1-10-2-2\">\n                <button class=\"flex w-full items-center justify-between gap-6 py-8 text-left\" data-kid=\"1-10-2-2-1\">\n                    <span class=\"cc-faq-q f-serif text-2xl font-bold leading-tight sm:text-3xl\" data-kid=\"1-10-2-2-1-1\">\n                        ¿Puedo importar mi lista?\n                    </span>\n                    <span class=\"cc-faq-ico f-sans shrink-0 text-3xl leading-none\" data-kid=\"1-10-2-2-1-2\">\n                        +\n                    </span>\n                </button>\n                <div class=\"cc-faq-body\" data-kid=\"1-10-2-2-2\">\n                    <div class=\"cc-faq-inner\" data-kid=\"1-10-2-2-2-1\">\n                        <p class=\"max-w-[70ch] pb-8 f-sans text-[13px] leading-[2] text-[#8D99AE]\" data-kid=\"1-10-2-2-2-1-1\">\n                            Puedes subir un CSV con títulos y notas. Hacemos el emparejamiento automático y te mostramos los conflictos para que decidas.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"cc-faq border-b-2 border-white\" data-kid=\"1-10-2-3\">\n                <button class=\"flex w-full items-center justify-between gap-6 py-8 text-left\" data-kid=\"1-10-2-3-1\">\n                    <span class=\"cc-faq-q f-serif text-2xl font-bold leading-tight sm:text-3xl\" data-kid=\"1-10-2-3-1-1\">\n                        ¿Cómo funciona la Tier List?\n                    </span>\n                    <span class=\"cc-faq-ico f-sans shrink-0 text-3xl leading-none\" data-kid=\"1-10-2-3-1-2\">\n                        +\n                    </span>\n                </button>\n                <div class=\"cc-faq-body\" data-kid=\"1-10-2-3-2\">\n                    <div class=\"cc-faq-inner\" data-kid=\"1-10-2-3-2-1\">\n                        <p class=\"max-w-[70ch] pb-8 f-sans text-[13px] leading-[2] text-[#8D99AE]\" data-kid=\"1-10-2-3-2-1-1\">\n                            Arrastras cada título entre cinco niveles (S, A, B, C, D). Tu tier list es pública, comparable y se puede compartir como imagen.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"cc-faq border-b-2 border-white\" data-kid=\"1-10-2-4\">\n                <button class=\"flex w-full items-center justify-between gap-6 py-8 text-left\" data-kid=\"1-10-2-4-1\">\n                    <span class=\"cc-faq-q f-serif text-2xl font-bold leading-tight sm:text-3xl\" data-kid=\"1-10-2-4-1-1\">\n                        ¿Hay app móvil?\n                    </span>\n                    <span class=\"cc-faq-ico f-sans shrink-0 text-3xl leading-none\" data-kid=\"1-10-2-4-1-2\">\n                        +\n                    </span>\n                </button>\n                <div class=\"cc-faq-body\" data-kid=\"1-10-2-4-2\">\n                    <div class=\"cc-faq-inner\" data-kid=\"1-10-2-4-2-1\">\n                        <p class=\"max-w-[70ch] pb-8 f-sans text-[13px] leading-[2] text-[#8D99AE]\" data-kid=\"1-10-2-4-2-1-1\">\n                            La web es totalmente responsive e instalable en tu pantalla de inicio. Las apps nativas llegan en la próxima temporada.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"cc-faq border-b-2 border-white\" data-kid=\"1-10-2-5\">\n                <button class=\"flex w-full items-center justify-between gap-6 py-8 text-left\" data-kid=\"1-10-2-5-1\">\n                    <span class=\"cc-faq-q f-serif text-2xl font-bold leading-tight sm:text-3xl\" data-kid=\"1-10-2-5-1-1\">\n                        ¿Puedo comentar y debatir?\n                    </span>\n                    <span class=\"cc-faq-ico f-sans shrink-0 text-3xl leading-none\" data-kid=\"1-10-2-5-1-2\">\n                        +\n                    </span>\n                </button>\n                <div class=\"cc-faq-body\" data-kid=\"1-10-2-5-2\">\n                    <div class=\"cc-faq-inner\" data-kid=\"1-10-2-5-2-1\">\n                        <p class=\"max-w-[70ch] pb-8 f-sans text-[13px] leading-[2] text-[#8D99AE]\" data-kid=\"1-10-2-5-2-1-1\">\n                            Cada título tiene su hilo. Puedes escribir reseñas largas, responder y marcar spoilers para que queden ocultos hasta hacer clic.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ============ FINAL CTA ============ -->\n    <section class=\"border-b-2 border-white bg-[#E63946] px-6 py-20 sm:px-10 lg:px-14\" data-kid=\"1-11\">\n        <h2 class=\"cc-rev f-serif text-[12vw] font-black uppercase leading-[0.84] tracking-[-0.03em] text-white lg:text-[6vw]\" data-kid=\"1-11-1\">\n            Regístrate.\n            <br data-kid=\"1-11-1-1\"/>\n            Califica.\n            <br data-kid=\"1-11-1-2\"/>\n            <span class=\"italic\" data-kid=\"1-11-1-3\">\n                Debate.\n            </span>\n        </h2>\n        <div class=\"mt-12 flex flex-wrap items-center gap-8 border-t-2 border-white pt-10\" data-kid=\"1-11-2\">\n            <button class=\"border-2 border-black bg-black px-12 py-6 f-sans text-[12px] font-extrabold uppercase tracking-[0.28em] text-white hover:bg-white hover:text-black\" data-kid=\"1-11-2-1\">\n                Crear cuenta gratis\n            </button>\n            <p class=\"max-w-[34ch] f-sans text-[10px] uppercase leading-[2] tracking-[0.24em] text-white/85\" data-kid=\"1-11-2-2\">\n                Sin tarjeta. Sin anuncios. Solo cine y tu criterio.\n            </p>\n        </div>\n    </section>\n    <!-- ============ CONTACTO ============ -->\n    <section class=\"grid grid-cols-1 border-b-2 border-white lg:grid-cols-[0.9fr_1.1fr]\" data-kid=\"1-12\" id=\"contacto\">\n        <div class=\"border-white px-6 py-16 sm:px-10 lg:border-r-2 lg:px-14\" data-kid=\"1-12-1\">\n            <p class=\"f-sans text-[10px] uppercase tracking-[0.42em] text-[#E63946]\" data-kid=\"1-12-1-1\">\n                Sección 07 — Contacto\n            </p>\n            <h2 class=\"mt-6 f-serif text-5xl font-black uppercase leading-[0.88] lg:text-6xl\" data-kid=\"1-12-1-2\">\n                Escríbenos\n                <br data-kid=\"1-12-1-2-1\"/>\n                <span class=\"italic\" data-kid=\"1-12-1-2-2\">\n                    sin filtros.\n                </span>\n            </h2>\n            <p class=\"mt-8 max-w-[36ch] f-sans text-[11px] uppercase leading-[2.1] tracking-[0.2em] text-[#8D99AE]\" data-kid=\"1-12-1-3\">\n                Sugerencias, títulos que faltan, errores de ficha o simple discusión sobre finales.\n            </p>\n            <div class=\"mt-12 space-y-4 border-t-2 border-white pt-8\" data-kid=\"1-12-1-4\">\n                <p class=\"f-sans text-[10px] uppercase tracking-[0.3em] text-white\" data-kid=\"1-12-1-4-1\">\n                    hola@cineclassify.pro\n                </p>\n                <p class=\"f-sans text-[10px] uppercase tracking-[0.3em] text-[#8D99AE]\" data-kid=\"1-12-1-4-2\">\n                    Respuesta en 48 h\n                </p>\n            </div>\n        </div>\n        <div class=\"px-6 py-16 sm:px-10 lg:px-14\" data-kid=\"1-12-2\">\n            <form class=\"space-y-10\" data-kid=\"1-12-2-1\">\n                <div data-kid=\"1-12-2-1-1\">\n                    <label class=\"f-sans text-[9px] uppercase tracking-[0.34em] text-[#8D99AE]\" data-kid=\"1-12-2-1-1-1\">\n                        01 / Nombre\n                    </label>\n                    <input class=\"cc-input mt-3\" data-kid=\"1-12-2-1-1-2\" placeholder=\"Tu nombre\" type=\"text\"/>\n                </div>\n                <div data-kid=\"1-12-2-1-2\">\n                    <label class=\"f-sans text-[9px] uppercase tracking-[0.34em] text-[#8D99AE]\" data-kid=\"1-12-2-1-2-1\">\n                        02 / Email\n                    </label>\n                    <input class=\"cc-input mt-3\" data-kid=\"1-12-2-1-2-2\" placeholder=\"tu@email.com\" type=\"email\"/>\n                </div>\n                <div data-kid=\"1-12-2-1-3\">\n                    <label class=\"f-sans text-[9px] uppercase tracking-[0.34em] text-[#8D99AE]\" data-kid=\"1-12-2-1-3-1\">\n                        03 / Mensaje\n                    </label>\n                    <textarea class=\"cc-input mt-3 resize-none\" data-kid=\"1-12-2-1-3-2\" placeholder=\"¿En qué podemos ayudarte?\" rows=\"4\"></textarea>\n                </div>\n                <button class=\"w-full border-2 border-white bg-white px-8 py-5 f-sans text-[12px] font-extrabold uppercase tracking-[0.28em] text-black hover:bg-[#E63946] hover:text-white\" data-kid=\"1-12-2-1-4\" type=\"button\">\n                    Enviar mensaje\n                </button>\n            </form>\n        </div>\n    </section>\n    <!-- ============ FOOTER ============ -->\n    <footer class=\"overflow-hidden bg-black\" data-kid=\"1-13\">\n        <div class=\"grid grid-cols-1 gap-10 border-b-2 border-white px-6 py-14 sm:px-10 md:grid-cols-4 lg:px-14\" data-kid=\"1-13-1\">\n            <div data-kid=\"1-13-1-1\">\n                <p class=\"f-sans text-[9px] uppercase tracking-[0.36em] text-[#E63946]\" data-kid=\"1-13-1-1-1\">\n                    Explorar\n                </p>\n                <ul class=\"mt-5 space-y-3\" data-kid=\"1-13-1-1-2\">\n                    <li data-kid=\"1-13-1-1-2-1\">\n                        <a class=\"cc-underline f-sans text-[10px] uppercase tracking-[0.26em] text-[#8D99AE] hover:text-white\" data-kid=\"1-13-1-1-2-1-1\" href=\"#\">\n                            Películas\n                        </a>\n                    </li>\n                    <li data-kid=\"1-13-1-1-2-2\">\n                        <a class=\"cc-underline f-sans text-[10px] uppercase tracking-[0.26em] text-[#8D99AE] hover:text-white\" data-kid=\"1-13-1-1-2-2-1\" href=\"#\">\n                            Series\n                        </a>\n                    </li>\n                    <li data-kid=\"1-13-1-1-2-3\">\n                        <a class=\"cc-underline f-sans text-[10px] uppercase tracking-[0.26em] text-[#8D99AE] hover:text-white\" data-kid=\"1-13-1-1-2-3-1\" href=\"#\">\n                            Mejores calificadas\n                        </a>\n                    </li>\n                    <li data-kid=\"1-13-1-1-2-4\">\n                        <a class=\"cc-underline f-sans text-[10px] uppercase tracking-[0.26em] text-[#8D99AE] hover:text-white\" data-kid=\"1-13-1-1-2-4-1\" href=\"#\">\n                            Estadísticas\n                        </a>\n                    </li>\n                </ul>\n            </div>\n            <div data-kid=\"1-13-1-2\">\n                <p class=\"f-sans text-[9px] uppercase tracking-[0.36em] text-[#E63946]\" data-kid=\"1-13-1-2-1\">\n                    Mi cuenta\n                </p>\n                <ul class=\"mt-5 space-y-3\" data-kid=\"1-13-1-2-2\">\n                    <li data-kid=\"1-13-1-2-2-1\">\n                        <a class=\"cc-underline f-sans text-[10px] uppercase tracking-[0.26em] text-[#8D99AE] hover:text-white\" data-kid=\"1-13-1-2-2-1-1\" href=\"#\">\n                            Mi lista\n                        </a>\n                    </li>\n                    <li data-kid=\"1-13-1-2-2-2\">\n                        <a class=\"cc-underline f-sans text-[10px] uppercase tracking-[0.26em] text-[#8D99AE] hover:text-white\" data-kid=\"1-13-1-2-2-2-1\" href=\"#\">\n                            Mi tier list\n                        </a>\n                    </li>\n                    <li data-kid=\"1-13-1-2-2-3\">\n                        <a class=\"cc-underline f-sans text-[10px] uppercase tracking-[0.26em] text-[#8D99AE] hover:text-white\" data-kid=\"1-13-1-2-2-3-1\" href=\"#\">\n                            Iniciar sesión\n                        </a>\n                    </li>\n                    <li data-kid=\"1-13-1-2-2-4\">\n                        <a class=\"cc-underline f-sans text-[10px] uppercase tracking-[0.26em] text-[#8D99AE] hover:text-white\" data-kid=\"1-13-1-2-2-4-1\" href=\"#\">\n                            Registrarse\n                        </a>\n                    </li>\n                </ul>\n            </div>\n            <div data-kid=\"1-13-1-3\">\n                <p class=\"f-sans text-[9px] uppercase tracking-[0.36em] text-[#E63946]\" data-kid=\"1-13-1-3-1\">\n                    Legal\n                </p>\n                <ul class=\"mt-5 space-y-3\" data-kid=\"1-13-1-3-2\">\n                    <li data-kid=\"1-13-1-3-2-1\">\n                        <a class=\"cc-underline f-sans text-[10px] uppercase tracking-[0.26em] text-[#8D99AE] hover:text-white\" data-kid=\"1-13-1-3-2-1-1\" href=\"#\">\n                            Términos\n                        </a>\n                    </li>\n                    <li data-kid=\"1-13-1-3-2-2\">\n                        <a class=\"cc-underline f-sans text-[10px] uppercase tracking-[0.26em] text-[#8D99AE] hover:text-white\" data-kid=\"1-13-1-3-2-2-1\" href=\"#\">\n                            Privacidad\n                        </a>\n                    </li>\n                    <li data-kid=\"1-13-1-3-2-3\">\n                        <a class=\"cc-underline f-sans text-[10px] uppercase tracking-[0.26em] text-[#8D99AE] hover:text-white\" data-kid=\"1-13-1-3-2-3-1\" href=\"#\">\n                            Cookies\n                        </a>\n                    </li>\n                </ul>\n            </div>\n            <div class=\"flex flex-col justify-between gap-8\" data-kid=\"1-13-1-4\">\n                <div class=\"flex gap-3\" data-kid=\"1-13-1-4-1\">\n                    <a aria-label=\"GitHub\" class=\"flex h-11 w-11 items-center justify-center border-2 border-white hover:bg-white hover:text-black\" data-kid=\"1-13-1-4-1-1\" href=\"#\">\n                        <i class=\"ti ti-brand-github text-lg\" data-kid=\"1-13-1-4-1-1-1\">\n                        </i>\n                    </a>\n                    <a aria-label=\"Twitter\" class=\"flex h-11 w-11 items-center justify-center border-2 border-white hover:bg-white hover:text-black\" data-kid=\"1-13-1-4-1-2\" href=\"#\">\n                        <i class=\"ti ti-brand-x text-lg\" data-kid=\"1-13-1-4-1-2-1\">\n                        </i>\n                    </a>\n                    <a aria-label=\"LinkedIn\" class=\"flex h-11 w-11 items-center justify-center border-2 border-white hover:bg-white hover:text-black\" data-kid=\"1-13-1-4-1-3\" href=\"#\">\n                        <i class=\"ti ti-brand-linkedin text-lg\" data-kid=\"1-13-1-4-1-3-1\">\n                        </i>\n                    </a>\n                </div>\n                <p class=\"f-sans text-[9px] uppercase leading-[2] tracking-[0.28em] text-[#8D99AE]\" data-kid=\"1-13-1-4-2\">\n                    Desarrollado por\n                    <br data-kid=\"1-13-1-4-2-1\"/>\n                    <span class=\"text-white\" data-kid=\"1-13-1-4-2-2\">\n                        [calomixx]\n                    </span>\n                </p>\n            </div>\n        </div>\n        <div class=\"relative -mx-2 select-none py-8\" data-kid=\"1-13-2\">\n            <p class=\"f-serif whitespace-nowrap text-[15.6vw] font-black uppercase leading-[0.78] tracking-[-0.045em] text-white\" data-kid=\"1-13-2-1\">\n                Cineclassify Pro\n            </p>\n        </div>\n        <div class=\"flex flex-wrap items-center justify-between gap-4 border-t-2 border-white px-6 py-6 sm:px-10 lg:px-14\" data-kid=\"1-13-3\">\n            <p class=\"f-sans text-[9px] uppercase tracking-[0.3em] text-[#8D99AE]\" data-kid=\"1-13-3-1\">\n                © 2026 CineClassify Pro — Edición editorial\n            </p>\n            <p class=\"f-sans text-[9px] uppercase tracking-[0.3em] text-[#8D99AE]\" data-kid=\"1-13-3-2\">\n                Hecho para quien discute los finales\n            </p>\n        </div>\n    </footer>\n</div>\n<link data-kid=\"2\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n\n  // Hero headline hard-edged line reveal\n  gsap.set('.cc-hs', { yPercent: 110, opacity: 0 });\n  gsap.to('.cc-hs', { yPercent: 0, opacity: 1, duration: 0.7, ease: 'power4.out', stagger: 0.08, delay: 0.1 });\n\n  // Clip-path reveals on editorial blocks\n  gsap.utils.toArray('.cc-rev').forEach(function (el) {\n    gsap.fromTo(el,\n      { clipPath: 'inset(0% 0% 100% 0%)', y: 24 },\n      {\n        clipPath: 'inset(0% 0% 0% 0%)', y: 0, duration: 0.75, ease: 'power3.out',\n        scrollTrigger: { trigger: el, start: 'top 88%', once: true }\n      });\n  });\n\n  // Poster tiles staggered snap-in\n  gsap.utils.toArray('.cc-tile').forEach(function (el, i) {\n    gsap.fromTo(el, { opacity: 0, y: 40 }, {\n      opacity: 1, y: 0, duration: 0.45, ease: 'steps(4)', delay: (i % 5) * 0.06,\n      scrollTrigger: { trigger: el, start: 'top 92%', once: true }\n    });\n  });\n\n  // Counting numbers\n  gsap.utils.toArray('.cc-num').forEach(function (el) {\n    var target = parseFloat(el.getAttribute('data-to'));\n    var obj = { v: 0 };\n    gsap.to(obj, {\n      v: target, duration: 1.6, ease: 'power2.out',\n      scrollTrigger: { trigger: el, start: 'top 90%', once: true },\n      onUpdate: function () {\n        el.textContent = Math.round(obj.v).toLocaleString('es-ES');\n      }\n    });\n  });\n\n  // FAQ accordion — snappy\n  document.querySelectorAll('#cc-faq-list .cc-faq').forEach(function (item) {\n    item.querySelector('button').addEventListener('click', function () {\n      var open = item.classList.contains('is-open');\n      document.querySelectorAll('#cc-faq-list .cc-faq').forEach(function (other) {\n        other.classList.remove('is-open');\n        other.querySelector('.cc-faq-ico').textContent = '+';\n      });\n      if (!open) {\n        item.classList.add('is-open');\n        item.querySelector('.cc-faq-ico').textContent = '−';\n      }\n    });\n  });\n</script>\n",
      "comments": [],
      "created": "2026-08-15T05:44:53.142682+00:00",
      "modified": "2026-08-15T05:48:37.105036+00:00",
