      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800;0,900;1,700&family=Outfit:wght@300;400;500;600;700;800&display=swap');\n\n.f-serif { font-family: 'Playfair Display', serif; }\n.f-sans  { font-family: 'Outfit', sans-serif; }\n\n@layer base {\n  .cc-root { font-family: 'Outfit', sans-serif; }\n}\n\n@keyframes cc-tape { from { transform: translate3d(0,0,0); } to { transform: translate3d(-50%,0,0); } }\n@keyframes cc-tape-rev { from { transform: translate3d(-50%,0,0); } to { transform: translate3d(0,0,0); } }\n.cc-tape-track { display: flex; width: max-content; animation: cc-tape 26s linear infinite; }\n.cc-tape-track-rev { display: flex; width: max-content; animation: cc-tape-rev 34s linear infinite; }\n.cc-tape-slow { animation-duration: 46s; }\n\n/* brutalist inputs */\n.cc-input {\n  width: 100%; background: #000; color: #fff; border: 0; border-bottom: 2px solid #ffffff;\n  padding: 14px 2px; font-size: 15px; letter-spacing: 0.02em; outline: none; border-radius: 0;\n}\n.cc-input::placeholder { color: #8D99AE; text-transform: uppercase; letter-spacing: 0.18em; font-size: 11px; }\n.cc-input:focus { border-bottom-color: #E63946; }\n\n.cc-faq-body { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .18s steps(4, end); }\n.cc-faq.is-open .cc-faq-body { grid-template-rows: 1fr; }\n.cc-faq-inner { overflow: hidden; }\n.cc-faq.is-open .cc-faq-q { color: #E63946; }\n\n.cc-hs { display: inline-block; will-change: transform; }\n.cc-underline { position: relative; }\n.cc-underline::after { content:''; position:absolute; left:0; bottom:-4px; height:2px; width:0; background:#E63946; transition: width .15s steps(3, end); }\n.cc-underline:hover::after { width:100%; }\n</style>\n<div class=\"cc-root bg-black text-white antialiased overflow-x-hidden selection:bg-[#E63946] selection:text-white\" data-kid=\"1\">\n    <!-- ============ TOP BAR ============ -->\n    <header class=\"sticky top-0 z-50 border-b-2 border-white bg-black\" data-kid=\"1-1\">\n        <div class=\"mx-auto flex max-w-[1440px] items-stretch\" data-kid=\"1-1-1\">\n            <a class=\"flex flex-col justify-center border-r border-white/25 px-6 py-4 leading-none\" data-kid=\"1-1-1-1\" href=\"#\">\n                <span class=\"f-sans text-[15px] font-extrabold uppercase tracking-[0.28em]\" data-kid=\"1-1-1-1-1\">\n                    Cineclassify\n                </span>\n                <span class=\"f-sans mt-1 text-[9px] uppercase tracking-[0.5em] text-[#E63946]\" data-kid=\"1-1-1-1-2\">\n                    Pro / Edición 2026\n                </span>\n            </a>\n            <nav class=\"hidden flex-1 items-stretch lg:flex\" data-kid=\"1-1-1-2\">\n                <a class=\"flex items-center border-r border-white/25 px-7 f-sans text-[11px] font-medium uppercase tracking-[0.26em] text-white hover:bg-white hover:text-black\" data-kid=\"1-1-1-2-1\" href=\"#inicio\">\n                    Inicio\n                </a>\n                <a class=\"flex items-center border-r border-white/25 px-7 f-sans text-[11px] font-medium uppercase tracking-[0.26em] text-[#8D99AE] hover:bg-white hover:text-black\" data-kid=\"1-1-1-2-2\" href=\"#catalogo\">\n                    Catálogo\n                </a>\n                <a class=\"flex items-center border-r border-white/25 px-7 f-sans text-[11px] font-medium uppercase tracking-[0.26em] text-[#8D99AE] hover:bg-white hover:text-black\" data-kid=\"1-1-1-2-3\" href=\"#ranking\">\n                    Ranking\n                </a>\n                <a class=\"flex items-center border-r border-white/25 px-7 f-sans text-[11px] font-medium uppercase tracking-[0.26em] text-[#8D99AE] hover:bg-white hover:text-black\" data-kid=\"1-1-1-2-4\" href=\"#contacto\">\n                    Contacto\n                </a>\n            </nav>\n            <div class=\"ml-auto flex items-stretch\" data-kid=\"1-1-1-3\">\n                <button class=\"border-l border-white/25 px-6 f-sans text-[11px] font-semibold uppercase tracking-[0.24em] text-white hover:bg-white hover:text-black\" data-kid=\"1-1-1-3-1\">\n                    Iniciar sesión\n                </button>\n                <button class=\"border-l-2 border-white bg-[#E63946] px-7 f-sans text-[11px] font-bold uppercase tracking-[0.24em] text-white hover:bg-white hover:text-black\" data-kid=\"1-1-1-3-2\">\n                    Registrarse\n                </button>\n            </div>\n        </div>\n    </header>\n    <!-- ============ HERO ============ -->\n    <section class=\"grid grid-cols-1 border-b-2 border-white lg:grid-cols-[1.15fr_0.85fr]\" data-kid=\"1-2\" id=\"inicio\">\n        <div class=\"relative flex flex-col justify-between border-white px-6 py-14 sm:px-10 lg:border-r-2 lg:px-14 lg:py-20\" data-kid=\"1-2-1\">\n            <div class=\"mb-10 flex items-center gap-4\" data-kid=\"1-2-1-1\">\n                <span class=\"h-[2px] w-14 bg-[#E63946]\" data-kid=\"1-2-1-1-1\">\n                </span>\n                <span class=\"f-sans text-[10px] uppercase tracking-[0.42em] text-[#8D99AE]\" data-kid=\"1-2-1-1-2\">\n                    N.º 01 — Plataforma de crítica\n                </span>\n            </div>\n            <h1 class=\"f-serif text-[13vw] font-black uppercase leading-[0.83] tracking-[-0.03em] sm:text-[9vw] lg:text-[6.6vw]\" data-kid=\"1-2-1-2\">\n                <span class=\"cc-hs block\" data-kid=\"1-2-1-2-1\">\n                    La última\n                </span>\n                <span class=\"cc-hs block\" data-kid=\"1-2-1-2-2\">\n                    palabra\n                </span>\n                <span class=\"cc-hs block\" data-kid=\"1-2-1-2-3\">\n                    en cine\n                </span>\n                <span class=\"cc-hs block italic text-[#E63946]\" data-kid=\"1-2-1-2-4\">\n                    es tuya.\n                </span>\n            </h1>\n            <p class=\"mt-9 max-w-[46ch] f-sans text-[11px] font-medium uppercase leading-[2.1] tracking-[0.22em] text-[#8D99AE]\" data-kid=\"1-2-1-3\">\n                Clasifica, valora, guarda y debate cada película y serie que ves.\n        Construye tu tier list. Discute con quienes sí saben mirar.\n            </p>\n            <div class=\"mt-11 flex flex-wrap items-center gap-6\" data-kid=\"1-2-1-4\">\n                <button class=\"border-2 border-white bg-white px-10 py-5 f-sans text-[12px] font-extrabold uppercase tracking-[0.26em] text-black hover:bg-[#E63946] hover:text-white\" data-kid=\"1-2-1-4-1\">\n                    Empezar ahora\n                </button>\n                <a class=\"cc-underline f-sans text-[11px] font-semibold uppercase tracking-[0.26em] text-white\" data-kid=\"1-2-1-4-2\" href=\"#catalogo\">\n                    Ver el catálogo  ⟶\n                </a>\n            </div>\n            <div class=\"mt-14 grid grid-cols-3 border-t-2 border-white\" data-kid=\"1-2-1-5\">\n                <div class=\"border-r border-white/25 py-6 pr-4\" data-kid=\"1-2-1-5-1\">\n                    <p class=\"f-serif text-4xl font-bold leading-none\" data-dynamic=\"true\" data-kid=\"1-2-1-5-1-1\" data-name=\"total titles count\" data-reason=\"number text counted up from 0 by script\">\n                        89.000\n                    </p>\n                    <p class=\"mt-2 f-sans text-[9px] uppercase tracking-[0.3em] text-[#8D99AE]\" data-kid=\"1-2-1-5-1-2\">\n                        Títulos\n                    </p>\n                </div>\n                <div class=\"border-r border-white/25 px-4 py-6\" data-kid=\"1-2-1-5-2\">\n                    <p class=\"f-serif text-4xl font-bold leading-none\" data-dynamic=\"true\" data-kid=\"1-2-1-5-2-1\" data-name=\"total users count\" data-reason=\"number text counted up from 0 by script\">\n                        12.400\n                    </p>\n                    <p class=\"mt-2 f-sans text-[9px] uppercase tracking-[0.3em] text-[#8D99AE]\" data-kid=\"1-2-1-5-2-2\">\n                        Cinéfilos\n                    </p>\n                </div>\n                <div class=\"px-4 py-6\" data-kid=\"1-2-1-5-3\">\n                    <p class=\"f-serif text-4xl font-bold leading-none\" data-dynamic=\"true\" data-kid=\"1-2-1-5-3-1\" data-name=\"global average rating\" data-reason=\"number text counted up from 0 by script\">\n                        4,8\n                    </p>\n                    <p class=\"mt-2 f-sans text-[9px] uppercase tracking-[0.3em] text-[#8D99AE]\" data-kid=\"1-2-1-5-3-2\">\n                        Media global\n                    </p>\n                </div>\n            </div>\n        </div>\n        <div class=\"relative min-h-[440px] overflow-hidden bg-black lg:min-h-[820px]\" data-kid=\"1-2-2\">\n            <img alt=\"Fotograma cinematográfico dramático en blanco y negro, Ekaterina Buyakova on Unsplash\" class=\"absolute inset-0 h-full w-full object-cover grayscale contrast-125\" data-kid=\"1-2-2-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1738142684576-eec54c2f1844?auto=format&fit=crop&w=1100&q=80\"/>\n            <div class=\"absolute inset-0 bg-black/25\" data-kid=\"1-2-2-2\">\n            </div>\n            <div class=\"absolute left-0 top-0 border-b-2 border-r-2 border-white bg-black px-5 py-3\" data-kid=\"1-2-2-3\">\n                <span class=\"f-sans text-[9px] uppercase tracking-[0.4em] text-white\" data-kid=\"1-2-2-3-1\">\n                    En cartelera / 2026\n                </span>\n            </div>\n            <div class=\"absolute bottom-0 left-0 right-0 border-t-2 border-white bg-black px-6 py-5\" data-kid=\"1-2-2-4\">\n                <p class=\"f-serif text-xl italic leading-tight\" data-kid=\"1-2-2-4-1\">\n                    “Ninguna película está terminada hasta que alguien la califica.”\n                </p>\n                <p class=\"mt-3 f-sans text-[9px] uppercase tracking-[0.34em] text-[#8D99AE]\" data-kid=\"1-2-2-4-2\">\n                    Manifiesto CineClassify\n                </p>\n            </div>\n        </div>\n    </section>\n    <!-- ============ MARQUEE TAPE ============ -->\n    <section class=\"border-b-2 border-white bg-[#E63946] py-4 overflow-hidden\" data-kid=\"1-3\">\n        <div class=\"cc-tape-track\" data-kid=\"1-3-1\">\n            <span class=\"f-sans whitespace-nowrap pr-10 text-[13px] font-extrabold uppercase tracking-[0.32em] text-white\" data-kid=\"1-3-1-1\">\n                +++ ¿Ya la viste? +++ Regístrate y califícala +++ ¿Ya la viste? +++ Regístrate y califícala +++ ¿Ya la viste? +++ Regístrate y califícala +++\n            </span>\n            <span class=\"f-sans whitespace-nowrap pr-10 text-[13px] font-extrabold uppercase tracking-[0.32em] text-white\" data-kid=\"1-3-1-2\">\n                +++ ¿Ya la viste? +++ Regístrate y califícala +++ ¿Ya la viste? +++ Regístrate y califícala +++ ¿Ya la viste? +++ Regístrate y califícala +++\n            </span>\n        </div>\n    </section>\n    <section class=\"border-b-2 border-white bg-black py-3 overflow-hidden\" data-kid=\"1-4\">\n        <div class=\"cc-tape-track-rev cc-tape-slow\" data-kid=\"1-4-1\">\n            <span class=\"f-sans whitespace-nowrap pr-10 text-[12px] font-medium uppercase tracking-[0.42em] text-[#8D99AE]\" data-kid=\"1-4-1-1\">\n                Dune: Parte Dos · Furiosa · Wicked · Nosferatu · Arcane T2 · Sinners · Gladiator II · The Last of Us T2 · Deadpool & Wolverine · Beetlejuice ·\n            </span>\n            <span class=\"f-sans whitespace-nowrap pr-10 text-[12px] font-medium uppercase tracking-[0.42em] text-[#8D99AE]\" data-kid=\"1-4-1-2\">\n                Dune: Parte Dos · Furiosa · Wicked · Nosferatu · Arcane T2 · Sinners · Gladiator II · The Last of Us T2 · Deadpool & Wolverine · Beetlejuice ·\n            </span>\n        </div>\n    </section>\n    <!-- ============ KEY MARKETING GRID ============ -->\n    <section class=\"border-b-2 border-white\" data-kid=\"1-5\" id=\"catalogo\">\n        <div class=\"grid grid-cols-1 border-b-2 border-white lg:grid-cols-[1fr_auto]\" data-kid=\"1-5-1\">\n            <div class=\"px-6 py-12 sm:px-10 lg:px-14\" data-kid=\"1-5-1-1\">\n                <p class=\"f-sans text-[10px] uppercase tracking-[0.42em] text-[#E63946]\" data-kid=\"1-5-1-1-1\">\n                    Sección 02 — Del momento\n                </p>\n                <h2 class=\"cc-rev mt-6 f-serif text-[10vw] font-black uppercase leading-[0.86] tracking-[-0.03em] sm:text-[6.4vw] lg:text-[4.6vw]\" data-kid=\"1-5-1-1-2\">\n                    ¿Ya la viste?\n                    <br data-kid=\"1-5-1-1-2-1\"/>\n                    <span class=\"italic\" data-kid=\"1-5-1-1-2-2\">\n                        Regístrate y califícala.\n                    </span>\n                </h2>\n            </div>\n            <div class=\"flex max-w-[420px] flex-col justify-end gap-6 border-t-2 border-white px-6 py-10 sm:px-10 lg:border-l-2 lg:border-t-0 lg:px-10\" data-kid=\"1-5-1-2\">\n                <p class=\"f-sans text-[11px] uppercase leading-[2.1] tracking-[0.2em] text-[#8D99AE]\" data-kid=\"1-5-1-2-1\">\n                    Los 10 títulos más comentados de la temporada. Pasa el cursor sobre cualquiera:\n          tu nota no cuenta hasta que tengas cuenta.\n                </p>\n                <button class=\"w-full border-2 border-white bg-black px-6 py-4 f-sans text-[11px] font-bold uppercase tracking-[0.26em] text-white hover:bg-[#E63946]\" data-kid=\"1-5-1-2-2\">\n                    Crear cuenta gratis ⟶\n                </button>\n            </div>\n        </div>\n        <!-- zero-gap rigid grid -->\n        <div class=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5\" data-kid=\"1-5-2\">\n            <!-- 01 -->\n            <article class=\"cc-tile group relative aspect-[2/3] overflow-hidden border-b border-r border-white/25 bg-black\" data-kid=\"1-5-2-1\">\n                <img alt=\"Póster cinematográfico en blanco y negro, Rumeysa Sürücüoğlu on Pexels\" class=\"absolute inset-0 h-full w-full object-cover grayscale contrast-125 group-hover:opacity-0\" data-kid=\"1-5-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/31222564/pexels-photo-31222564.png?auto=compress&cs=tinysrgb&w=700&q=80\"/>\n                <span class=\"absolute left-0 top-0 z-20 border-b-2 border-r-2 border-white bg-black px-3 py-1 f-sans text-[10px] font-bold tracking-[0.2em]\" data-kid=\"1-5-2-1-2\">\n                    01\n                </span>\n                <div class=\"absolute inset-x-0 bottom-0 z-10 bg-black px-4 py-3 group-hover:opacity-0\" data-kid=\"1-5-2-1-3\">\n                    <p class=\"f-serif text-lg font-bold leading-tight\" data-kid=\"1-5-2-1-3-1\">\n                        Dune: Parte Dos\n                    </p>\n                    <p class=\"mt-1 f-sans text-[9px] uppercase tracking-[0.3em] text-[#8D99AE]\" data-kid=\"1-5-2-1-3-2\">\n                        2024 · Ciencia ficción\n                    </p>\n                </div>\n                <div class=\"absolute inset-0 z-20 flex flex-col justify-between bg-black p-5 opacity-0 group-hover:opacity-100\" data-kid=\"1-5-2-1-4\">\n                    <div data-kid=\"1-5-2-1-4-1\">\n                        <p class=\"f-serif text-2xl font-black uppercase leading-[0.95]\" data-kid=\"1-5-2-1-4-1-1\">\n                            Dune:\n                            <br data-kid=\"1-5-2-1-4-1-1-1\"/>\n                            Parte Dos\n                        </p>\n                        <p class=\"mt-3 f-sans text-[9px] uppercase tracking-[0.3em] text-[#8D99AE]\" data-kid=\"1-5-2-1-4-1-2\">\n                            2024 · Ciencia ficción\n                        </p>\n                    </div>\n                    <div data-kid=\"1-5-2-1-4-2\">\n                        <div class=\"mb-4 flex gap-1 text-[18px] text-white\" data-kid=\"1-5-2-1-4-2-1\">\n                            <span 