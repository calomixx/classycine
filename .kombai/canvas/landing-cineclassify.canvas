] font-semibold\" data-kid=\"2-4-2-2-2-2-2\" data-name=\"step title 1\">\n                            Crea tu perfil\n                        </h3>\n                        <p class=\"mt-2 text-[14.5px] text-[var(--ink-2)]\" data-kid=\"2-4-2-2-2-2-3\" data-name=\"step description 1\">\n                            Un minuto, sin tarjeta. Elige tus géneros favoritos y CineClassify empieza a entenderte desde la primera sesión.\n                        </p>\n                    </div>\n                </div>\n                <!-- step 2 -->\n                <div class=\"reveal relative mb-10 pl-20 md:mb-14 md:ml-auto md:w-1/2 md:pl-16\" data-kid=\"2-4-2-2-3\" data-name=\"step 2\">\n                    <span class=\"absolute left-[12px] top-1 flex h-8 w-8 items-center justify-center rounded-full bg-[var(--gold)] text-[15px] text-[#231404] shadow-[0_0_0_6px_rgba(245,158,11,.14),0_0_24px_rgba(245,158,11,.6)] md:left-[-16px]\" data-kid=\"2-4-2-2-3-1\" data-name=\"step icon 2\">\n                        <i class=\"ti ti-bookmark-filled\" data-kid=\"2-4-2-2-3-1-1\" data-name=\"bookmark icon\">\n                        </i>\n                    </span>\n                    <div class=\"rounded-2xl border border-[var(--line)] bg-[rgba(254,243,199,.04)] p-6 backdrop-blur-md\" data-kid=\"2-4-2-2-3-2\" data-name=\"step content container 2\">\n                        <span class=\"pf text-[13px] italic text-[var(--gold)]\" data-kid=\"2-4-2-2-3-2-1\" data-name=\"step label 2\">\n                            Paso 02\n                        </span>\n                        <h3 class=\"pf mt-1 text-[22px] font-semibold\" data-kid=\"2-4-2-2-3-2-2\" data-name=\"step title 2\">\n                            Añade a tu watchlist\n                        </h3>\n                        <p class=\"mt-2 text-[14.5px] text-[var(--ink-2)]\" data-kid=\"2-4-2-2-3-2-3\" data-name=\"step description 2\">\n                            Guarda estrenos, clásicos y series pendientes. Tu lista viaja contigo y nunca vuelves a preguntar “¿qué vemos hoy?”.\n                        </p>\n                    </div>\n                </div>\n                <!-- step 3 -->\n                <div class=\"reveal relative mb-10 pl-20 md:mb-14 md:w-1/2 md:pl-0 md:pr-16 md:text-right\" data-kid=\"2-4-2-2-4\" data-name=\"step 3\">\n                    <span class=\"absolute left-[12px] top-1 flex h-8 w-8 items-center justify-center rounded-full bg-[var(--gold)] text-[15px] text-[#231404] shadow-[0_0_0_6px_rgba(245,158,11,.14),0_0_24px_rgba(245,158,11,.6)] md:left-auto md:right-[-16px]\" data-kid=\"2-4-2-2-4-1\" data-name=\"step icon 3\">\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-4-2-2-4-1-1\" data-name=\"star icon\">\n                        </i>\n                    </span>\n                    <div class=\"rounded-2xl border border-[var(--line)] bg-[rgba(254,243,199,.04)] p-6 backdrop-blur-md\" data-kid=\"2-4-2-2-4-2\" data-name=\"step content container 3\">\n                        <span class=\"pf text-[13px] italic text-[var(--gold)]\" data-kid=\"2-4-2-2-4-2-1\" data-name=\"step label 3\">\n                            Paso 03\n                        </span>\n                        <h3 class=\"pf mt-1 text-[22px] font-semibold\" data-kid=\"2-4-2-2-4-2-2\" data-name=\"step title 3\">\n                            Califica y comenta\n                        </h3>\n                        <p class=\"mt-2 text-[14.5px] text-[var(--ink-2)]\" data-kid=\"2-4-2-2-4-2-3\" data-name=\"step description 3\">\n                            Cinco estrellas, una reseña y todo el debate. Responde a otros cinéfilos y defiende tus decisiones más polémicas.\n                        </p>\n                    </div>\n                </div>\n                <!-- step 4 -->\n                <div class=\"reveal relative pl-20 md:ml-auto md:w-1/2 md:pl-16\" data-kid=\"2-4-2-2-5\" data-name=\"step 4\">\n                    <span class=\"absolute left-[12px] top-1 flex h-8 w-8 