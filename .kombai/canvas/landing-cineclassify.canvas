top-0 h-[520px] w-[900px] -translate-x-1/2 rounded-full bg-[#B000FF]/12 blur-[150px]\" data-kid=\"2-4-1\" data-name=\"section background blur\">\n        </div>\n        <div class=\"relative mx-auto max-w-[1240px] px-6\" data-kid=\"2-4-2\" data-name=\"section content container\">\n            <div class=\"reveal flex flex-col gap-6 border-b border-white/10 pb-10 lg:flex-row lg:items-end lg:justify-between\" data-kid=\"2-4-2-1\" data-name=\"catalog header layout\">\n                <div data-kid=\"2-4-2-1-1\" data-name=\"catalog headline container\">\n                    <p class=\"mono text-[11px] uppercase tracking-[0.24em] text-[#00E5FF]\" data-kid=\"2-4-2-1-1-1\" data-name=\"section subheader label\">\n                        Películas y series del momento\n                    </p>\n                    <h2 class=\"mt-4 max-w-[720px] font-serif text-[clamp(2.1rem,4vw,3.5rem)] font-bold italic leading-[1.06]\" data-kid=\"2-4-2-1-1-2\" data-name=\"catalog main headline\" style=\"font-family:'Playfair Display',Georgia,serif\">\n                        ¿Ya la viste?\n                        <span class=\"not-italic text-[#FF007F] [text-shadow:0_0_30px_rgba(255,0,127,.45)]\" data-kid=\"2-4-2-1-1-2-1\" data-name=\"headline emphasis text\">\n                            Regístrate y califícala.\n                        </span>\n                    </h2>\n                    <p class=\"mt-4 max-w-[560px] text-[#A0B0C0]\" data-kid=\"2-4-2-1-1-3\" data-name=\"section description text\">\n                        Los estrenos que todo el mundo está comentando. Tu nota decide el ranking de la comunidad — pero primero necesitas una cuenta.\n                    </p>\n                </div>\n                <div class=\"shrink-0 rounded-2xl border border-[#FF007F]/30 bg-[#FF007F]/[0.07] p-5\" data-kid=\"2-4-2-1-2\" data-name=\"catalog cta card\">\n                    <p class=\"mono text-[10px] uppercase tracking-[0.2em] text-[#FF007F]\" data-kid=\"2-4-2-1-2-1\" data-name=\"cta card label\">\n                        Acceso inmediato\n                    </p>\n                    <p class=\"mt-2 text-sm text-[#A0B0C0]\" data-kid=\"2-4-2-1-2-2\" data-name=\"cta card text\">\n                        Crea tu cuenta en\n                        <strong class=\"text-white\" data-kid=\"2-4-2-1-2-2-1\" data-name=\"cta card highlight\">\n                            20 segundos\n                        </strong>\n                        y empieza a puntuar.\n                    </p>\n                    <button class=\"mono mt-4 w-full rounded-md bg-[#FF007F] px-5 py-3 text-[12px] font-bold uppercase tracking-wider text-white hover:bg-white hover:text-[#FF007F]\" data-kid=\"2-4-2-1-2-3\" data-name=\"create account button\">\n                        Crear cuenta gratis\n                    </button>\n                </div>\n            </div>\n            <!-- staggered asymmetric poster grid -->\n            <div class=\"mt-12 grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-5\" data-kid=\"2-4-2-2\" data-name=\"poster grid container\">\n                <!-- 1 -->\n                <article class=\"cc-poster reveal parallax-a group relative col-span-1 overflow-hidden rounded-2xl border border-white/10 lg:col-span-2 lg:row-span-2\" data-kid=\"2-4-2-2-1\" data-name=\"large feature poster card\">\n                    <div class=\"cc-poster-ring pointer-events-none absolute inset-0 z-20 rounded-2xl opacity-0 ring-2 ring-[#FF007F] ring-inset\" data-kid=\"2-4-2-2-1-1\" data-name=\"poster ring overlay\">\n                    </div>\n                    <div class=\"relative aspect-2/3 lg:aspect-auto lg:h-full lg:min-h-[520px] overflow-hidden\" data-kid=\"2-4-2-2-1-2\" data-name=\"poster image wrapper\">\n                        <img alt=\"Póster de Deadpool & Wolverine — Pedro H. Novais on Pexels\" class=\"cc-poster-img h-full w-full object-cover\" data-kid=\"2-4-2-2-1-2-1\" data-name=\"poster image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.