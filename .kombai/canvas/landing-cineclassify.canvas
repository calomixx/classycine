italic text-[var(--gold)]\" data-kid=\"2-7-1-1-1-2-2\" data-name=\"headline highlight\">\n                            de la casa.\n                        </span>\n                    </h2>\n                </div>\n                <p class=\"max-w-[300px] text-[14px] text-[var(--ink-3)]\" data-kid=\"2-7-1-1-2\" data-name=\"header description\">\n                    Reseñas reales de la comunidad CineClassify, sin patrocinio de ningún estudio.\n                </p>\n            </div>\n            <div class=\"reveal snap-x-c flex gap-6 overflow-x-auto pb-4\" data-kid=\"2-7-1-2\" data-name=\"carousel track\">\n                <figure class=\"snap-i ticket w-[340px] shrink-0 bg-[linear-gradient(180deg,rgba(254,243,199,.08),rgba(254,243,199,.03))] p-7 ring-1 ring-[var(--line)]\" data-kid=\"2-7-1-2-1\" data-name=\"testimonial 1\">\n                    <div class=\"mb-4 flex gap-1 text-[15px] text-[var(--gold)]\" data-kid=\"2-7-1-2-1-1\" data-name=\"rating container 1\">\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-7-1-2-1-1-1\" data-name=\"star 1\">\n                        </i>\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-7-1-2-1-1-2\" data-name=\"star 2\">\n                        </i>\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-7-1-2-1-1-3\" data-name=\"star 3\">\n                        </i>\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-7-1-2-1-1-4\" data-name=\"star 4\">\n                        </i>\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-7-1-2-1-1-5\" data-name=\"star 5\">\n                        </i>\n                    </div>\n                    <blockquote class=\"pf text-[19px] italic leading-[1.55] text-[var(--cream)]\" data-kid=\"2-7-1-2-1-2\" data-name=\"quote 1\">\n                        “Dejé de anotar películas en el móvil. Ahora todo mi historial vive acá, con notas y reseñas que puedo releer años después.”\n                 