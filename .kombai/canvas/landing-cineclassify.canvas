font-extrabold sm:text-4xl\" data-kid=\"2-7-1-1-2-7\">\n                        4.8\n                        <span class=\"text-sm font-bold uppercase tracking-widest\" data-kid=\"2-7-1-1-2-7-1\">\n                            valoración media\n                        </span>\n                    </span>\n                    <span class=\"text-2xl opacity-40\" data-kid=\"2-7-1-1-2-8\">\n                        ★\n                    </span>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ============ TESTIMONIOS ============ -->\n    <section class=\"bg-[#070A12] py-20 sm:py-24\" data-kid=\"2-8\" data-name=\"testimonials section\">\n        <div class=\"mx-auto max-w-[1240px] px-6\" data-kid=\"2-8-1\" data-name=\"container\">\n            <div class=\"reveal flex flex-wrap items-end justify-between gap-6\" data-kid=\"2-8-1-1\" data-name=\"header\">\n                <div data-kid=\"2-8-1-1-1\" data-name=\"label\">\n                    <p class=\"mono text-[11px] uppercase tracking-[0.24em] text-[#00E5FF]\" data-kid=\"2-8-1-1-1-1\">\n                        La comunidad\n                    </p>\n                    <h2 class=\"mt-4 text-[clamp(1.8rem,3.2vw,2.8rem)] font-extrabold\" data-kid=\"2-8-1-1-1-2\">\n                        Lo que dicen los que ya califican.\n                    </h2>\n                </div>\n                <p class=\"mono text-[11px] uppercase tracking-[0.18em] text-[#A0B0C0]\" data-kid=\"2-8-1-1-2\" data-name=\"headline\">\n                    desliza →\n                </p>\n            </div>\n            <div class=\"cc-scroll-x reveal mt-10 flex snap-x snap-mandatory gap-5 overflow-x-auto pb-4\" data-kid=\"2-8-1-2\" data-name=\"scrollable container\">\n                <figure class=\"w-[330px] shrink-0 snap-start rounded-2xl border border-white/10 bg-[#0A0E16] p-7\" data-kid=\"2-8-1-2-1\" data-name=\"card 1\">\n                    <div class=\"flex gap-1 text-[#f1fa8c] text-sm\" data-kid=\"2-8-1-2-1-1\" data-name=\"stars\">\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-8-1-2-1-1-1\">\n                        </i>\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-8-1-2-1-1-2\">\n                        </i>\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-8-1-2-1-1-3\">\n                        </i>\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-8-1-2-1-1-4\">\n                        </i>\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-8-1-2-1-1-5\">\n                        </i>\n                    </div>\n                    <blockquote class=\"mt-4 text-[1.02rem] italic leading-relaxed text-[#dbe4f0]\" data-kid=\"2-8-1-2-1-2\" data-name=\"quote\">\n                        “Dejé de anotar películas en el móvil. Aquí tengo mi historial, mis notas y por fin discusiones decentes.”\n                    </blockquote>\n                    <figcaption class=\"mt-6 flex items-center gap-3\" data-kid=\"2-8-1-2-1-3\" data-name=\"author\">\n                        <img alt=\"Valeria R.\" class=\"h-10 w-10 rounded-full object-cover\" data-kid=\"2-8-1-2-1-3-1\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/80?u=valeria\"/>\n                        <div data-kid=\"2-8-1-2-1-3-2\">\n                            <p class=\"text-sm font-semibold\" data-kid=\"2-8-1-2-1-3-2-1\">\n                                Valeria R.\n                            </p>\n                            <p class=\"mono text-[10px] uppercase tracking-wider text-[#A0B0C0]\" data-kid=\"2-8-1-2-1-3-2-2\">\n                                412 títulos calificados\n                            </p>\n                        </div>\n                    </figcaption>\n                </figure>\n                <figure class=\"w-[330px] shrink-0 snap-start rounded-2xl border border-white/10 bg-[#0A0E16] p-7\" data-kid=\"2-8-1-2-2\" data-name=\"card 2\">\n                    <div class=\"flex gap-1 text-[#f1fa8c] text-sm\" data-kid=\"2-8-1-2-2-1\">\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-8-1-2-2-1-1\">\n                        </i>\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-8-1-2-2-1-2\">\n                        </i>\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-8-1-2-2-1-3\">\n                        </i>\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-8-1-2-2-1-4\">\n                        </i>\n                        <i class=\"ti ti-star-half-filled\" data-kid=\"2-8-1-2-2-1-5\">\n                        </i>\n                    </div>\n                    <blockquote class=\"mt-4 text-[1.02rem] italic leading-relaxed text-[#dbe4f0]\" data-kid=\"2-8-1-2-2-2\">\n                        “La tier list es adictiva. Reordené mi top de 2024 tres veces en una noche.”\n                    </blockquote>\n                    <figcaption class=\"mt-6 flex items-center gap-3\" data-kid=\"2-8-1-2-2-3\">\n                        <img alt=\"Andrés M.\" class=\"h-10 w-10 rounded-full object-cover\" data-kid=\"2-8-1-2-2-3-1\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/80?u=andres\"/>\n                        <div data-kid=\"2-8-1-2-2-3-2\">\n                            <p class=\"text-sm font-semibold\" data-kid=\"2-8-1-2-2-3-2-1\">\n                                Andrés M.\n                            </p>\n                            <p class=\"mono text-[10px] uppercase tracking-wider text-[#A0B0C0]\" data-kid=\"2-8-1-2-2-3-2-2\">\n                                Crítico amateur\n                            </p>\n                        </div>\n                    </figcaption>\n                </figure>\n                <figure class=\"w-[330px] shrink-0 snap-start rounded-2xl border border-white/10 bg-[#0A0E16] p-7\" data-kid=\"2-8-1-2-3\" data-name=\"card 3\">\n                    <div class=\"flex gap-1 text-[#f1fa8c] text-sm\" data-kid=\"2-8-1-2-3-1\">\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-8-1-2-3-1-1\">\n                        </i>\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-8-1-2-3-1-2\">\n                        </i>\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-8-1-2-3-1-3\">\n                        </i>\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-8-1-2-3-1-4\">\n                        </i>\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-8-1-2-3-1-5\">\n                        </i>\n                    </div>\n                    <blockquote class=\"mt-4 text-[1.02rem] italic leading-relaxed text-[#dbe4f0]\" data-kid=\"2-8-1-2-3-2\">\n                        “Me registré para calificar Dune y terminé documentando 200 películas. Cero arrepentimiento.”\n                    </blockquote>\n                    <figcaption class=\"mt-6 flex items-center gap-3\" data-kid=\"2-8-1-2-3-3\">\n                        <img alt=\"Camila T.\" class=\"h-10 w-10 rounded-full object-cover\" data-kid=\"2-8-1-2-3-3-1\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/80?u=camila\"/>\n                        <div data-kid=\"2-8-1-2-3-3-2\">\n                            <p class=\"text-sm font-semibold\" data-kid=\"2-8-1-2-3-3-2-1\">\n                                Camila T.\n                            </p>\n                            <p class=\"mono text-[10px] uppercase tracking-wider text-[#A0B0C0]\" data-kid=\"2-8-1-2-3-3-2-2\">\n                                Miembro desde 2024\n                            </p>\n                        </div>\n                    </figcaption>\n                </figure>\n                <figure class=\"w-[330px] shrink-0 snap-start rounded-2xl border border-white/10 bg-[#0A0E16] p-7\" data-kid=\"2-8-1-2-4\" data-name=\"card 4\">\n                    <div class=\"flex gap-1 text-[#f1fa8c] text-sm\" data-kid=\"2-8-1-2-4-1\">\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-8-1-2-4-1-1\">\n                        </i>\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-8-1-2-4-1-2\">\n                        </i>\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-8-1-2-4-1-3\">\n                        </i>\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-8-1-2-4-1-4\">\n                        </i>\n                        <i class=\"ti ti-star\" data-kid=\"2-8-1-2-4-1-5\">\n                        </i>\n                    </div>\n                    <blockquote class=\"mt-4 text-[1.02rem] italic leading-relaxed text-[#dbe4f0]\" data-kid=\"2-8-1-2-4-2\">\n                        “Los comentarios tienen nivel. Se debate de montaje y guion, no de spoilers tontos.”\n                    </blockquote>\n                    <figcaption class=\"mt-6 flex items-center gap-3\" data-kid=\"2-8-1-2-4-3\">\n                        <img alt=\"Joaquín P.\" class=\"h-10 w-10 rounded-full object-cover\" data-kid=\"2-8-1-2-4-3-1\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/80?u=joaquin\"/>\n                        <div data-kid=\"2-8-1-2-4-3-2\">\n                            <p class=\"text-sm font-semibold\" data-kid=\"2-8-1-2-4-3-2-1\">\n                                Joaquín P.\n                            </p>\n                            <p class=\"mono text-[10px] uppercase tracking-wider text-[#A0B0C0]\" data-kid=\"2-8-1-2-4-3-2-2\">\n                                89 reseñas\n                            </p>\n                        </div>\n                    </figcaption>\n                </figure>\n            </div>\n        </div>\n    </section>\n    <!-- ============ FAQ ============ -->\n    <section class=\"bg-[#05070A] py-20 sm:py-24\" data-kid=\"2-9\" data-name=\"faq section\">\n        <div class=\"mx-auto grid max-w-[1240px] gap-12 px-6 lg:grid-cols-[minmax(0,0.6fr)_minmax(0,1fr)]\" data-kid=\"2-9-1\" data-name=\"grid\">\n            <div class=\"reveal\" data-kid=\"2-9-1-1\" data-name=\"header\">\n                <p class=\"mono text-[11px] uppercase tracking-[0.24em] text-[#B000FF]\" data-kid=\"2-9-1-1-1\" data-name=\"label\">\n                    Preguntas frecuentes\n                </p>\n                <h2 class=\"mt-4 text-[clamp(1.8rem,3.2vw,2.8rem)] font-extrabold leading-tight\" data-kid=\"2-9-1-1-2\" data-name=\"headline\">\n                    Todo lo que quieres saber antes de registrarte.\n                </h2>\n                <p class=\"mt-4 text-[#A0B0C0]\" data-kid=\"2-9-1-1-3\" data-name=\"description\">\n                    ¿Te falta algo? Escríbenos abajo y respondemos en menos de 24 h.\n                </p>\n            </div>\n            <div class=\"reveal divide-y divide-white/10 border-y border-white/10\" data-kid=\"2-9-1-2\" data-name=\"faq list\">\n                <details class=\"cc-faq group py-5\" data-kid=\"2-9-1-2-1\" data-name=\"faq item 1\" open=\"\">\n                    <summary class=\"flex items-center gap-4 text-lg font-semibold\" data-kid=\"2-9-1-2-1-1\" data-name=\"trigger\">\n                        <span class=\"flex-1\" data-kid=\"2-9-1-2-1-1-1\" data-name=\"question\">\n                            ¿Es gratis?\n                        </span>\n                        <span class=\"cc-faq-plus mono text-2xl text-[#00E5FF]\" data-kid=\"2-9-1-2-1-1-2\" data-name=\"plus icon\">\n                            +\n                        </span>\n                    </summary>\n                    <p class=\"cc-faq-body mt-3 max-w-[620px] text-[#A0B0C0]\" data-kid=\"2-9-1-2-1-2\" data-name=\"answer\">\n                        Sí. Crear tu cuenta, calificar, comentar y armar tier lists es gratis para siempre. Habrá funciones Pro opcionales más adelante.\n                    </p>\n                </details>\n                <details class=\"cc-faq group py-5\" data-kid=\"2-9-1-2-2\" data-name=\"faq item 2\">\n                    <summary class=\"flex items-center gap-4 text-lg font-semibold\" data-kid=\"2-9-1-2-2-1\">\n                        <span class=\"flex-1\" data-kid=\"2-9-1-2-2-1-1\">\n                            ¿Puedo importar mi lista?\n                        </span>\n                        <span class=\"cc-faq-plus mono text-2xl text-[#00E5FF]\" data-kid=\"2-9-1-2-2-1-2\">\n                            +\n                        </span>\n                    </summary>\n                    <p class=\"cc-faq-body mt-3 max-w-[620px] text-[#A0B0C0]\" data-kid=\"2-9-1-2-2-2\">\n                        Puedes importar desde CSV y desde los exportables más comunes. Tus notas y fechas de visto se conservan.\n                    </p>\n                </details>\n                <details class=\"cc-faq group py-5\" data-kid=\"2-9-1-2-3\" data-name=\"faq item 3\">\n                    <summary class=\"flex items-center gap-4 text-lg font-semibold\" data-kid=\"2-9-1-2-3-1\">\n                        <span class=\"flex-1\" data-kid=\"2-9-1-2-3-1-1\">\n                            ¿Cómo funciona la Tier List?\n                        </span>\n                        <span class=\"cc-faq-plus mono text-2xl text-[#00E5FF]\" data-kid=\"2-9-1-2-3-1-2\">\n                            +\n                        </span>\n                    </summary>\n                    <p class=\"cc-faq-body mt-3 max-w-[620px] text-[#A0B0C0]\" data-kid=\"2-9-1-2-3-2\">\n                        Arrastras cada póster entre los niveles S, A, B, C y D. La tabla se guarda automáticamente y puedes compartirla con un enlace público.\n                    </p>\n                </details>\n                <details class=\"cc-faq group py-5\" data-kid=\"2-9-1-2-4\" data-name=\"faq item 4\">\n                    <summary class=\"flex items-center gap-4 text-lg font-semibold\" data-kid=\"2-9-1-2-4-1\">\n                        <span class=\"flex-1\" data-kid=\"2-9-1-2-4-1-1\">\n                            ¿Hay app móvil?\n                        </span>\n                        <span class=\"cc-faq-plus mono text-2xl text-[#00E5FF]\" data-kid=\"2-9-1-2-4-1-2\">\n                            +\n                        </span>\n                    </summary>\n                    <p class=\"cc-faq-body mt-3 max-w-[620px] text-[#A0B0C0]\" data-kid=\"2-9-1-2-4-2\">\n                        La web es totalmente responsive e instalable como PWA. Las apps nativas están en el roadmap.\n                    </p>\n                </details>\n                <details class=\"cc-faq group py-5\" data-kid=\"2-9-1-2-5\" data-name=\"faq item 5\">\n                    <summary class=\"flex items-center gap-4 text-lg font-semibold\" data-kid=\"2-9-1-2-5-1\">\n                        <span class=\"flex-1\" data-kid=\"2-9-1-2-5-1-1\">\n                            ¿Puedo comentar?\n                        </span>\n                        <span class=\"cc-faq-plus mono text-2xl text-[#00E5FF]\" data-kid=\"2-9-1-2-5-1-2\">\n                            +\n                        </span>\n                    </summary>\n                    <p class=\"cc-faq-body mt-3 max-w-[620px] text-[#A0B0C0]\" data-kid=\"2-9-1-2-5-2\">\n                        Sí: reseñas largas, respuestas en hilo y avisos de spoiler. Moderación comunitaria para que la conversación no se degrade.\n                    </p>\n                </details>\n            </div>\n        </div>\n    </section>\n    <!-- ============ FINAL CTA ============ -->\n    <section class=\"relative overflow-hidden py-24\" data-kid=\"2-10\" data-name=\"final cta section\">\n        <div class=\"absolute left-1/2 top-1/2 h-[560px] w-[900px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(circle,rgba(0,229,255,.28),rgba(176,0,255,.18)_45%,transparent_70%)] blur-[60px]\" data-kid=\"2-10-1\" data-name=\"radial gradient blur\">\n        </div>\n        <div class=\"cc-grid-bg absolute inset-0 opacity-40\" data-kid=\"2-10-2\" data-name=\"background grid\">\n        </div>\n        <div class=\"reveal relative mx-auto max-w-[820px] px-6 text-center\" data-kid=\"2-10-3\" data-name=\"content\">\n            <p class=\"mono text-[11px] uppercase tracking-[0.26em] text-[#00E5FF]\" data-kid=\"2-10-3-1\" data-name=\"label\">\n                Último acto\n            </p>\n            <h2 class=\"mt-5 text-[clamp(2.1rem,4.4vw,3.8rem)] font-extrabold leading-[1.05]\" data-kid=\"2-10-3-2\" data-name=\"headline\">\n                ¿Listo para empezar tu colección?\n            </h2>\n            <p class=\"mx-auto mt-5 max-w-[540px] text-[#A0B0C0]\" data-kid=\"2-10-3-3\" data-name=\"description\">\n                Regístrate, califica el primer título del momento y tu perfil cinéfilo empieza a construirse solo.\n            </p>\n            <div class=\"mt-9 flex flex-wrap items-center justify-center gap-4\" data-kid=\"2-10-3-4\" data-name=\"button container\">\n                <button class=\"cc-pulse mono rounded-md bg-[#00E5FF] px-8 py-4 text-sm font-bold uppercase tracking-wider text-[#05070A]\" data-kid=\"2-10-3-4-1\" data-name=\"signup button\">\n                    Crear cuenta gratis\n                </button>\n                <button class=\"mono rounded-md border border-white/20 px-7 py-4 text-sm font-semibold uppercase tracking-wider hover:border-white/45\" data-kid=\"2-10-3-4-2\" data-name=\"signin button\">\n                    Ya tengo cuenta\n                </button>\n            </div>\n            <p class=\"mono mt-6 text-[11px] uppercase tracking-[0.18em] text-[#A0B0C0]\" data-kid=\"2-10-3-5\" data-name=\"footer help text\">\n                sin tarjeta · sin anuncios · 20 segundos\n            </p>\n        </div>\n    </section>\n    <!-- ============ CONTACTO ============ -->\n    <section class=\"bg-[#070A12] py-20\" data-kid=\"2-11\" data-name=\"contact section\" id=\"contacto\">\n        <div class=\"mx-auto grid max-w-[1240px] items-start gap-12 px-6 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1fr)]\" data-kid=\"2-11-1\" data-name=\"grid\">\n            <div class=\"reveal\" data-kid=\"2-11-1-1\" data-name=\"info column\">\n                <p class=\"mono text-[11px] uppercase tracking-[0.24em] text-[#FF007F]\" data-kid=\"2-11-1-1-1\" data-name=\"label\">\n                    Contacto\n                </p>\n                <h2 class=\"mt-4 text-[clamp(1.8rem,3.2vw,2.6rem)] font-extrabold leading-tight\" data-kid=\"2-11-1-1-2\" data-name=\"headline\">\n                    Contáctanos\n                </h2>\n                <p class=\"mt-4 max-w-[420px] text-[#A0B0C0]\" data-kid=\"2-11-1-1-3\" data-name=\"description\">\n                    Sugerencias, títulos que faltan, bugs o alianzas. Todo llega al equipo directamente.\n                </p>\n                <div class=\"mono mt-8 space-y-3 text-sm text-[#A0B0C0]\" data-kid=\"2-11-1-1-4\" data-name=\"contact details\">\n                    <p class=\"flex items-center gap-3\" data-kid=\"2-11-1-1-4-1\" data-name=\"email row\">\n                        <i class=\"ti ti-mail text-lg text-[#00E5FF]\" data-kid=\"2-11-1-1-4-1-1\">\n                        </i>\n                        hola@cineclassify.pro\n                    </p>\n                    <p class=\"flex items-center gap-3\" data-kid=\"2-11-1-1-4-2\" data-name=\"discord row\">\n                        <i class=\"ti ti-brand-discord text-lg text-[#00E5FF]\" data-kid=\"2-11-1-1-4-2-1\">\n                        </i>\n                        discord.gg/cineclassify\n                    </p>\n                    <p class=\"flex items-center gap-3\" data-kid=\"2-11-1-1-4-3\" data-name=\"time row\">\n                        <i class=\"ti ti-clock text-lg text-[#00E5FF]\" data-kid=\"2-11-1-1-4-3-1\">\n                        </i>\n                        respuesta en < 24 h\n                    </p>\n                </div>\n            </div>\n            <form class=\"reveal rounded-[24px] border border-white/12 bg-white/[0.04] p-7 backdrop-blur-xl sm:p-9\" data-kid=\"2-11-1-2\" data-name=\"contact form\">\n                <div class=\"grid gap-5 sm:grid-cols-2\" data-kid=\"2-11-1-2-1\" data-name=\"fields row\">\n                    <div class=\"flex flex-col gap-2\" data-kid=\"2-11-1-2-1-1\" data-name=\"name field\">\n                        <label class=\"mono text-[11px] font-semibold uppercase tracking-wider text-[#A0B0C0]\" data-kid=\"2-11-1-2-1-1-1\" data-name=\"label\">\n                            Nombre\n                        </label>\n                        <input class=\"w-full rounded-md border border-white/12 bg-black/40 px-4 py-3 text-sm text-white outline-hidden placeholder:text-white/30 focus:border-[#00E5FF]/60\" data-kid=\"2-11-1-2-1-1-2\" data-name=\"input\" placeholder=\"Ej. John Doe\" required=\"\" type=\"text\"/>\n                    </div>\n                    <div class=\"flex flex-col gap-2\" data-kid=\"2-11-1-2-1-2\" data-name=\"email field\">\n                        <label class=\"mono text-[11px] font-semibold uppercase tracking-wider text-[#A0B0C0]\" data-kid=\"2-11-1-2-1-2-1\" data-name=\"label\">\n                            Email\n                        </label>\n                        <input class=\"w-full rounded-md border border-white/12 bg-black/40 px-4 py-3 text-sm text-white outline-hidden placeholder:text-white/30 focus:border-[#00E5FF]/60\" data-kid=\"2-11-1-2-1-2-2\" data-name=\"input\" placeholder=\"tu@email.com\" required=\"\" type=\"email\"/>\n                    </div>\n                </div>\n                <div class=\"mt-5 flex flex-col gap-2\" data-kid=\"2-11-1-2-2\" data-name=\"message field\">\n                    <label class=\"mono text-[11px] font-semibold uppercase tracking-wider text-[#A0B0C0]\" data-kid=\"2-11-1-2-2-1\" data-name=\"label\">\n                        Mensaje\n                    </label>\n                    <textarea class=\"w-full resize-y rounded-md border border-white/12 bg-black/40 px-4 py-3 text-sm text-white outline-hidden placeholder:text-white/30 focus:border-[#00E5FF]/60\" data-kid=\"2-11-1-2-2-2\" data-name=\"textarea\" placeholder=\"¿En qué podemos ayudarte?\" required=\"\" rows=\"5\"></textarea>\n                </div>\n                <button class=\"mono mt-7 w-full rounded-md bg-[#00E5FF] px-6 py-3.5 text-[13px] font-bold uppercase tracking-wider text-[#05070A] hover:bg-white sm:w-auto\" data-kid=\"2-11-1-2-3\" data-name=\"submit button\" type=\"submit\">\n                    Enviar Mensaje\n                </button>\n            </form>\n        </div>\n    </section>\n    <!-- ============ FOOTER ============ -->\n    <footer class=\"relative overflow-hidden border-t border-white/10 bg-[#05070A] pt-16\" data-kid=\"2-12\" data-name=\"footer bar\">\n        <div class=\"mx-auto max-w-[1240px] px-6\" data-kid=\"2-12-1\" data-name=\"container\">\n            <div class=\"grid gap-10 pb-14 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]\" data-kid=\"2-12-1-1\" data-name=\"navigation grid\">\n                <div data-kid=\"2-12-1-1-1\" data-name=\"brand column\">\n                    <p class=\"text-2xl font-extrabold\" data-kid=\"2-12-1-1-1-1\" data-name=\"brand name\">\n                        Cine\n                        <span class=\"text-[#00E5FF]\" data-kid=\"2-12-1-1-1-1-1\" data-name=\"brand highlight\">\n                            Classify\n                        </span>\n                    </p>\n                    <p class=\"mt-4 max-w-[300px] text-sm text-[#A0B0C0]\" data-kid=\"2-12-1-1-1-2\" data-name=\"brand description\">\n                        Clasifica, valora, guarda y comenta películas y series. Hecho para quienes ven cine en serio.\n                    </p>\n                    <div class=\"mt-6 flex gap-3\" data-kid=\"2-12-1-1-1-3\" data-name=\"social icons\">\n                        <a aria-label=\"GitHub\" class=\"flex h-10 w-10 items-center justify-center rounded-lg border border-white/12 bg-white/5 text-lg text-[#A0B0C0] hover:border-[#00E5FF]/60 hover:text-[#00E5FF]\" data-kid=\"2-12-1-1-1-3-1\" href=\"#\">\n                            <i class=\"ti ti-brand-github\" data-kid=\"2-12-1-1-1-3-1-1\">\n                            </i>\n                        </a>\n                        <a aria-label=\"Twitter\" class=\"flex h-10 w-10 items-center justify-center rounded-lg border border-white/12 bg-white/5 text-lg text-[#A0B0C0] hover:border-[#00E5FF]/60 hover:text-[#00E5FF]\" data-kid=\"2-12-1-1-1-3-2\" href=\"#\">\n                            <i class=\"ti ti-brand-x\" data-kid=\"2-12-1-1-1-3-2-1\">\n                            </i>\n                        </a>\n                        <a aria-label=\"LinkedIn\" class=\"flex h-10 w-10 items-center justify-center rounded-lg border border-white/12 bg-white/5 text-lg text-[#A0B0C0] hover:border-[#00E5FF]/60 hover:text-[#00E5FF]\" data-kid=\"2-12-1-1-1-3-3\" href=\"#\">\n                            <i class=\"ti ti-brand-linkedin\" data-kid=\"2-12-1-1-1-3-3-1\">\n                            </i>\n                        </a>\n                        <a aria-label=\"Discord\" class=\"flex h-10 w-10 items-center justify-center rounded-lg border border-white/12 bg-white/5 text-lg text-[#A0B0C0] hover:border-[#00E5FF]/60 hover:text-[#00E5FF]\" data-kid=\"2-12-1-1-1-3-4\" href=\"#\">\n                            <i class=\"ti ti-brand-discord\" data-kid=\"2-12-1-1-1-3-4-1\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n                <div data-kid=\"2-12-1-1-2\" data-name=\"product link column\">\n                    <p class=\"mono text-[11px] font-bold uppercase tracking-[0.2em] text-white\" data-kid=\"2-12-1-1-2-1\">\n                        Producto\n                    </p>\n                    <ul class=\"mt-5 space-y-3 text-sm text-[#A0B0C0]\" data-kid=\"2-12-1-1-2-2\">\n                        <li data-kid=\"2-12-1-1-2-2-1\">\n                            <a class=\"hover:text-[#00E5FF]\" data-kid=\"2-12-1-1-2-2-1-1\" href=\"#catalogo\">\n                                Catálogo\n                            </a>\n                        </li>\n                        <li data-kid=\"2-12-1-1-2-2-2\">\n                            <a class=\"hover:text-[#00E5FF]\" data-kid=\"2-12-1-1-2-2-2-1\" href=\"#ranking\">\n                                Ranking global\n                            </a>\n                        </li>\n                        <li data-kid=\"2-12-1-1-2-2-3\">\n                            <a class=\"hover:text-[#00E5FF]\" data-kid=\"2-12-1-1-2-2-3-1\" href=\"#\">\n                                Tier Lists\n                            </a>\n                        </li>\n                        <li data-kid=\"2-12-1-1-2-2-4\">\n                            <a class=\"hover:text-[#00E5FF]\" data-kid=\"2-12-1-1-2-2-4-1\" href=\"#\">\n                                Estadísticas\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"2-12-1-1-3\" data-name=\"community link column\">\n                    <p class=\"mono text-[11px] font-bold uppercase tracking-[0.2em] text-white\" data-kid=\"2-12-1-1-3-1\">\n                        Comunidad\n                    </p>\n                    <ul class=\"mt-5 space-y-3 text-sm text-[#A0B0C0]\" data-kid=\"2-12-1-1-3-2\">\n                        <li data-kid=\"2-12-1-1-3-2-1\">\n                            <a class=\"hover:text-[#00E5FF]\" data-kid=\"2-12-1-1-3-2-1-1\" href=\"#\">\n                                Reseñas destacadas\n                            </a>\n                        </li>\n                        <li data-kid=\"2-12-1-1-3-2-2\">\n                            <a class=\"hover:text-[#00E5FF]\" data-kid=\"2-12-1-1-3-2-2-1\" href=\"#\">\n                                Discord\n                            </a>\n                        </li>\n                        <li data-kid=\"2-12-1-1-3-2-3\">\n                            <a class=\"hover:text-[#00E5FF]\" data-kid=\"2-12-1-1-3-2-3-1\" href=\"#\">\n                                Moderación\n                            </a>\n                        </li>\n                        <li data-kid=\"2-12-1-1-3-2-4\">\n                            <a class=\"hover:text-[#00E5FF]\" data-kid=\"2-12-1-1-3-2-4-1\" href=\"#contacto\">\n                                Contacto\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"2-12-1-1-4\" data-name=\"legal link column\">\n                    <p class=\"mono text-[11px] font-bold uppercase tracking-[0.2em] text-white\" data-kid=\"2-12-1-1-4-1\">\n                        Legal\n                    </p>\n                    <ul class=\"mt-5 space-y-3 text-sm text-[#A0B0C0]\" data-kid=\"2-12-1-1-4-2\">\n                        <li data-kid=\"2-12-1-1-4-2-1\">\n                            <a class=\"hover:text-[#00E5FF]\" data-kid=\"2-12-1-1-4-2-1-1\" href=\"#\">\n                                Términos\n                            </a>\n                        </li>\n                        <li data-kid=\"2-12-1-1-4-2-2\">\n                            <a class=\"hover:text-[#00E5FF]\" data-kid=\"2-12-1-1-4-2-2-1\" href=\"#\">\n                                Privacidad\n                            </a>\n                        </li>\n                        <li data-kid=\"2-12-1-1-4-2-3\">\n                            <a class=\"hover:text-[#00E5FF]\" data-kid=\"2-12-1-1-4-2-3-1\" href=\"#\">\n                                Cookies\n                            </a>\n                        </li>\n                        <li data-kid=\"2-12-1-1-4-2-4\">\n                            <a class=\"hover:text-[#00E5FF]\" data-kid=\"2-12-1-1-4-2-4-1\" href=\"#\">\n                                Licencias\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"mono flex flex-wrap items-center justify-between gap-4 border-t border-white/10 py-7 text-[11px] uppercase tracking-[0.16em] text-[#A0B0C0]\" data-kid=\"2-12-1-2\" data-name=\"copyright row\">\n                <p data-kid=\"2-12-1-2-1\">\n                    © 2026 CineClassify Pro\n                </p>\n                <p data-kid=\"2-12-1-2-2\">\n                    Desarrollado por\n                    <span class=\"text-[#00E5FF]\" data-kid=\"2-12-1-2-2-1\">\n                        [calomixx]\n                    </span>\n                </p>\n            </div>\n        </div>\n        <p class=\"pointer-events-none select-none whitespace-nowrap text-center text-[clamp(3rem,13vw,11rem)] font-extrabold leading-[0.8] text-white/[0.035]\" data-kid=\"2-12-2\" data-name=\"large background brand text\">\n            CINECLASSIFY\n        </p>\n    </footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n\n  gsap.utils.toArray('.reveal').forEach((el) => {\n    gsap.fromTo(el, { y: 44, autoAlpha: 0 }, {\n      y: 0, autoAlpha: 1, duration: 0.85, ease: 'power2.out',\n      scrollTrigger: { trigger: el, start: 'top 90%' }\n    });\n  });\n\n  gsap.to('.parallax-a', {\n    y: -46, ease: 'none',\n    scrollTrigger: { trigger: '#catalogo', start: 'top bottom', end: 'bottom top', scrub: true }\n  });\n  gsap.to('.parallax-b', {\n    y: 34, ease: 'none',\n    scrollTrigger: { trigger: '#catalogo', start: 'top bottom', end: 'bottom top', scrub: true }\n  });\n</script>\n",
