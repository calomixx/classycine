=\"h-40 w-28 rounded-lg border border-white/10 object-cover opacity-70\" data-kid=\"2-4-3-3-2-4\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/26178754/pexels-photo-26178754.jpeg?auto=compress&cs=tinysrgb&w=300&q=80\"/>\n                    <img alt=\"\" class=\"h-40 w-28 rounded-lg border border-white/10 object-cover opacity-70\" data-kid=\"2-4-3-3-2-5\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/8717531/pexels-photo-8717531.jpeg?auto=compress&cs=tinysrgb&w=300&q=80\"/>\n                    <img alt=\"\" class=\"h-40 w-28 rounded-lg border border-white/10 object-cover opacity-70\" data-kid=\"2-4-3-3-2-6\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/33835255/pexels-photo-33835255.jpeg?auto=compress&cs=tinysrgb&w=300&q=80\"/>\n                    <img alt=\"\" class=\"h-40 w-28 rounded-lg border border-white/10 object-cover opacity-70\" data-kid=\"2-4-3-3-2-7\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7671968/pexels-photo-7671968.jpeg?auto=compress&cs=tinysrgb&w=300&q=80\"/>\n                    <img alt=\"\" class=\"h-40 w-28 rounded-lg border border-white/10 object-cover opacity-70\" data-kid=\"2-4-3-3-2-8\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/15790206/pexels-photo-15790206.jpeg?auto=compress&cs=tinysrgb&w=300&q=80\"/>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ============ CÓMO FUNCIONA ============ -->\n    <section class=\"relative bg-[#070A12] py-20 sm:py-28\" data-kid=\"2-5\" data-name=\"how it works section\">\n        <div class=\"mx-auto max-w-[1240px] px-6\" data-kid=\"2-5-1\" data-name=\"container\">\n            <div class=\"reveal max-w-[640px]\" data-kid=\"2-5-1-1\" data-name=\"header\">\n                <p class=\"mono text-[11px] uppercase tracking-[0.24em] text-[#B000FF]\" data-kid=\"2-5-1-1-1\" data-name=\"label\">\n                    Cómo funciona\n                </p>\n                <h2 class=\"mt-4 text-[clamp(1.9rem,3.4vw,3rem)] font-extrabold leading-tight\" data-kid=\"2-5-1-1-2\" data-name=\"main headline\">\n                    Tres movimientos y tu cinefilia queda documentada.\n                </h2>\n            </div>\n            <div class=\"mt-14 grid gap-6 lg:grid-cols-3\" data-kid=\"2-5-1-2\" data-name=\"features grid\">\n                <!-- card 1 -->\n                <div class=\"reveal cc-gborder rounded-[24px] p-px lg:mt-0\" data-kid=\"2-5-1-2-1\" data-name=\"step 1 card wrapper\">\n                    <div class=\"flex h-full flex-col rounded-[23px] bg-[#0A0E16] p-8 lg:min-h-[380px]\" data-kid=\"2-5-1-2-1-1\" data-name=\"step 1 card\">\n                        <div class=\"mono flex items-start justify-between\" data-kid=\"2-5-1-2-1-1-1\" data-name=\"card header\">\n                            <span class=\"text-[64px] font-bold leading-none text-white/8\" data-kid=\"2-5-1-2-1-1-1-1\" data-name=\"step number\">\n                                01\n                            </span>\n                            <span class=\"flex h-12 w-12 items-center justify-center rounded-xl bg-[#00E5FF]/12 text-2xl text-[#00E5FF]\" data-kid=\"2-5-1-2-1-1-1-2\" data-name=\"icon wrapper\">\n                                <i class=\"ti ti-star\" data-kid=\"2-5-1-2-1-1-1-2-1\" data-name=\"star icon\">\n                                </i>\n                            </span>\n                        </div>\n                        <h3 class=\"mt-8 text-2xl font-bold\" data-kid=\"2-5-1-2-1-1-2\" data-name=\"title\">\n                            Califica\n                        </h3>\n                        <p class=\"mt-3 text-[#A0B0C0]\" data-kid=\"2-5-1-2-1-1-3\" data-name=\"description\">\n                            Puntúa de 1 a 5 estrellas, deja tu reseña y mira cómo tu voto mueve el ranking global en tiempo real.\n                        </p>\n                        <div class=\"mono mt-auto pt-8 text-[11px] uppercase tracking-[0.18em] text-[#00E5FF]\" data-kid=\"2-5-1-2-1-1-4\" data-name=\"link\">\n                            340.000 calificaciones →\n                        </div>\n                    </div>\n                </div>\n                <!-- card 2 -->\n                <div class=\"reveal cc-gborder rounded-[24px] p-px lg:mt-12\" data-kid=\"2-5-1-2-2\" data-name=\"step 2 card wrapper\">\n                    <div class=\"flex h-full flex-col rounded-[23px] bg-[#0A0E16] p-8 lg:min-h-[380px]\" data-kid=\"2-5-1-2-2-1\" data-name=\"step 2 card\">\n                        <div class=\"mono flex items-start justify-between\" data-kid=\"2-5-1-2-2-1-1\" data-name=\"step 2 header\">\n                            <span class=\"text-[64px] font-bold leading-none text-white/8\" data-kid=\"2-5-1-2-2-1-1-1\" data-name=\"step 2 number\">\n                                02\n                            </span>\n                            <span class=\"flex h-12 w-12 items-center justify-center rounded-xl bg-[#B000FF]/15 text-2xl text-[#B000FF]\" data-kid=\"2-5-1-2-2-1-1-2\" data-name=\"step 2 icon wrapper\">\n                                <i class=\"ti ti-list-details\" data-kid=\"2-5-1-2-2-1-1-2-1\" data-name=\"list icon\">\n                                </i>\n                            </span>\n                        </div>\n                        <h3 class=\"mt-8 text-2xl font-bold\" data-kid=\"2-5-1-2-2-1-2\" data-name=\"step 2 title\">\n                            Organiza\n                        </h3>\n                        <p class=\"mt-3 text-[#A0B0C0]\" data-kid=\"2-5-1-2-2-1-3\" data-name=\"step 2 description\">\n                            Watchlist, vistas, pendientes y tier lists arrastrables. Todo tu historial cinéfilo en un solo panel.\n                        </p>\n                        <div class=\"mono mt-auto pt-8 text-[11px] uppercase tracking-[0.18em] text-[#B000FF]\" data-kid=\"2-5-1-2-2-1-4\" data-name=\"step 2 link\">\n                            89.000 títulos →\n                        </div>\n                    </div>\n                </div>\n                <!-- card 3 -->\n                <div class=\"reveal cc-gborder rounded-[24px] p-px lg:mt-4\" data-kid=\"2-5-1-2-3\" data-name=\"step 3 card wrapper\">\n                    <div class=\"flex h-full flex-col rounded-[23px] bg-[#0A0E16] p-8 lg:min-h-[380px]\" data-kid=\"2-5-1-2-3-1\" data-name=\"step 3 card\">\n                        <div class=\"mono flex items-start justify-between\" data-kid=\"2-5-1-2-3-1-1\" data-name=\"step 3 header\">\n                            <span class=\"text-[64px] font-bold leading-none text-white/8\" data-kid=\"2-5-1-2-3-1-1-1\" data-name=\"step 3 number\">\n                                03\n                            </span>\n                            <span class=\"flex h-12 w-12 items-center justify-center rounded-xl bg-[#FF007F]/15 text-2xl text-[#FF007F]\" data-kid=\"2-5-1-2-3-1-1-2\" data-name=\"step 3 icon wrapper\">\n                                <i class=\"ti ti-message-2\" data-kid=\"2-5-1-2-3-1-1-2-1\" data-name=\"message icon\">\n                                </i>\n                            </span>\n                        </div>\n                        <h3 class=\"mt-8 text-2xl font-bold\" data-kid=\"2-5-1-2-3-1-2\" data-name=\"step 3 title\">\n                            Debate\n                        </h3>\n                        <p class=\"mt-3 text-[#A0B0C0]\" data-kid=\"2-5-1-2-3-1-3\" data-name=\"step 3 description\">\n                            Comenta, responde y defiende tus notas frente a una comunidad que discute cine en serio.\n                        </p>\n                        <div class=\"mono mt-auto pt-8 text-[11px] uppercase tracking-[0.18em] text-[#FF007F]\" data-kid=\"2-5-1-2-3-1-4\" data-name=\"step 3 link\">\n                            12.400 cinéfilos →\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ============ TIER LIST ============ -->\n    <section class=\"relative overflow-hidden bg-[#05070A] py-20 sm:py-28\" data-kid=\"2-6\" data-name=\"tier list section\" id=\"ranking\">\n        <div class=\"absolute right-0 top-1/4 h-[400px] w-[400px] rounded-full bg-[#00E5FF]/10 blur-[140px]\" data-kid=\"2-6-1\" data-name=\"blur\">\n        </div>\n        <div class=\"relative mx-auto grid max-w-[1240px] items-center gap-14 px-6 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]\" data-kid=\"2-6-2\" data-name=\"grid\">\n            <div class=\"reveal\" data-kid=\"2-6-2-1\" data-name=\"content\">\n                <p class=\"mono text-[11px] uppercase tracking-[0.24em] text-[#ff79c6]\" data-kid=\"2-6-2-1-1\" data-name=\"label\">\n                    Tier List arrastrable\n                </p>\n                <h2 class=\"mt-4 text-[clamp(1.9rem,3.4vw,3rem)] font-extrabold leading-tight\" data-kid=\"2-6-2-1-2\" data-name=\"headline\">\n                    Ordena tu canon.\n                    <br data-kid=\"2-6-2-1-2-1\" data-name=\"line break\"/>\n                    Arrastra, discute, defiende.\n                </h2>\n                <p class=\"mt-5 text-[#A0B0C0]\" data-kid=\"2-6-2-1-3\" data-name=\"description\">\n                    Coloca cada título en su nivel — de obra maestra a decepción absoluta. Comparte tu tabla y deja que la comunidad la destroce.\n                </p>\n                <ul class=\"mono mt-8 space-y-3 text-sm text-[#A0B0C0]\" data-kid=\"2-6-2-1-4\" data-name=\"feature list\">\n                    <li class=\"flex items-center gap-3\" data-kid=\"2-6-2-1-4-1\" data-name=\"feature 1\">\n                        <i class=\"ti ti-drag-drop text-[#00E5FF] text-lg\" data-kid=\"2-6-2-1-4-1-1\" data-name=\"drag icon\">\n                        </i>\n                        Drag & drop entre niveles\n                    </li>\n                    <li class=\"flex items-center gap-3\" data-kid=\"2-6-2-1-4-2\" data-name=\"feature 2\">\n                        <i class=\"ti ti-share-2 text-[#00E5FF] text-lg\" data-kid=\"2-6-2-1-4-2-1\" data-name=\"share icon\">\n                        </i>\n                        Comparte tu tabla con un enlace\n                    </li>\n                    <li class=\"flex items-center gap-3\" data-kid=\"2-6-2-1-4-3\" data-name=\"feature 3\">\n                        <i class=\"ti ti-chart-bar text-[#00E5FF] text-lg\" data-kid=\"2-6-2-1-4-3-1\" data-name=\"chart icon\">\n                        </i>\n                        Compárala con el promedio global\n                    </li>\n                </ul>\n                <button class=\"mono mt-9 rounded-md border border-[#ff79c6]/45 bg-[#ff79c6]/10 px-6 py-3 text-[12px] font-bold uppercase tracking-wider text-[#ff79c6] hover:bg-[#ff79c6] hover:text-[#05070A]\" data-kid=\"2-6-2-1-5\" data-name=\"cta button\">\n                    Crear mi Tier List\n                </button>\n            </div>\n            <div class=\"reveal rounded-[26px] border border-white/10 bg-[#0A0E16]/80 p-5 backdrop-blur-xl shadow-[0_40px_100px_-40px_rgba(0,0,0,.95)] sm:p-7\" data-kid=\"2-6-2-2\" data-name=\"interactive list preview\">\n                <div class=\"mono mb-5 flex items-center justify-between border-b border-white/10 pb-4 text-[10px] uppercase tracking-[0.2em] text-[#A0B0C0]\" data-kid=\"2-6-2-2-1\" data-name=\"list info header\">\n                    <span data-kid=\"2-6-2-2-1-1\" data-name=\"author handle\">\n                        tabla de @calomixx\n                    </span>\n                    <span class=\"text-[#00E5FF]\" data-kid=\"2-6-2-2-1-2\" data-name=\"interaction guide\">\n                        cursor: grab\n                    </span>\n                </div>\n                <div class=\"space-y-3\" data-kid=\"2-6-2-2-2\" data-name=\"tier rows\">\n                    <div class=\"flex cursor-grab items-center gap-3\" data-kid=\"2-6-2-2-2-1\" data-name=\"tier S row\">\n                        <span class=\"mono flex h-16 w-14 shrink-0 items-center justify-center rounded-lg bg-[#ff79c6] text-xl font-extrabold text-[#05070A]\" data-kid=\"2-6-2-2-2-1-1\" data-name=\"tier label\">\n                            S\n                        </span>\n                        <div class=\"flex flex-1 gap-2 overflow-hidden rounded-lg bg-white/[0.03] p-2\" data-kid=\"2-6-2-2-2-1-2\" data-name=\"tier items\">\n                            <img alt=\"Dune: Parte Dos — Mikhail Nilov on Pexels\" class=\"cc-tier-chip h-12 w-9 rounded object-cover\" data-kid=\"2-6-2-2-2-1-2-1\" data-name=\"poster\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7661481/pexels-photo-7661481.jpeg?auto=compress&cs=tinysrgb&w=120&q=70\"/>\n                            <img alt=\"Arcane — nagato yuki on Unsplash\" class=\"cc-tier-chip h-12 w-9 rounded object-cover\" data-kid=\"2-6-2-2-2-1-2-2\" data-name=\"poster\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1705510144116-cc4d88838b14?auto=format&w=120&q=70&fit=crop\"/>\n                            <img alt=\"Deadpool — Pedro H. Novais on Pexels\" class=\"cc-tier-chip h-12 w-9 rounded object-cover\" data-kid=\"2-6-2-2-2-1-2-3\" data-name=\"poster\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/38691326/pexels-photo-38691326.jpeg?auto=compress&cs=tinysrgb&w=120&q=70\"/>\n                        </div>\n                    </div>\n                    <div class=\"flex cursor-grab items-center gap-3\" data-kid=\"2-6-2-2-2-2\" data-name=\"tier A row\">\n                        <span class=\"mono flex h-16 w-14 shrink-0 items-center justify-center rounded-lg bg-[#ffb86c] text-xl font-extrabold text-[#05070A]\" data-kid=\"2-6-2-2-2-2-1\" data-name=\"tier label\">\n                            A\n                        </span>\n                        <div class=\"flex flex-1 gap-2 overflow-hidden rounded-lg bg-white/[0.03] p-2\"